-- Bow speed is not a constant: the game builds it from a base plus the draw
-- charge, exactly like BOW_BALANCE does. Entries are
-- {name, speedBase, speedCharge, gravity}. The Hunting Bow tops out at 95+125,
-- the Compound Bow at 120+170, and the Crossbow is always loaded so its 320
-- studs/s never scales. Gravity is 50, 40 and 28 studs/s^2, not the engine's
-- 196.2, which is why the old arc fudge factor was so far off. The aim point
-- always assumes a full draw: scaling by the live charge made a half-drawn
-- arrow's drop balloon and yanked the view up right after the shot.
-- Lives on PF so it costs no extra main-local.
PF.bows={
  {"crossbow",320,0,28},
  {"compound",120,170,40},
  {"hunting",95,125,50},
  {"bow",95,125,50},
}

-- Bone lists per menu entry, resolved once instead of rebuilt per player per
