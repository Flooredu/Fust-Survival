-- one loader for every style. cache is {primary,alt}; the alt handle is only
-- requested after the primary reports a decode failure.
local function tex_get(cache,url,alt)
  if not (draw.LoadImage and draw.Image and draw.ImageLoaded) then return nil end
  if not cache[1] then pcall(function() cache[1]=draw.LoadImage(url) end) end
  local ok=false
  if cache[1] then pcall(function() ok=draw.ImageLoaded(cache[1]) end) end
  if ok then return cache[1] end
  local bad=false
  if cache[1] and draw.ImageFailed then pcall(function() bad=draw.ImageFailed(cache[1]) end) end
  if bad and alt then
    if not cache[2] then pcall(function() cache[2]=draw.LoadImage(alt) end) end
    local ok2=false
    if cache[2] then pcall(function() ok2=draw.ImageLoaded(cache[2]) end) end
    if ok2 then return cache[2] end
  end
  return nil
end
