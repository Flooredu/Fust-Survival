  local hx,hy=svx+svw+8,svy; local hw2,hh=18,svh
  for i=0,47 do draw.RectFilled(hx,hy+i*(hh/48),hw2,hh/48+1,hsv(i/48,1,1),0) end
  draw.Rect(hx,hy,hw2,hh,a(theme.line,1),0,1)
  if inside(hx,hy,hw2,hh) and ui.m.click then p.drag="hue" end
  if p.drag=="hue" then p.h=clamp((ui.m.y-hy)/hh,0,1) end
  local hy2=hy+p.h*hh
  draw.Rect(hx-3,hy2-3,hw2+6,6,{0,0,0,0.6},1,2.5)
  draw.Rect(hx-3,hy2-3,hw2+6,6,{1,1,1,1},1,1.5)
  -- alpha ramp over a checkerboard so a fading color stays visible
  local ax,ay=svx,svy+svh+10; local aw,ah=svw+8+hw2,12
  swatch_checker(ax,ay,aw,ah,{0.13,0.15,0.20,1},{0.08,0.09,0.13,1},4)
  grad_h(ax,ay,aw,ah,{huecol[1],huecol[2],huecol[3],0},{huecol[1],huecol[2],huecol[3],1},40)
  draw.Rect(ax,ay,aw,ah,a(theme.line,1),0,1)
  if inside(ax,ay,aw,ah) and ui.m.click then p.drag="al" end
  if p.drag=="al" then p.al=clamp((ui.m.x-ax)/aw,0,1) end
  local axp=ax+p.al*aw
  draw.Rect(axp-2,ay-3,4,ah+6,{0,0,0,0.6},1,2.5)
  draw.Rect(axp-2,ay-3,4,ah+6,{1,1,1,1},1,1.5)
  local fin=hsv(p.h,p.s,p.v); fin[4]=p.al
  col[p.color]={fin[1],fin[2],fin[3],fin[4]}; cfg_dirty=true
  if p.color=="c_accent" then theme.accent={fin[1],fin[2],fin[3],1} end
  -- live preview chip + hex readout
  local px,py=svx,ay+ah+10
  swatch_checker(px,py,44,26,{0.13,0.15,0.20,1},{0.08,0.09,0.13,1},4)
  draw.RectFilled(px,py,44,26,fin,3)
  draw.Rect(px,py,44,26,a(theme.line,1),3,1)
  local r8=math.floor(fin[1]*255); local g8=math.floor(fin[2]*255); local b8=math.floor(fin[3]*255)
  tmid(px+52,py,13,string.format("#%02X%02X%02X",r8,g8,b8),a(theme.text,1),12)
  tmid(px+52,py+13,13,string.format("A %d%%   R %d  G %d  B %d",math.floor(p.al*100),r8,g8,b8),a(theme.faint,1),10)
  -- quick picks
  local pry=py+34
  for i,pc in ipairs(PRESETS) do
    local bx=svx+(i-1)*21
    draw.RectFilled(bx,pry,18,18,pc,3)
    draw.Rect(bx,pry,18,18,a(theme.line,1),3,1)
    if inside(bx,pry,18,18) and ui.m.click then
      p.h,p.s,p.v=to_hsv(pc); p.al=pc[4] or 1; ui.m.click=false
    end
  end
  if not ui.m.down then p.drag=nil end
end

