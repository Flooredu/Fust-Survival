          if inst.ClassName=="Model" then ismodel=true
          elseif inst.IsA then local okm,vm=pcall(function() return inst:IsA("Model") end); if okm and vm then ismodel=true end end
          if not ismodel then return end
          if cfg.npcs_soldiers==false then return end
          local root=get_model_position_part2(inst)
          if not root then return end
          local rx,ry,rz=safe_pos2(root)
          if not rx then return end
          local hum=nil
          if inst.FindFirstChildOfClass then pcall(function() hum=inst:FindFirstChildOfClass("Humanoid") end) end
          if not hum and inst.FindFirstChild then hum=inst:FindFirstChild("Humanoid") end
          local hp=100; local maxhp=100
          if hum then
            hp=hum.Health or 100; maxhp=hum.MaxHealth or 100
            if maxhp<1 then maxhp=100 end
            if hp<0 then hp=0 end
          end
          local head_p=nil; local torso_p=nil
          if inst.FindFirstChild then
            head_p=inst:FindFirstChild("Head"); torso_p=inst:FindFirstChild("UpperTorso") or inst:FindFirstChild("Torso")
          end
          local npc_parts={}
          if inst.FindFirstChild then
            for _,n in ipairs({"Head","UpperTorso","LowerTorso","HumanoidRootPart","LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot","Torso"}) do
              local pt=nil; pcall(function() pt=inst:FindFirstChild(n) end); if pt then npc_parts[n]=pt end
            end
          end
          table.insert(cache_npcs,{x=rx,y=ry,z=rz,name=inst.Name or "NPC",obj=inst,char=inst,root=root,head=head_p or root,torso=torso_p or root,parts=npc_parts,hp=hp,max_hp=maxhp,is_heli=false,color={0.25,0.85,1.00,1}})
        end)
      end
    end
  end)

  pcall(function()
    if cfg.npcs_heli==false then return end
    local hf=nil
    if ws.FindFirstChild then hf=ws:FindFirstChild("FustPatrolHeli") end
    if not hf and ws.FustPatrolHeli then hf=ws.FustPatrolHeli end
    if hf then
      local heli=nil
      if hf.FindFirstChild then heli=hf:FindFirstChild("PatrolHeliModel") or hf:FindFirstChild("PatrolHeli") end
      if not heli then heli=hf end
      if heli then
        local ismod=false
        if heli.ClassName=="Model" then ismod=true elseif heli.IsA then local okm,vm=pcall(function() return heli:IsA("Model") end); if okm and vm then ismod=true end end
        if ismod then
          local root=get_model_position_part2(heli) or (heli.PrimaryPart)
          if root then
            local rx,ry,rz=safe_pos2(root)
            if rx then
              local hum=nil
              if heli.FindFirstChildOfClass then hum=heli:FindFirstChildOfClass("Humanoid") end
              if not hum and heli.FindFirstChild then hum=heli:FindFirstChild("Humanoid") end
              local hp=5000; local maxhp=5000
              if hum then hp=hum.Health or 5000; maxhp=hum.MaxHealth or 5000 end
              table.insert(cache_npcs,{x=rx,y=ry,z=rz,name="Patrol Helicopter",obj=heli,char=heli,root=root,head=root,torso=root,parts={},hp=hp,max_hp=maxhp,is_heli=true,color={1.00,0.20,0.20,1}})
            end
          end
        end
      end
    end
  end)
end

local function run_gunmods()
  -- weapon-stat patches: the only place setgc is touched. Applies once per
  -- toggle change (debounced) or on the Re-apply button - never on a timer.
  pcall(setgc_apply)
