-- soft outer glow: a few fading shells behind an element
local function glow(x,y,w,h,c,spread)
  for i=(spread or 3),1,-1 do draw.RectFilled(x-i*1.5,y-i*1.5,w+i*3,h+i*3, a(c,0.05), 2) end
