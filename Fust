local TOPBAR_H=38
local SIDEBAR_W=132
local PAD=14
local GUT=12

-- snowfall for the menu. particles live in one table (the main chunk is close
-- to Lua's 200-local ceiling, so this is a single local instead of one per
-- field). flakes are split into depth layers: far ones are small, slow and dim,
-- near ones are larger, faster, brighter and get a soft glow. most draw as tiny
-- six-armed crystals with a bright core (the biggest get side branches); the
-- smallest stay soft dots. each flake drifts down and sideways, sways on a
-- per-flake sine, twinkles and slowly spins, then wraps back to the top when it
-- leaves the panel. the field is seeded once and never reseeded on window height
-- changes: the menu height animates on every tab switch, and reseeding when h
-- drifted made every flake teleport each frame. wraps use the live height
-- instead. the bottom of the panel stays clean like the rest of the menu.
local SNOW={ parts={}, n=0, w=0,
  -- scratch colours, reused for every flake: draw.* copies the channels as soon
  -- as it is called, so one table per role is enough and the field stops
  -- allocating four tables per flake per frame
  cg={1,1,1,1}, cl={1,1,1,1}, cc={1,1,1,1} }
function SNOW.seed(n,w,h)
  SNOW.n=n; SNOW.w=w
  local p=SNOW.parts
  for i=1,n do
    if not p[i] then p[i]={} end
    local f=p[i]
    local z=math.random()
    f.z=z
    f.x=math.random()*w
    f.y=math.random()*h
    f.r=0.55+z*2.4+math.random()*0.5
    f.vy=9+z*46+math.random()*8
    f.amp=2+z*11
    f.ph=math.random()*6.283
    f.sp=0.45+z*0.9+math.random()*0.35
    f.al=0.16+z*0.58
    f.vx=(math.random()-0.5)*(3+z*10)
    f.tw=math.random()*6.283
    f.rot=math.random()*6.283
    f.spin=(math.random()-0.5)*1.1
  end
  for i=n+1,#p do p[i]=nil end
  -- far flakes first so near flakes and their glow sit on top.
  table.sort(p,function(a,b) return a.z<b.z end)
end
function SNOW.update(n,w,h)
  if n~=SNOW.n then SNOW.seed(n,w,h)
  elseif w~=SNOW.w then
    -- width changed (rare): keep every flake but rescale its X so nothing jumps.
    local s=SNOW.w>0 and (w/SNOW.w) or 1
    for i=1,SNOW.n do SNOW.parts[i].x=SNOW.parts[i].x*s end
    SNOW.w=w
  end
  local p=SNOW.parts
  for i=1,SNOW.n do
    local f=p[i]
    f.y=f.y+f.vy*_dt
    f.x=f.x+f.vx*_dt
    f.rot=f.rot+f.spin*_dt
    if f.y>h+3 then f.y=-3; f.x=math.random()*w end
    if f.x<-4 then f.x=f.x+w+8 elseif f.x>w+4 then f.x=f.x-w-8 end
  end
end
function SNOW.draw(x,y,w,h,alpha)
  local p=SNOW.parts
  local tm=now()
  -- snow follows the menu accent instead of a fixed white: the line work leans
  -- toward the accent, the glow blends accent/accent2, and the cores stay a
  -- brighter version of the accent so the flakes still pop against the panel.
  -- The three colours are written into the scratch tables above instead of
  -- being rebuilt with mix() per flake.
  local ac=theme.accent; local ac2=theme.accent2
  local gc,lc,cc=SNOW.cg,SNOW.cl,SNOW.cc
  gc[1]=ac[1]+(ac2[1]-ac[1])*0.35; gc[2]=ac[2]+(ac2[2]-ac[2])*0.35; gc[3]=ac[3]+(ac2[3]-ac[3])*0.35
  lc[1]=ac[1]+(1-ac[1])*0.12; lc[2]=ac[2]+(1-ac[2])*0.12; lc[3]=ac[3]+(1-ac[3])*0.12
  cc[1]=ac[1]+(1-ac[1])*0.52; cc[2]=ac[2]+(1-ac[2])*0.52; cc[3]=ac[3]+(1-ac[3])*0.52
  for i=1,SNOW.n do
    local f=p[i]
    local fx=x+f.x+math.sin(tm*f.sp+f.ph)*f.amp
    local fy=y+f.y
    if fy>=y-3 and fy<=y+h+3 and fx>=x-3 and fx<=x+w+3 then
      local a=f.al*alpha*(0.82+0.18*math.sin(tm*1.6+f.tw))
      if f.z>0.55 then
        gc[4]=a*0.22
        draw.CircleFilled(fx,fy,f.r*(2.0+f.z),gc,8)
      end
      if f.z>0.28 then
        local L=f.r*(2.4+f.z)
        lc[4]=a*0.92
        local c1,s1=math.cos(f.rot),math.sin(f.rot)
        -- the other two arms are the first one rotated by +60 and +120 degrees,
        -- which is four fewer trig calls per flake than evaluating them directly
        local c2,s2=0.5*c1-0.8660254*s1, 0.8660254*c1+0.5*s1
        local c3,s3=-0.5*c1-0.8660254*s1, 0.8660254*c1-0.5*s1
        draw.Line(fx-c1*L,fy-s1*L,fx+c1*L,fy+s1*L,lc,1)
        draw.Line(fx-c2*L,fy-s2*L,fx+c2*L,fy+s2*L,lc,1)
        draw.Line(fx-c3*L,fy-s3*L,fx+c3*L,fy+s3*L,lc,1)
        cc[4]=a
        draw.CircleFilled(fx,fy,math.max(0.7,f.r*0.32),cc,6)
        -- side branches on the biggest crystals, one pair per arm.
        if f.z>0.84 then
          local bl=L*0.34
          for k=0,5 do
            local ang=f.rot+k*1.0472
            local bx=fx+math.cos(ang)*L*0.62
            local by=fy+math.sin(ang)*L*0.62
            local ca,sa=math.cos(ang+0.9),math.sin(ang+0.9)
            local cb,sb=math.cos(ang-0.9),math.sin(ang-0.9)
            draw.Line(bx,by,bx+ca*bl,by+sa*bl,lc,1)
            draw.Line(bx,by,bx+cb*bl,by+sb*bl,lc,1)
          end
        end
      else
        lc[4]=a
        draw.CircleFilled(fx,fy,f.r,lc,6)
      end
    end
  end
end

-- =========================================================================
-- ESP: players, extras and radar.
-- Source of truth is the Project Vector entity cache documented in the API
-- dump: entity.GetPlayers() gives Name/Team/ToolName/Health, and each player
-- exposes GetBounds(), GetBonesScreen() and DistanceTo(). Every colour hangs
-- off the toggle it paints, as an inline chip like the World tab, so the
-- swatch sits beside the feature instead of in a separate column.
-- =========================================================================
local ESP_SKEL={
  {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
  {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
  {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
  {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
  {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
-- Property readers used through pcall(fn, arg). The per-player closures these
-- replace were allocated every frame for every player, which is the other half
-- of the GC churn behind the occasional stutter when a lot is on screen.
local PF={
  -- real metres per stud, used only to turn a stored range into the studs the
  -- engine compares against. Distance labels do not use it: the game's own
  -- readouts count one stud as one metre, so a label prints the raw stud figure
  -- and matches the kill feed exactly. All range conversions still go through
  -- this one number so the UI can never disagree with the cull that uses it.
  m=M_PER_STUD,
  dist=function(p) return p:DistanceTo() end,
  name=function(p) return p.Name end,
  tool=function(p) return p.ToolName end,
  bounds=function(p) return p:GetBounds() end,
  bones=function(p) return p:GetBonesScreen() end,
  head=function(p) return p.HeadPosition end,
  hp=function(p) return p.Health end,
  mhp=function(p) return p.MaxHealth end,
  -- Reflection readers for the instance accessors. Reading a property through
  -- pcall(fn,obj) instead of pcall(function() return obj.X end) removes one
  -- closure per read; the NPC pass does thousands of those a second once
  -- skeletons are on, and the GC work from them was pure overhead.
  cframe=function(o) return o.CFrame end,
  cfpos=function(cf) return cf.Position end,
  pos=function(o) return o.Position end,
  -- live root velocity as three scalars. This is the exact travel speed the
  -- lead needs, with none of the animation noise a bone-to-bone delta carries.
  -- Instances (NPC rigs) have no Velocity, so the call errors and the lead
  -- falls back to the old frame-delta estimate.
  vel=function(p) local v=p.Velocity return v.X,v.Y,v.Z end,
  addr=function(o) return o.Address end,
  cls=function(o) return o.ClassName end,
  prim=function(o) return o.PrimaryPart end,
  rootpart=function(o) return o.RootPart end,
  get=function(o,k) return o[k] end,
  find=function(o,n) return o:FindFirstChild(n) end,
  char=function(p)
    local c=p.Character
    if c then return c end
    local g=p.GetCharacter
    if type(g)=="function" then return g(p) end
    return nil
  end,
  desc=function(o) return o:GetDescendants() end,
  -- ancestry test for the Wall Check: raycast.Cast hands back the instance it
  -- hit, and anything sitting on the target or on the local player is not a wall
  isd=function(o,a) return o:IsDescendantOf(a) end,
  -- reused scratch buffers for the china-hat ring, so it stops allocating two
  -- tables per player per frame
  xs={}, ys={}, ring={},
  -- radar distance-label cache: the string and its measured width per whole
  -- metre, plus a second scratch colour for the facing tick
  rdtxt={}, rdw={}, rct={1,1,1,1},
  -- team roster cache for esp_mate. Lives here rather than in a main-chunk
  -- local because the chunk is already at the 200-local limit.
  team={ids={},next=0,tf=nil},
}
-- Single-bone projection. player:GetBoneScreen(name) returns three plain
-- scalars, so a pass that only wants one bone (the ESP head anchor) allocates
-- nothing. The full skeleton goes through PF.bonesmemo below instead.
PF.bonescreen=function(p,n) return p:GetBoneScreen(n) end
-- Per-frame bone dictionary memo. The ESP skeleton and the aimbot both want the
-- same {boneName -> {x,y}} dictionary for the same player in the same frame, and
-- GetBonesScreen rebuilds it from scratch on every call. One fetch per player
-- per frame is shared by both passes; the entries are
-- dropped at the next frame boundary because the projection moves with the
-- camera. The dictionary is only built for a player some pass actually asks
-- about, so a target nobody needs never pays for it.
--
-- This is also what makes the ESP skeleton cheap: it used to resolve 15-20
-- bones with one host call each (plus a pcall each) for every rig it drew.
PF.bsc={frame=-1}
PF.bonesmemo=function(p)
  local c=PF.bsc
  if c.frame~=FRAME then
    for k in pairs(c) do c[k]=nil end
    c.frame=FRAME
  end
  local d=c[p]
  if d==nil then
    local ok,v=pcall(PF.bones,p)
    d=(ok and type(v)=="table") and v or false
    c[p]=d
  end
  if d==false then return nil end
  return d
end
-- Per-frame player root memo. The ESP, the chams pass and the radar all want the
-- same p.Position for the same player in the same frame, and every one of those
-- reads crosses into the game thread. One read per player per frame, shared by
-- all three; a failed read is remembered as false so it is not retried either.
PF.pm={frame=-1}
PF.pmemo=function(p)
  local c=PF.pm
  if c.frame~=FRAME then
    for k in pairs(c) do c[k]=nil end
    c.frame=FRAME
  end
  local v=c[p]
  if v==nil then
    local ok,pos=pcall(PF.pos,p)
    v=(ok and pos) and pos or false
    c[p]=v
  end
  if v==false then return nil end
  return v
end
-- Per-frame player flag memo. IsLocal, IsAlive and UserId are property reads
-- that cross into the game thread, and the ESP, chams, radar and aim passes each
-- ask for all three for every player, every frame - so a lobby paid for the same
-- dozen reads per player per frame. One read each per player per frame now.
-- Keyed on FRAME like the other memos, so it cannot outlive the frame.
PF.pf={frame=-1}
PF.pflag=function(p)
  local c=PF.pf
  if c.frame~=FRAME then
    for k in pairs(c) do c[k]=nil end
    c.frame=FRAME
  end
  local e=c[p]
  if not e then
    local id=p.UserId
    if not id and p.Player then id=p.Player.UserId end
    e={il=p.IsLocal and true or false, al=p.IsAlive, uid=id}
    c[p]=e
  end
  return e
end
-- Per-frame view memo. Six passes (aim, hitbox, chams, ESP, radar, NPC) each
-- resolved the local player, their root, the camera eye and the camera forward
-- on their own, so a single frame paid for the same host round-trips up to six
-- times. None of those values can change meaningfully inside one frame, so they
-- are resolved once and shared. Keyed on FRAME, so an
-- entry can never outlive the frame that filled it.
PF.view={frame=-1}
PF.getview=function()
  local v=PF.view
  if v.frame==FRAME then return v end
  v.frame=FRAME
  local lp
  -- pcall takes the host function directly: the two wrapper closures this used
  -- to build (one here, one around the camera block below) were two fresh
  -- closures plus upvalue cells every frame, for nothing pcall cannot do itself
  local ok,cv
  if entity then
    ok,cv=pcall(entity.GetLocalPlayer)
    if ok then lp=cv end
  end
  v.lp=lp
  local lx,ly,lz
  if lp then
    local okp,pv=pcall(PF.pos,lp)
    if okp and pv then lx,ly,lz=pv.X or pv.x,pv.Y or pv.y,pv.Z or pv.z end
  end
  v.lx,v.ly,v.lz=lx,ly,lz
  local cx,cy,cz,fx,fy,fz
  local cpv,lvv,fov
  if camera then
    ok,cv=pcall(camera.GetPosition)
    if ok and cv then cpv=cv; cx,cy,cz=cv.X,cv.Y,cv.Z end
    ok,cv=pcall(camera.GetLookVector)
    if ok and cv then lvv=cv; fx,fy,fz=cv.X or 0,cv.Y or 0,cv.Z or 0 end
    ok,cv=pcall(camera.GetFov)
    if ok then fov=cv end
  end
  v.cx,v.cy,v.cz=cx,cy,cz
  -- field of view, read once per frame: the World pass turns it into a cone
  -- pre-cull so off-screen markers never pay for a projection
  if type(fov)~="number" or fov<10 or fov>170 then fov=70 end
  v.fov=fov
  -- a zero-length look vector is "no camera", not "forward is zero": the
  -- behind-camera culls test F.dot before using it
  if fx and fx*fx+fy*fy+fz*fz<1e-9 then fx,fy,fz=nil,nil,nil; lvv=nil end
  v.fx,v.fy,v.fz=fx,fy,fz
  -- the raw vectors are kept so the passes that need a Vector3 (the hitbox
  -- silent-aim hook) reuse this one instead of rebuilding it
  v.cpv,v.lvv=cpv,lvv
  return v
end
-- Per-frame player roster. entity.GetPlayers() rebuilds a player object for
-- every player on every call, and six passes called it once each - six full
-- rebuilds and six N-object allocations per frame. The wrappers are live, so a
-- single list stays valid for the whole frame.
PF.pl={frame=-1,list=nil}
PF.players=function()
  local c=PF.pl
  if c.frame==FRAME then return c.list end
  c.frame=FRAME
  local ok,v=pcall(entity.GetPlayers)
  if ok and type(v)=="table" then c.list=v else c.list=nil end
  return c.list
end
-- Split a bone-link list into maximal paths. A skeleton used to go out as one
-- draw.Line per link, and every Line carries its own shadow pass, so a player
-- rig cost 28 draws and an NPC 28. Each path is a connected polyline, so it can
-- go out as one draw.Poly (2 draws) instead. The point scratch is preallocated
-- per path, so the draw pass still allocates nothing per frame.
PF.chains=function(links)
  local adj={}
  for i=1,#links do
    local a,b=links[i][1],links[i][2]
    local t=adj[a]; if not t then t={}; adj[a]=t end
    t[#t+1]=b
    t=adj[b]; if not t then t={}; adj[b]=t end
    t[#t+1]=a
  end
  local deg={}
  for k,t in pairs(adj) do deg[k]=#t end
  local used={}
  local out={}
  local function ekey(a,b) if a>b then a,b=b,a end return a*100+b end
  for i=1,#links do
    local a,b=links[i][1],links[i][2]
    local ek=ekey(a,b)
    if not used[ek] then
      used[ek]=true
      local path={a,b}
      -- walk forward from b, then backward from a, while the next node only
      -- continues the path (degree 2). A branch point (degree 1 or 3+) ends it.
      local prev,cur=a,b
      while deg[cur]==2 do
        local nb=adj[cur]
        local nxt=nb[1]==prev and nb[2] or nb[1]
        local k2=ekey(cur,nxt)
        if used[k2] then break end
        used[k2]=true
        path[#path+1]=nxt
        prev,cur=cur,nxt
      end
      prev,cur=b,a
      while deg[cur]==2 do
        local nb=adj[cur]
        local nxt=nb[1]==prev and nb[2] or nb[1]
        local k2=ekey(cur,nxt)
        if used[k2] then break end
        used[k2]=true
        table.insert(path,1,nxt)
        prev,cur=cur,nxt
      end
      local pts={}
      for k=1,#path do pts[k]={0,0} end
      out[#out+1]={nodes=path,pts=pts}
    end
  end
  return out
end
PF.bone_names={"Head","UpperTorso","LowerTorso",
  "LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand",
  "LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}
PF.bone_idx={}
PF.bone_links={}
-- unit circle for the analytic China Hat (both the player and NPC passes lay the
-- brim ring out in screen space, so the cos/sin pairs are computed once here
-- instead of 16 times per target per frame)
PF.hc,PF.hs={},{}
-- built inside a function so its loop variables do not eat into the main
-- chunk's 200-local budget
;(function()
  local names=PF.bone_names
  for i=1,#names do PF.bone_idx[names[i]]=i end
  local L=PF.bone_links
  for i=1,#ESP_SKEL do
    local a=PF.bone_idx[ESP_SKEL[i][1]]
    local b=PF.bone_idx[ESP_SKEL[i][2]]
    if a and b then L[#L+1]={a,b} end
  end
  for i=1,16 do
    local t=(i-1)/16*math.pi*2
    PF.hc[i]=math.cos(t); PF.hs[i]=math.sin(t)
  end
end)()
-- The ESP skeleton walks PF.bone_links directly, one draw.Line per link. The
-- batched-polyline form (and the per-bone re-projection it needed for bones the
-- host had culled off screen) is gone: a link is stroked only when both of its
-- bones came back from the host's dictionary, so every point handed to the
-- renderer is on screen and nothing can be clipped across the rig.
PF.px,PF.py,PF.pok={},{},{}
-- Team check. This place does not use Roblox's Teams service, so the cached
-- Team/HasTeam fields are empty for everyone and a string compare never matches.
-- Fust's own team system is client-side: the FustTeam LocalScript tags every
-- online teammate with a Part named "Tag<userId>" under
-- workspace.CurrentCamera.FustTeamTags, and the game's own friendly test (in the
-- place source) is exactly that lookup. Reading the same folder keeps the aimbot
-- and the ESP in agreement with the game. The roster only changes when
-- someone joins or leaves a team, so the id set is cached and rebuilt every
-- PF.team.step calls: this runs once per player in four passes, and a
-- FindFirstChild per call showed up in the frame budget.
local function esp_mate(p,lp)
  if not p then return false end
  -- UserId never changes for a session, so it comes from the per-frame player
  -- flag memo instead of being re-read by every pass that asks
  local id=PF.pflag(p).uid
  if not id then return false end
  if lp and lp.UserId==id then return true end
  local t=PF.team
  -- Rebuild on a frame cadence, not a call count. This runs once per player in
  -- four passes, so a 60-call budget rebuilt the roster almost every frame; the
  -- closure and the per-tag substrings from that were steady garbage. The team
  -- roster only changes when someone joins or leaves a team, so once a second is
  -- plenty.
  if FRAME>=t.next then
    t.next=FRAME+60
    local ids=t.ids
    for k in pairs(ids) do ids[k]=nil end
    -- pcall: a build whose instance wrapper refuses CurrentCamera or the folder
    -- must not take the ESP/aim frame down. On failure tf stays nil and the
    -- cached Team field below is used instead.
    local tf
    pcall(function()
      local cw=nil
      if game and game.Workspace then cw=game.Workspace.CurrentCamera end
      if not cw and workspace then cw=workspace.CurrentCamera end
      tf=cw and cw:FindFirstChild("FustTeamTags")
      if not tf then
        local ws=nil
        if game and game.Workspace then ws=game.Workspace end
        if not ws and workspace then ws=workspace end
        tf=ws and ws:FindFirstChild("FustTeamTags")
      end
      if tf then
        local list=tf:GetChildren()
        for _,ch in ipairs(list) do
          local nm=ch and ch.Name
          if nm and nm:sub(1,3)=="Tag" then
            local uid=tonumber(nm:sub(4))
            if uid then ids[uid]=true end
          end
        end
      end
    end)
    t.tf=tf
  end
  if t.ids[id] then return true end
  -- No tag folder at all: the team module is not running, so fall back to the
  -- cached Team field in case this place ever moves to the Teams service.
  if t.tf then return false end
  if not (lp and lp.HasTeam and p.HasTeam) then return false end
  return p.Team==lp.Team
end
-- precomputed red->green ramp for the health number, so the per-player mix()
-- does not allocate three tables every frame
local HP_RAMP={}
for i=0,20 do HP_RAMP[i]=mix({0.95,0.28,0.32,1},{0.35,0.95,0.50,1},i/20) end

-- Picture art for the named styles, one entry per Picture Style index (the combo
-- stores the index, so this order is the menu order). Each texture loads lazily
-- on first use: LoadImage dedupes by URL, so it is one download per session and
-- nothing downloads unless that style is actually selected. alt is a retry used
-- only when the primary reports a decode failure (the yimg wrapper serves webp,
-- so Lebron keeps a jpeg fallback). nil from tex_get just means "not ready yet",
-- and the box falls back to its plain rectangle until the art arrives.
local PIC_SRC={
  -- King Von
  {url="https://i.pinimg.com/736x/74/4f/b1/744fb1971ead089e6942f41b005793f3.jpg"},
  -- Charlie Kirk
  {url="https://pbs.twimg.com/profile_images/2054703704486424576/__Kn5mRy.jpg"},
  -- Lebron James
  {url="https://s.yimg.com/lo/mysterio/api/30692778d6a3a094db06b8caf63069ef7a87a893c16b5e891271e10ff781cca7/"
    .."lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/"
    .."https://media.zenfs.com/en/hardwood_heroics_234/84963e67515a9830b7105907f8a1088e.jpg",
   alt="https://media.zenfs.com/en/hardwood_heroics_234/84963e67515a9830b7105907f8a1088e.jpg"},
  -- Benjamin Netanyahu: msn/akamaized CDN, query string kept exactly as supplied
  {url="https://img-s-msn-com.akamaized.net/tenant/amp/entityid/AA2gqeGw.img?w=768&h=1152&m=6&x=152&y=253&s=349&d=349"},
}
-- one loader for every style: the handle lives on the entry, and the alt handle
-- is only requested after the primary reports a decode failure
local function tex_get(e)
  if not e then return nil end
  if not (draw.LoadImage and draw.Image and draw.ImageLoaded) then return nil end
  if not e.tex then pcall(function() e.tex=draw.LoadImage(e.url) end) end
  local ok=false
  if e.tex then pcall(function() ok=draw.ImageLoaded(e.tex) end) end
  if ok then return e.tex end
  local bad=false
  if e.tex and draw.ImageFailed then pcall(function() bad=draw.ImageFailed(e.tex) end) end
  if bad and e.alt then
    if not e.atex then pcall(function() e.atex=draw.LoadImage(e.alt) end) end
    local ok2=false
    if e.atex then pcall(function() ok2=draw.ImageLoaded(e.atex) end) end
    if ok2 then return e.atex end
  end
  return nil
end
local function pic_tex(i) return tex_get(PIC_SRC[i]) end

-- Per-frame scratch for the player passes. One table so the per-player bodies
-- can be plain functions (pcall(esp_player,p)) instead of closures allocated for
-- every player every frame: that churn was half of the overlay jitter on a full
-- lobby. f = player ESP, c = chams, ch = chroma scratch, txt = text widths,
-- dt = distance labels, hp = staggered health.
local ESP_S={f={},c={},ch={1,1,1,1},txt={},dt={},hp={}}
-- Resolve the origin and the camera forward vector once per pass. Distances are
-- measured from the local player's root (the same point DistanceTo uses), with
-- the camera only as a fallback, and the forward vector powers the
-- behind-camera cull: a target behind the eye cannot project a single bone.
local function esp_view(F)
  -- local player, root, eye and forward all come from the per-frame memo; the
  -- ESP and the chams pass share one resolution instead of doing it twice
  local v=PF.getview()
  local lx,ly,lz=v.lx,v.ly,v.lz
  if not lx then lx,ly,lz=v.cx,v.cy,v.cz end
  if not lx then return false end
  F.lp,F.lx,F.ly,F.lz=v.lp,lx,ly,lz
  -- Eye position for the behind-camera cull. It has to come from the camera, not
  -- from the player root: in third person (and freecam) the eye sits several
  -- studs behind the root, so a root-relative test drops targets that are on
  -- screen just behind the player.
  F.cx,F.cy,F.cz=v.cx,v.cy,v.cz
  if v.fx then
    F.fx,F.fy,F.fz,F.dot=v.fx,v.fy,v.fz,true
  else
    F.fx,F.fy,F.fz,F.dot=0,0,0,false
  end
  return true
end
-- Text width memo. GetTextSize is a host call and names/weapons repeat every
-- frame, so each string is measured once per size.
local function esp_tw(s,sz)
  local e=ESP_S.txt[s]
  if not e then e={}; ESP_S.txt[s]=e end
  local w=e[sz]
  if not w then w=ts(s,sz); e[sz]=w end
  return w
end
local function esp_player(p)
  local F=ESP_S.f
  -- local/alive come from the per-frame flag memo, shared with chams and radar
  local fl=PF.pflag(p)
  if p==F.lp or fl.il then return end
  if fl.al==false then return end
  -- Live root: the same number DistanceTo() returns, computed locally, and the
  -- vector for the behind-camera cull. A target behind the eye skips the whole
  -- rig - box, bones, hat and dot - before any bone call is made. The read is
  -- shared with the chams and radar passes through PF.pmemo.
  local pos=PF.pmemo(p)
  if not pos then return end
  local dx,dy,dz=pos.X-F.lx,pos.Y-F.ly,pos.Z-F.lz
  local d2=dx*dx+dy*dy+dz*dz
  if d2>F.md2 then return end
  if F.dot then
    -- Eye-relative when the camera position is known. If it is not, the root is
    -- the only origin available, and the test is skipped inside 50 studs where
    -- the third-person offset could otherwise flip the sign.
    local ax,ay,az
    if F.cx then ax,ay,az=pos.X-F.cx,pos.Y-F.cy,pos.Z-F.cz
    else ax,ay,az=dx,dy,dz end
    if ax*F.fx+ay*F.fy+az*F.fz<=0 and (F.cx or d2>2500) then return end
  end
  if F.team and esp_mate(p,F.lp) then return end
  local dist=math.sqrt(d2)
  local ch=nil
  if F.chroma then ch=PF.hue_fill(ESP_S.ch,(F.chue+F.idx*0.07)%1,0.75,1) end
  local c_box=col.c_box or {0.45,0.78,1,1}
  local c_bone=col.c_enemy or {0.95,0.35,0.4,1}
  local c_name=col.c_name or {1,1,1,1}
  local c_dist=col.c_dist or {0.87,0.93,1,1}
  local c_weapon=col.c_weapon or c_name
  local c_tr=col.c_tracer or c_bone
  local c_hat=col.c_hat or c_name
  local tsz=F.tsz
  local b
  -- GetBounds is only worth a host call when something actually anchors to the
  -- box. With Box and Health Bar both off the labels hang off the head bone,
  -- which is read below anyway.
  if cfg.esp_box or cfg.esp_hp then
    local okb,bv=pcall(PF.bounds,p); if okb then b=bv end
  end
  local bx,by,bw,bh
  if b and b.valid and (b.w or 0)>1 and (b.h or 0)>1 then bx,by,bw,bh=b.x,b.y,b.w,b.h end
  -- GetBounds reports valid=false only when no part of the rig is on screen, so
  -- there is nothing to draw for this player this frame. On a 1500 m range most
  -- of the server is outside the frustum even when it is in front of the camera,
  -- and without this the name, held item, head and skeleton were still read for
  -- every one of them. It cannot hide a visible target: valid=false means no
  -- on-screen part exists.
  if b and b.valid==false then return end
  -- No size cull here. A rig can be a couple of pixels tall and still be a
  -- legal aimbot target, so skipping it would hide a player the aimbot can
  -- lock. What is cut instead is detail: below ~20 px tall the eight corner
  -- brackets overlap into a smudge and a 10 px held-item label is a grey line,
  -- and those are the two most expensive per-target draws left (the corner box
  -- is eight brackets, each carrying its own shadow pass). The box, name,
  -- distance, health bar and the player himself are always drawn.
  local big = (bh==nil) or bh>=20
  local pname,ptool
  -- name only feeds the Name row and the health cache key, tool only feeds the
  -- Weapon row: reading them when those rows are off was two host calls per
  -- player per frame for values nothing drew
  if cfg.esp_name or cfg.esp_hp then
    local okn,nv=pcall(PF.name,p); if okn then pname=nv end
  end
  if cfg.esp_weapon and big then
    local okt,tv=pcall(PF.tool,p); if okt then ptool=tv end
  end
  -- Head bone: it feeds the anchor, the head dot and the hat. It is only read
  -- when one of those needs it, or when there is no box to anchor the labels.
  local head_x,head_y
  if cfg.esp_hat or cfg.esp_headdot or not bx then
    local okhb,hx,hy,hvis=pcall(PF.bonescreen,p,"Head")
    -- NaN guard: a rejected projection comes back as a non-finite number, and a
    -- single one of those silently kills every draw it touches, which is exactly
    -- what a hat blinking out for a frame looks like
    if okhb and hx and hy and hvis~=false and hx==hx and hy==hy then head_x,head_y=hx,hy end
  end
  -- Pixels per stud at the target. The box height is a free first estimate; the
  -- head probe below replaces it with the exact value whenever a head feature is
  -- on. It also drives the skeleton LOD.
  local pps=(bh and bh>0) and bh/5.6 or 0
  if cfg.esp_hat or cfg.esp_headdot then
    local okh,hv=pcall(PF.head,p)
    if okh and hv then
      -- Both ends of the probe are the SAME point one stud apart, so the screen
      -- gap between them is pixels per stud with no offset baked in. The old
      -- version measured the head BONE against the head PART, so the scale
      -- carried the gap between the two and the cone came out oversized.
      local x0,y0,v0=draw.WorldToScreen(hv.X,hv.Y,hv.Z)
      local y2,v2=select(2,draw.WorldToScreen(hv.X,hv.Y+1,hv.Z))
      if v0 and v2 and y0==y0 and y2==y2 then
        local sc=math.abs(y2-y0)
        if sc>0 then pps=sc end
      end
      -- head bone was off the screen edge: project the head itself so the hat
      -- and the dot still have an anchor
      if not head_x and v0 and x0==x0 and y0==y0 then head_x,head_y=x0,y0 end
    end
  end
  -- China Hat: the brim ring and the apex are laid out in screen space from the
  -- head point and pps. Same world offsets as the wireframe: brim 0.44 studs
  -- above the head, apex 1.16 above it, brim radius 0.62. The one thing that has
  -- to be projected rather than assumed is the brim's squash: a horizontal ring
  -- seen by the camera is an ellipse, its height = width * sin(elevation). That
  -- factor comes from the camera-to-head elevation below, so the hat reads as a
  -- cone from above rather than a flat circle, with a floor so it never
  -- collapses into a line when the camera sits level with the head.
  local hat_apex
  local hat_hs=0
  local hat_sq=1
  if cfg.esp_hat and head_x and pps>0 then
    hat_hs=(cfg.esp_hat_size or 100)/100
    hat_apex=head_y-1.16*hat_hs*pps
    -- head sits ~1.5 studs above the root, which is the point we have here
    if F.cy then
      local ex,ey,ez=pos.X-F.cx,(pos.Y+1.5)-F.cy,pos.Z-F.cz
      local el=math.sqrt(ex*ex+ey*ey+ez*ez)
      if el>0.001 then hat_sq=math.abs(ey)/el end
    elseif F.dot then
      hat_sq=math.abs(F.fy)
    end
    -- Floor the squash. Edge-on the brim is a zero-height ring: the host drops
    -- the degenerate polyline, so the cone read as a sharp spike and then
    -- nothing at all whenever the camera sat level with the target's head. A
    -- quarter of the width still reads as a hat from every angle.
    if hat_sq<0.25 then hat_sq=0.25 end
    if hat_sq>1 then hat_sq=1 end
  end
  if cfg.esp_box and bx then
    local c=hue_or(ch,c_box,1)
    local x0,y0,w0,h0=bx-2,by-2,bw+4,bh+4
    if cfg.esp_boxstyle==1 and big then
      if draw.CornerBox then draw.CornerBox(x0,y0,w0,h0,c) else draw.Rect(x0,y0,w0,h0,c,0,1) end
    elseif cfg.esp_boxstyle==3 then
      -- Picture: the selected portrait fills the box. Until that texture has
      -- downloaded the plain rectangle is drawn instead, so the box never blinks
      -- out while a new style is loading.
      local tex=pic_tex(cfg.esp_picstyle or 1)
      if tex then
        local pop=clamp(cfg.esp_pic_opacity or 100,10,100)/100
        local al=math.floor(clamp(c[4],0,1)*pop*255+0.5)
        local tr,tg,tb=255,255,255
        if ch then
          tr=math.floor(clamp(c[1],0,1)*255+0.5)
          tg=math.floor(clamp(c[2],0,1)*255+0.5)
          tb=math.floor(clamp(c[3],0,1)*255+0.5)
        end
        if al>0 then draw.Image(tex,x0,y0,w0,h0,tr,tg,tb,al) end
      else
        -- photo still downloading / failed to load: plain box for now
        draw.Rect(x0,y0,w0,h0,c,0,1)
      end
    else draw.Rect(x0,y0,w0,h0,c,0,1) end
  end
  -- Health is refreshed once every three frames per player: a bar cannot show a
  -- change faster than that, and two host reads per player per frame was pure
  -- overhead. The cache is keyed by player name, which is unique in a server.
  if cfg.esp_hp and bx then
    local hh,mh=0,100
    local he
    if pname then
      he=ESP_S.hp[pname]
      if not he then he={hp=100,mhp=100,next=0}; ESP_S.hp[pname]=he end
      if FRAME>=he.next then
        local okh2,hv2=pcall(PF.hp,p); if okh2 and hv2 then he.hp=hv2 end
        local okm2,mv2=pcall(PF.mhp,p); if okm2 and mv2 then he.mhp=mv2 end
        he.next=FRAME+3
      end
      hh,mh=he.hp or 0,he.mhp or 100
    else
      local okh2,hv2=pcall(PF.hp,p); if okh2 and hv2 then hh=hv2 end
      local okm2,mv2=pcall(PF.mhp,p); if okm2 and mv2 then mh=mv2 end
    end
    local gap=clamp(bw*0.12,1.5,5)
    pcall(draw.HealthBar,bx-gap,by,bh,hh,mh)
    if cfg.esp_hptext then
      local fsz=math.max(8,tsz-3)
      local frac=clamp(mh>0 and hh/mh or 0,0,1)
      local ht=string.format("%d",math.floor(hh+0.5))
      local tw2,th2=ts(ht,fsz)
      local hc=HP_RAMP[math.floor(frac*20+0.5)]
      draw.Text(math.max(1,bx-gap-10-tw2),by+(bh-th2)*0.5,ht,hue_or(ch,hc,1),fsz)
    end
  end
  local anchor_x,anchor_y=head_x,head_y
  local name_y=by and (by-tsz-4) or (anchor_y and anchor_y-tsz-6)
  if hat_apex and (not name_y or hat_apex<name_y) then name_y=hat_apex-tsz-4 end
  local cx = bx and (bx+bw*0.5) or anchor_x
  if cfg.esp_name and pname and cx and name_y then
    local tw=esp_tw(pname,tsz)
    draw.Text(cx-tw*0.5,name_y,pname,hue_or(ch,c_name,1),tsz)
  end
  local stack_y=by and (by+bh+3) or (anchor_y and anchor_y+4)
  if cfg.esp_dist and cx and stack_y then
    -- studs, which are the game's own metres: the same number the kill feed
    -- prints. The label and its width are memoised per whole metre.
    local dm=math.floor(dist)
    local de=ESP_S.dt[dm]
    if not de then de={}; ESP_S.dt[dm]=de end
    local dl=de.txt
    if not dl then dl=dm.."m"; de.txt=dl end
    local dsz=tsz-2
    local dw=de[dsz]
    if not dw then dw=ts(dl,dsz); de[dsz]=dw end
    draw.Text(cx-dw*0.5,stack_y,dl,hue_or(ch,c_dist,0.9),dsz)
    stack_y=stack_y+dsz+1
  end
  if cfg.esp_weapon and cx and stack_y and ptool and ptool~="" then
    local wsz=tsz-2
    local tw=esp_tw(ptool,wsz)
    draw.Text(cx-tw*0.5,stack_y,ptool,hue_or(ch,c_weapon,0.9),wsz)
  end
  if cfg.esp_tracer then
    local oy=(cfg.esp_tracer_from==1) and F.sh or ((cfg.esp_tracer_from==3) and 0 or F.sh*0.5)
    local tx,ty
    if bx then tx,ty=bx+bw*0.5,by+bh elseif anchor_x then tx,ty=anchor_x,anchor_y end
    if tx then draw.Line(F.hw,oy,tx,ty,hue_or(ch,c_tr,1),1) end
  end
  -- Skeleton: skipped only once the rig is a few pixels tall (pps below 1 is
  -- under ~6 px), where 15 bones and 14 links land on the same handful of pixels
  -- but still cost the same reads and draws.
  if cfg.esp_skel and (bx or head_x) and (pps<=0 or pps>=1.0) then
    local px,py,pok=PF.px,PF.py,PF.pok
    local names=PF.bone_names
    -- One dictionary per player per frame, shared with the aimbot
    -- (PF.bonesmemo). This replaced 15-20 GetBoneScreen host calls plus
    -- a pcall each; a bone the rig does not have, or one the host left out
    -- because it is off screen, is simply absent from the dictionary.
    --
    -- Only the 15 R15 names are read. The host also resolves the R6 aliases
    -- ("Torso", "Left Arm", ...) onto the R15 parts, so if those keys come back
    -- in the dictionary too they would draw a second skeleton on top of the
    -- first: chest-to-hip diagonals plus a head-to-hip line straight through
    -- the torso, which reads as arms bent the wrong way. Every rig in this game
    -- is R15 (verified in the live instance tree), so the R6 links had nothing
    -- of their own to draw and are gone.
    local d=PF.bonesmemo(p)
    for i=1,#names do
      local e=d and d[names[i]]
      if e and e[1] and e[2] then
        local vx,vy=e[1],e[2]
        if vx>-8 and vy>-8 and vx<F.sw+8 and vy<F.sh+8 then
          px[i],py[i],pok[i]=vx,vy,true
        else
          pok[i]=nil
        end
      else
        pok[i]=nil
      end
    end
    -- One draw.Line per link, which is how the skeleton was originally drawn.
    -- A link is stroked only when both of its bones came back from the
    -- dictionary, so every point handed to the renderer is on screen. The old
    -- batched draw.Poly form also re-projected missing bones with a single-bone
    -- call, and a bad projection there (a mirrored behind-camera coordinate, or
    -- a bone the host could not resolve) drew a line off across the rig - which
    -- is exactly what the arm shapes were. Nothing is re-projected now: a bone
    -- the host culled is simply not drawn until it comes back on screen.
    local c=hue_or(ch,c_bone,0.9)
    local links=PF.bone_links
    for li=1,#links do
      local l=links[li]
      local a,b=l[1],l[2]
      if pok[a] and pok[b] then
        draw.Line(px[a],py[a],px[b],py[b],c,1)
      end
    end
  end
  -- Head dot: the ring radius is 0.62 studs of head at the target's depth, which
  -- is exactly what the old head-height probe measured - now read from pps.
  if cfg.esp_headdot and head_x then
    local hs=(cfg.esp_headdot_size or 100)/100
    local hr=pps>0 and (0.62*hs*pps) or (bx and bh*0.11*hs or nil)
    if hr and hr>0.4 then
      local c=hue_or(ch,c_bone,1)
      if hr<2.4 then
        -- at this size the outline and its shadow overlap and read as a black
        -- smudge on the head, so a filled pip keeps the colour
        draw.CircleFilled(head_x,head_y,math.max(hr,1.6),c,10)
      else
        draw.Circle(head_x,head_y,hr,c,math.max(10,math.floor(hr*3)),1)
      end
    end
  end
  if hat_apex and pps>0 then
    local rad=0.62*hat_hs*pps
    local brimy=head_y-0.44*hat_hs*pps
    local c=hue_or(ch,c_hat,1)
    local sq=hat_sq
    if rad<3 then
      -- below ~3 px the rim segments and ribs land on the same pixels and the
      -- black shadow pass wins, so one filled silhouette keeps the colour. On a
      -- build without PolyFilled the outline is drawn instead: returning nothing
      -- here made the hat vanish on every target past a certain distance.
      if draw.PolyFilled then
        draw.PolyFilled({{head_x,hat_apex},{head_x+rad,brimy},{head_x-rad,brimy}},c)
      else
        draw.Line(head_x,hat_apex,head_x+rad,brimy,c,1)
        draw.Line(head_x+rad,brimy,head_x-rad,brimy,c,1)
        draw.Line(head_x-rad,brimy,head_x,hat_apex,c,1)
      end
    else
      local hc,hsn=PF.hc,PF.hs
      local xs,ys=PF.xs,PF.ys
      -- One ring resolution. Stepping 8 -> 12 -> 16 segments as the target
      -- closed in changed the silhouette mid-approach, which is what read as the
      -- brim turning sharp; the ring is a single draw either way.
      local seg=16
      for i=1,seg do
        xs[i]=head_x+hc[i]*rad
        ys[i]=brimy+hsn[i]*rad*sq
      end
      -- the brim ring goes out as one closed polyline instead of 16 draw.Line
      -- calls. Every Line carries its own shadow pass, so this turns 32 draws
      -- into 2 on the hottest cosmetic in the ESP. The point tables are reused
      -- and only the tail is trimmed when the ring shrinks, so nothing is
      -- allocated per target. Falls back to the line loop on a build without
      -- draw.PolyClosed.
      local pc=draw.PolyClosed
      local ring=PF.ring
      if type(pc)=="function" then
        for i=1,seg do
          local p=ring[i]
          if not p then p={0,0}; ring[i]=p end
          p[1]=xs[i]; p[2]=ys[i]
        end
        for i=seg+1,#ring do ring[i]=nil end
        pc(ring,c,1)
      else
        for i=1,seg do local j=i%seg+1; draw.Line(xs[i],ys[i],xs[j],ys[j],c,1) end
      end
      for i=1,seg,2 do draw.Line(head_x,hat_apex,xs[i],ys[i],c,1) end
    end
  end
end

local function run_esp()
  if not cfg.esp_on then return end
  -- 0 means "show nothing": the slider is an on/off gate at the bottom of its
  -- travel, so nothing renders at all instead of everything
  local md=(cfg.esp_maxdist or 1500)/PF.m
  if md<=0 then return end
  local F=ESP_S.f
  local sw,sh=scr()
  F.sw,F.sh,F.hw=sw,sh,sw*0.5
  if not esp_view(F) then return end
  F.md=md; F.md2=md*md
  F.tsz=cfg.esp_textsize or 12
  F.chroma=cfg.esp_chroma
  F.chue=now()*0.12
  F.team=cfg.esp_team
  local players=PF.players()
  if not players then return end
  for idx,p in ipairs(players) do
    F.idx=idx
    pcall(esp_player,p)
  end
end

-- =========================================================================
-- CHAMS: native body hulls through draw.ChamsPlayer, which merges overlapping
-- limb hulls before rendering so the body reads as one silhouette with no
-- seams. Filled is style 0, Outline is style 1.
-- =========================================================================
local function chams_one(p)
  local F=ESP_S.c
  local fl=PF.pflag(p)
  if p==F.lp or fl.il or fl.al==false then return end
  -- same root the ESP pass read this frame (PF.pmemo), so the hull and the box
  -- can never disagree and the second host read disappears
  local pos=PF.pmemo(p)
  if not pos then return end
  local dx,dy,dz=pos.X-F.lx,pos.Y-F.ly,pos.Z-F.lz
  local d2=dx*dx+dy*dy+dz*dz
  if d2>F.md2 then return end
  -- a body behind the eye is not on screen, so the hull pass is skipped
  if F.dot then
    local ax,ay,az
    if F.cx then ax,ay,az=pos.X-F.cx,pos.Y-F.cy,pos.Z-F.cz
    else ax,ay,az=dx,dy,dz end
    if ax*F.fx+ay*F.fy+az*F.fz<=0 and (F.cx or d2>2500) then return end
  end
  if F.team and esp_mate(p,F.lp) then return end
  -- opacity comes from the Chams swatch; chroma only replaces the hue
  local ch=nil
  if F.chroma then ch=PF.hue_fill(ESP_S.ch,(F.chue+F.idx*0.07)%1,0.8,1) end
  draw.ChamsPlayer(p,hue_or(ch,F.c1,1),F.style)
end

local function run_chams()
  -- chams live under ESP -> Players, so Enable ESP is their master too. without
  -- this the bodies kept rendering after the ESP pass had already returned.
  if not (cfg.esp_on and cfg.chams_on) then return end
  if not draw.ChamsPlayer then return end
  -- chams share the Player Range slider; 0 gates them off completely
  local md=(cfg.esp_maxdist or 1500)/PF.m
  if md<=0 then return end
  local F=ESP_S.c
  if not esp_view(F) then return end
  F.md2=md*md
  F.team=cfg.esp_team
  F.chroma=cfg.esp_chroma
  F.chue=now()*0.12
  F.style=clamp((cfg.chams_mode or 1)-1,0,1)
  F.c1=col.c_chams or {1,0.22,0.34,1}
  local players=PF.players()
  if not players then return end
  for idx,p in ipairs(players) do
    F.idx=idx
    pcall(chams_one,p)
  end
end

-- Radar blip body. Hoisted out of the per-player loop: a closure allocated for
-- every player every frame was pure garbage, and a busy radar with 30 targets
-- produced 30 fresh functions a frame. The per-frame values it needs live in
-- PF.radar, filled by run_radar.
PF.radar={rc={1,1,1,1},ch={1,1,1,1}}
-- Per-player facing cache for the radar tick. LookVector is a host read and the
-- stub it drives is seven pixels long, so it is refreshed every sixth frame
-- instead of every frame. Entries are pruned in run_radar once a player has not
-- been drawn for ten seconds, so a busy server does not leak one table each.
PF.lv={}
PF.lvec=function(p)
  local e=PF.lv[p]
  if not e then e={x=0,z=0,next=0}; PF.lv[p]=e end
  if FRAME>=e.next then
    e.next=FRAME+6
    local ok,lv=pcall(PF.get,p,"LookVector")
    if ok and lv then e.x,e.z=lv.X or 0,lv.Z or 0 end
  end
  return e.x,e.z
end
PF.radar_one=function(p,idx)
  local R=PF.radar
  local lp=R.lp
  local fl=PF.pflag(p)
  if p==lp or fl.il then return end
  if fl.al==false then return end
  local mate=esp_mate(p,lp)
  if cfg.esp_team and mate then return end
  -- the ESP/chams pass already read this player's root this frame
  local pos=PF.pmemo(p)
  if not pos then return end
  -- blip placement and the label below use the same origin (the local player's
  -- root, camera only as a fallback), so third person or freecam cannot slide
  -- the dots away from the distances printed next to them
  local ox,oy,oz=R.ox,R.oy,R.oz
  local dx,dz=pos.X-ox,pos.Z-oz
  local dd=math.sqrt(dx*dx+dz*dz)
  if dd>R.rng then return end
  local px=R.cx+(dx*R.rtx+dz*R.rtz)*(R.rsz*0.5-8)/R.rng
  local py=R.cy-(dx*R.fx+dz*R.fz)*(R.rsz*0.5-8)/R.rng
  local cb=col.c_enemy or {0.95,0.35,0.4,1}
  -- blips use the Skeleton swatch, so that picker's opacity still applies;
  -- radar Opacity multiplies on top of it, chroma only swaps the hue
  local ch=nil
  if R.chroma then ch=PF.hue_fill(R.ch,(R.chue+idx*0.07)%1,0.75,1) end
  local c=hue_or(ch,cb,R.al)
  local ca=mate and c[4]*0.5 or c[4]
  -- facing tick: the target's own LookVector, run through the same
  -- camera-relative rotation as the blip, so the line points the way the
  -- player is actually facing on the radar. the stub starts at the dot's
  -- rim and keeps a fixed pixel length, so it reads the same close up and
  -- at the edge of range instead of collapsing into the dot. The vector is a
  -- host read, so PF.lvec caches it for six frames per player: a facing angle
  -- does not visibly change in that time, and the read drops by five sixths.
  local lx,lz=PF.lvec(p)
  if lx~=0 or lz~=0 then
    local ll=math.sqrt(lx*lx+lz*lz)
    if ll>1e-6 then
      local ex=(lx*R.rtx+lz*R.rtz)/ll
      local ey=-(lx*R.fx+lz*R.fz)/ll
      local r0=mate and 2.2 or 3
      local tc=PF.rct
      tc[1]=c[1]; tc[2]=c[2]; tc[3]=c[3]; tc[4]=ca*0.85
      draw.Line(px+ex*r0,py+ey*r0,px+ex*(r0+7),py+ey*(r0+7),tc,1)
    end
  end
  local rc=R.rc
  rc[1]=c[1]; rc[2]=c[2]; rc[3]=c[3]; rc[4]=ca
  draw.CircleFilled(px,py,mate and 2.2 or 3,rc,10)
  -- straight-line distance from the local player, in the game's metres
  -- (studs), so it matches the kill feed. the label sits to the right of
  -- the blip and flips left when it would leave the panel, so a target on
  -- the radar edge still gets a readable number.
  local ddx,ddz=pos.X-ox,pos.Z-oz
  local ddy=pos.Y-oy
  local dm=math.floor(math.sqrt(ddx*ddx+ddy*ddy+ddz*ddz))
  local txt=PF.rdtxt[dm]
  if not txt then txt=dm.."m"; PF.rdtxt[dm]=txt end
  local tw=PF.rdw[dm]
  if not tw then tw=ts(txt,9); PF.rdw[dm]=tw end
  -- 11px clears the facing tick (dot rim + 7px stub), so the number never
  -- sits on top of the direction line
  local tx2=px+11
  if tx2+tw>R.rx+R.rsz-3 then tx2=px-11-tw end
  draw.Text(tx2,py-5,txt,rc,9)
end

local function run_radar()
  if not cfg.rad_on then return end
  local sw,sh=scr()
  local rsz=cfg.rad_size or 160
  local rng=math.max(0.5,cfg.rad_range or 50)/PF.m
  local al=clamp((cfg.rad_alpha or 80)/100,0,1)
  local rx=clamp(sw*(cfg.rad_x or 88)/100-rsz*0.5,0,math.max(0,sw-rsz))
  local ry=clamp(sh*(cfg.rad_y or 8)/100,0,math.max(0,sh-rsz))
  local cx,cy=rx+rsz*0.5,ry+rsz*0.5
  draw.RectFilled(rx-2,ry-2,rsz+4,rsz+4,{0,0,0,0.55*al},8)
  draw.Rect(rx-2,ry-2,rsz+4,rsz+4,{1,1,1,0.10*al},8,1)
  for i=1,3 do draw.Circle(cx,cy,(rsz*0.5-3)*i/3,{1,1,1,0.07*al},40,1) end
  draw.Line(cx,ry+4,cx,ry+rsz-4,{1,1,1,0.07*al},1)
  draw.Line(rx+4,cy,rx+rsz-4,cy,{1,1,1,0.07*al},1)
  draw.CircleFilled(cx,cy,2.6,{0.3,1,0.55,al},10)
  -- the view memo already resolved the eye and the forward vector this frame
  local vw=PF.getview()
  if not vw.cx then return end
  -- rotate the world into the camera's horizontal frame: forward = look.XZ,
  -- right = (-look.Z, look.X). deriving it this way keeps the radar from being
  -- mirrored, so a target straight ahead sits at the top of the panel.
  local fx,fz=vw.fx or 0,vw.fz or 0
  local fl=math.sqrt(fx*fx+fz*fz); if fl<1e-6 then fl=1 end
  fx,fz=fx/fl,fz/fl
  local R=PF.radar
  R.lp=vw.lp
  R.rx,R.rsz,R.rng,R.al=rx,rsz,rng,al
  R.cx,R.cy=cx,cy
  R.fx,R.fz=fx,fz
  R.rtx,R.rtz=-fz,fx
  -- distance labels are measured from the player, not the camera, so third
  -- person or freecam does not shift the readout. fall back to the camera when
  -- the local player has no root part yet.
  R.ox,R.oy,R.oz=vw.cx,vw.cy,vw.cz
  if vw.lx then R.ox,R.oy,R.oz=vw.lx,vw.ly,vw.lz end
  R.chroma=cfg.esp_chroma
  R.chue=now()*0.12
  local players=PF.players()
  if players then
    for idx,p in ipairs(players) do pcall(PF.radar_one,p,idx) end
  end
  -- drop facing-cache entries for players the radar has not drawn in ten
  -- seconds: without this the cache keeps one table per player who ever came
  -- into range. Only runs about once every ten seconds at 60 fps.
  if FRAME%600==0 then
    for k,e in pairs(PF.lv) do
      if e.next<FRAME-600 then PF.lv[k]=nil end
    end
  end
  draw.Text(rx+6,ry+rsz-14,"RADAR",{1,1,1,0.35*al},9)
end

-- =========================================================================
-- HUD: watermark, keybind list and feature bar.
-- They read the menu's own state (cfg toggles + the bind table), so a feature
-- shows up the moment it is switched on and drops out when it is switched off.
-- No gameplay state is touched: these are overlays over the menu's settings.
-- =========================================================================
local hud_start=now()

-- shared chrome, so the three overlays read as one family: stacked shadow
-- shells, base fill, frame plus inner echo line, accent rule on the top edge
-- and the tapered corner brackets the menu uses. ap is the panel's fade.
local function hud_panel(x,y,w,h,ap,r)
  r=r or theme.round
  local e=mix(theme.accent,theme.accent2,0.5)
  for i=3,1,-1 do
    draw.RectFilled(x-i*2, y-i*1.5, w+i*4, h+i*3, {0,0,0,0.07*ap}, r+i*2)
  end
  draw.RectFilled(x,y,w,h, {theme.base[1],theme.base[2],theme.base[3],0.90*ap}, r)
  draw.Rect(x,y,w,h, a(theme.line,0.85*ap), r, 1)
  draw.Rect(x+3,y+3,w-6,h-6, a(theme.line,0.16*ap), r, 1)
  draw.RectFilled(x+r, y, w-r*2, 2, {e[1],e[2],e[3],0.9*ap}, 0)
  corners(x,y,w,h, 15, a(e,0.95*ap), 2, a(e,0.4*ap))
end
-- the same numbered section header the menu draws
local function hud_head(x,y,w,idx,label)
  local nw=ts(idx,10)
  draw.RectFilled(x,y,nw+8,13, a(theme.accent,0.16), 2)
  draw.Text(x+4,y+2,idx, a(theme.accent,0.95), 10)
  local caps=string.upper(label); local hw=ts(caps,11)
  draw.Text(x+nw+15,y+1,caps, a(theme.faint,1), 11)
  local lx=x+nw+hw+23
  if lx<x+w then draw.Line(lx,y+9,x+w,y+9, a(theme.line,0.45), 1) end
end
-- drag grip. only drawn while the menu is on screen: with it closed the panels
-- are still grabbable, but the grip is a hint for when the menu is up, not
-- another thing floating over the game
local function hud_grip(x,y,ap)
  if ui.appear<=0.9 then return end
  for r=0,1 do for c=0,1 do
    draw.RectFilled(x+c*4, y+r*4, 1.6,1.6, a(theme.faint,0.9*ap), 0)
  end end
end
-- Scratch state for the HUD pass. Reused instead of rebuilt every frame: the
-- feature bar used to allocate two tables and a closure per frame, the keybind
-- list five tables, and the watermark formatted its two readouts every frame for
-- values that only change once a second (or once per integer FPS step).
local HUD_S={feats={},w={},keys={},upv=-1,ups="",fpsv=-1,fpss=""}
-- appends one row to a reused list; the helper lives outside the builder so the
-- builder no longer allocates a closure per frame
local function hud_krow(rows,n,lb,v)
  n=n+1
  local r=rows[n]
  if not r then r={}; rows[n]=r end
  r[1]=lb; r[2]=vkname(v)
  return n
end
-- rows for the keybind list. a row only exists while its parent feature is on
-- and the bind is actually assigned, so the list stays honest to the menu. The
-- row tables are reused: the list is at most four rows and its contents change
-- only when a bind or a master toggle changes.
local function hud_key_rows()
  local rows=HUD_S.keys
  local n=0
  local v
  if cfg.aim_on then
    v=bind.aim_key or 0; if v~=0 then n=hud_krow(rows,n,"Aimbot",v) end
    v=bind.aim_toggle or 0; if v~=0 then n=hud_krow(rows,n,"Aim Toggle",v) end
  end
  v=bind.esp_toggle or 0
  if cfg.esp_on and v~=0 then n=hud_krow(rows,n,"ESP Toggle",v) end
  v=bind.menu_key or 0
  if v~=0 then n=hud_krow(rows,n,"Menu",v) end
  for i=#rows,n+1,-1 do rows[i]=nil end
  return rows
end
local function run_hud()
  local sw,sh=scr()
  -- one fade curve per panel, so the three do not snap in as a single block
  local apm=approach("hud_mark", cfg.hud_mark and 1 or 0, 17)
  local apk=approach("hud_keys", cfg.hud_keys and 1 or 0, 15)
  local apb=approach("hud_bar",  cfg.hud_bar  and 1 or 0, 16)

  -- ------------------------------------------------------------- watermark
  if apm>0.01 then
    local fps=math.floor((utility.GetFPS and utility.GetFPS()) or 0)
    if not fps or fps<=0 then fps=math.floor(1/(_dt>0 and _dt or 0.016)) end
    local up=math.floor(now()-hud_start)
    local ut
    if up~=HUD_S.upv then
      HUD_S.upv=up
      ut = up<60 and string.format("%ds",up)
        or (up<3600 and string.format("%dm",math.floor(up/60)))
        or string.format("%dh%02dm",math.floor(up/3600),math.floor((up%3600)/60))
      HUD_S.ups=ut
    else
      ut=HUD_S.ups
    end
    local ft
    if fps~=HUD_S.fpsv then
      HUD_S.fpsv=fps
      ft=string.format("%d FPS",fps)
      HUD_S.fpss=ft
    else
      ft=HUD_S.fpss
    end
    local lw=ts("Ego",14); local pw2=ts("Fust Survival",11)
    local fw=ts(ft,11); local uw=ts(ut,11)
    local ph=30
    local wpx=14+lw+5+8+6+pw2+10+1+10+fw+10+uw+14
    local wx=(cfg.hud_mark_x or -1)>=0 and cfg.hud_mark_x or (sw-wpx-16)
    local wy=(cfg.hud_mark_y or -1)>=0 and cfg.hud_mark_y or 14
    wx=clamp(wx,0,math.max(0,sw-wpx)); wy=clamp(wy,0,math.max(0,sh-ph))
    -- Drag from anywhere on the panel, menu open or closed. The press edge is
    -- what matters: the panel claims it here and update_input applies the drag
    -- for as long as the button is held, so this behaves exactly like the menu
    -- window. The old ui.appear gate meant the panels could only be moved while
    -- the menu happened to be up, which is not how the window itself works.
    if inside(wx,wy,wpx,ph) and ui.m.click and not ui.drag and not ui.picker then
      ui.drag={k="hud_mark",ox=ui.m.x-wx,oy=ui.m.y-wy}; ui.m.click=false
    end
    hud_panel(wx,wy,wpx,ph,apm,3)
    hud_grip(wx+wpx-14,wy+2,apm)
    -- wordmark, accent diamond and product line: the top bar lockup, compact
    tmid(wx+14,wy,ph,"Ego", a(theme.text,1), 14)
    local dcx,dcy=wx+14+lw+5+4, wy+ph*0.5
    if draw.PolyFilled then pcall(draw.PolyFilled, {{dcx,dcy-4},{dcx+4,dcy},{dcx,dcy+4},{dcx-4,dcy}}, a(theme.accent,1))
    else draw.RectFilled(dcx-3,dcy-3,6,6, a(theme.accent,1), 1) end
    local px=dcx+4+6
    tmid(px,wy,ph,"Fust Survival", a(theme.sub,1), 11)
    -- hairline divider, then the live counters
    local gx=px+pw2+10
    draw.Line(gx,wy+8,gx,wy+ph-8, a(theme.line,0.6*apm), 1)
    local tx=gx+11
    local fc = fps>=100 and theme.ok or (fps>=45 and theme.text or theme.bad)
    tmid(tx,wy,ph,ft, a(fc,1), 11)
    tmid(tx+fw+10,wy,ph,ut, a(theme.faint,1), 11)
  end

  -- ---------------------------------------------------------- keybind list
  if apk>0.01 then
    local rows=hud_key_rows()
    if #rows>0 then
      local rh=21; local pw=178; local ph=40+#rows*rh
      local kx=(cfg.hud_keys_x or -1)>=0 and cfg.hud_keys_x or (sw-pw-16)
      -- bottom-right by default: the watermark owns the top-right corner and
      -- the radar anchors there too, so the list would sit on top of both
      local ky=(cfg.hud_keys_y or -1)>=0 and cfg.hud_keys_y or (sh-ph-18)
      kx=clamp(kx,0,math.max(0,sw-pw)); ky=clamp(ky,0,math.max(0,sh-ph))
      -- same grab rule as the watermark: any press on the panel drags it
      if inside(kx,ky,pw,ph) and ui.m.click and not ui.drag and not ui.picker then
        ui.drag={k="hud_keys",ox=ui.m.x-kx,oy=ui.m.y-ky}; ui.m.click=false
      end
      hud_panel(kx,ky,pw,ph,apk,4)
      hud_head(kx+13,ky+11,pw-26-(ui.appear>0.9 and 13 or 0),"01","Keybinds")
      hud_grip(kx+pw-16,ky+14,apk)
      for i,r in ipairs(rows) do
        local ry=ky+32+(i-1)*rh
        if i%2==0 then draw.RectFilled(kx+9,ry,pw-18,rh, {1,1,1,0.022*apk}, 0) end
        tmid(kx+14,ry,rh,r[1], a(theme.sub,1), 11)
        -- the key sits in a field so it reads as a chip instead of loose text
        local kw=ts(r[2],10); local cw=kw+13; local ch=15
        local cx=kx+pw-13-cw; local cy=ry+(rh-ch)*0.5
        draw.RectFilled(cx,cy,cw,ch, a(theme.field,1), 2)
        draw.Rect(cx,cy,cw,ch, a(theme.line,1), 2, 1)
        tmid(cx,cy,ch,r[2], a(theme.text,1), 10)
      end
    end
  end

  -- ----------------------------------------------------------- feature bar
  if apb>0.01 then
    local feats=HUD_S.feats
    for i=#feats,1,-1 do feats[i]=nil end
    if cfg.aim_on then feats[#feats+1]="AIM" end
    if cfg.esp_on then feats[#feats+1]="ESP" end
    if cfg.rad_on then feats[#feats+1]="RADAR" end
    if cfg.xh_on then feats[#feats+1]="CROSSHAIR" end
    if cfg.loot_on or cfg.base_on or cfg.bags_on or cfg.drop_on
      or cfg.nodes_on or cfg.pick_on or cfg.plants_on then
      feats[#feats+1]="WORLD"
    end
    if #feats>0 then
      local gap=7; local pad=16; local ph=34
      local widths=HUD_S.w; local tot=pad*2+(#feats-1)*gap
      for i,lb in ipairs(feats) do
        local cw=math.max(48, ts(lb,10)+20); widths[i]=cw; tot=tot+cw
      end
      local bx=(cfg.hud_bar_x or -1)>=0 and cfg.hud_bar_x or (sw*0.5-tot*0.5)
      local by=(cfg.hud_bar_y or -1)>=0 and cfg.hud_bar_y or (sh-ph-18)
      bx=clamp(bx,0,math.max(0,sw-tot)); by=clamp(by,0,math.max(0,sh-ph))
      -- and the feature bar follows the same rule
      if inside(bx,by,tot,ph) and ui.m.click and not ui.drag and not ui.picker then
        ui.drag={k="hud_bar",ox=ui.m.x-bx,oy=ui.m.y-by}; ui.m.click=false
      end
      hud_panel(bx,by,tot,ph,apb,4)
      hud_grip(bx+tot-14,by+2,apb)
      local e=mix(theme.accent,theme.accent2,0.5)
      draw.RectFilled(bx+pad-2,by+ph-2,tot-(pad-2)*2,2, {e[1],e[2],e[3],0.9*apb}, 1)
      local px=bx+pad
      for i,lb in ipairs(feats) do
        local cw=widths[i]; local cx=px+cw*0.5
        draw.CircleFilled(cx,by+11,2.4, a(e,0.95*apb), 12)
        local tw=ts(lb,10)
        draw.Text(cx-tw*0.5,by+17,lb, a(theme.text,0.95*apb), 10)
        if i<#feats then
          local sx=px+cw+gap*0.5
          draw.Line(sx,by+9,sx,by+ph-10, a(theme.line,0.5*apb), 1)
        end
        px=px+cw+gap
      end
    end
  end

  -- Deferred whole-window grab queued by draw_menu. The three panels above draw
  -- on top of the window and claim the press first (each clears ui.m.click when
  -- it takes it), so this only fires when the click landed on the menu itself.
  -- Without the deferral the window grab ran first and swallowed every press
  -- that happened to overlap a panel.
  local g=ui.win_grab
  ui.win_grab=nil
  if g and ui.m.click and not ui.drag and not ui.picker then
    ui.drag={k="win",ox=g.ox,oy=g.oy}; ui.m.click=false
  end
end

-- =========================================================================
-- CROSSHAIR: custom crosshair.
-- Every control in the Crosshair tab feeds this: style, size, gap, thickness,
-- the centre dot, spin (angle is integrated from the frame delta, so the speed
-- slider means the same at 60 or 240 fps) and the colour swatch.
-- =========================================================================
local xh_ang=0
-- Rotation scratch. The crosshair used to build a closure (plus an upvalue cell
-- per captured local) on every frame just to rotate a handful of points. The
-- centre and the sin/cos pair live in this table instead, and the one function
-- below reads them, so the call sites are unchanged.
local XH_R={cx=0,cy=0,co=1,si=0}
local function xh_rot(x,y)
  local c=XH_R
  local dx,dy=x-c.cx,y-c.cy
  return c.cx+dx*c.co-dy*c.si, c.cy+dx*c.si+dy*c.co
end
-- closed outline: PolyClosed when the draw table has it, hairline segments
-- otherwise, so the Star of David never disappears on a stripped build
local function xh_poly(pts,c,th)
  if draw.PolyClosed then pcall(draw.PolyClosed, pts, c, th); return end
  for i=1,#pts do
    local p=pts[i]; local q=pts[i%#pts+1]
    draw.Line(p[1],p[2],q[1],q[2],c,th)
  end
end
local function run_crosshair()
  if not cfg.xh_on then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  local s=cfg.xh_size; local gp=cfg.xh_gap; local th=cfg.xh_thick
  local c=a(col.c_xh,1); local st=cfg.xh_style
  if cfg.xh_spin then
    xh_ang=(xh_ang+(cfg.xh_speed or 0)*math.pi/180*_dt)%(math.pi*2)
  end
  local ang=cfg.xh_spin and xh_ang or 0
  XH_R.cx,XH_R.cy=cx,cy
  XH_R.co,XH_R.si=math.cos(ang),math.sin(ang)
  local R=xh_rot
  if st==1 then
    -- four arms, each starting gp px out from the centre and running s px long
    local x1,y1=R(cx-gp-s,cy); local x2,y2=R(cx-gp,cy)
    local x3,y3=R(cx+gp,cy);   local x4,y4=R(cx+gp+s,cy)
    local x5,y5=R(cx,cy-gp-s); local x6,y6=R(cx,cy-gp)
    local x7,y7=R(cx,cy+gp);   local x8,y8=R(cx,cy+gp+s)
    draw.Line(x1,y1,x2,y2,c,th); draw.Line(x3,y3,x4,y4,c,th)
    draw.Line(x5,y5,x6,y6,c,th); draw.Line(x7,y7,x8,y8,c,th)
  elseif st==2 then
    -- Dot is the one style where Size is a radius rather than an arm length,
    -- so it has to feed the pip directly; thickness only biases the floor.
    local r=math.max(0.9, s*0.32+th*0.5)
    draw.CircleFilled(cx,cy,r,c,math.max(8,math.floor(r*3)))
  elseif st==3 then
    draw.Circle(cx,cy,s,c,24,th)
  elseif st==4 then
    local x1,y1=R(cx-gp-s,cy); local x2,y2=R(cx-gp,cy)
    local x3,y3=R(cx+gp,cy);   local x4,y4=R(cx+gp+s,cy)
    local x5,y5=R(cx,cy+gp);   local x6,y6=R(cx,cy+gp+s)
    draw.Line(x1,y1,x2,y2,c,th); draw.Line(x3,y3,x4,y4,c,th)
    draw.Line(x5,y5,x6,y6,c,th)
  elseif st==5 then
    -- two equilateral triangles sharing one circumcircle; gap pushes the whole
    -- star out from the centre, size sets its radius
    local r=gp+s
    local h=r*math.sqrt(3)*0.5
    local ux,uy=R(cx,cy-r)
    local lx,ly=R(cx-h,cy+r*0.5); local rx2,ry2=R(cx+h,cy+r*0.5)
    local dx,dy=R(cx,cy+r)
    local l2x,l2y=R(cx-h,cy-r*0.5); local r2x,r2y=R(cx+h,cy-r*0.5)
    xh_poly({{ux,uy},{lx,ly},{rx2,ry2}}, c, th)
    xh_poly({{dx,dy},{l2x,l2y},{r2x,r2y}}, c, th)
  end
  -- centre pip: thickness sets the base, size nudges it so the slider still
  -- reads even when only the dot is on
  if cfg.xh_dot and st~=2 then draw.CircleFilled(cx,cy,math.max(0.9, th+s*0.07),c,10) end
end

