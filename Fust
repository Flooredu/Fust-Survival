-- container. A prompt that only says one of these is ignored, so the part
-- fingerprint answers instead of printing "Loot" over every sack.
local W_PROMPT_BAD={ loot=true, bag=true, sack=true, backpack=true,
  corpse=true, body=true, item=true, items=true, container=true,
  ["loot bag"]=true, ["loot sack"]=true, ["body bag"]=true,
  ["death bag"]=true, ["dropped item"]=true, ["dropped items"]=true,
