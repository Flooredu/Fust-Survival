local function update_input()
  ui.m.x,ui.m.y=mouse_pos()
  local d=ekey(0x01); ui.m.click=d and not ui.m.was; ui.m.down=d; ui.m.was=d
  if not d and ui.drag and ui.drag.k~="slider" then ui.drag=nil end
  if ui.drag and ui.drag.k=="win" then local sw,sh=scr(); ui.x=clamp(ui.m.x-ui.drag.ox,0,sw-ui.w); ui.y=clamp(ui.m.y-ui.drag.oy,0,sh-ui.h) end
  if ui.drag and (ui.drag.k=="hud_mark" or ui.drag.k=="hud_keys" or ui.drag.k=="hud_bar") then
    local sw,sh=scr()
    local key=ui.drag.k=="hud_mark" and "mark" or (ui.drag.k=="hud_keys" and "keys" or "bar")
    -- straight into the profile keys: the panels come back where they were left
    -- after a reload, and the debounced autosave persists the drag
    cfg["hud_"..key.."_x"]=clamp(ui.m.x-ui.drag.ox,0,sw-24)
    cfg["hud_"..key.."_y"]=clamp(ui.m.y-ui.drag.oy,0,sh-14)
    cfg_dirty=true
  end
  local mk=bind.menu_key or 0xA1; local held=ekey(mk)
  if held and not ui.menu_edge then ui.open=not ui.open; ui.picker=nil; ui.capture=nil end
  ui.menu_edge=held
  -- ESP enable hotkey, edge triggered like the menu key so holding the bind
  -- flips once instead of every frame. skipped while a bind is being captured,
  -- because the capture loop reads every key and would bind and toggle at once.
  local ek=bind.esp_toggle or 0
  local eh=(ek~=0) and ekey(ek) or false
  if eh and not ui.esp_edge and not ui.capture then cfg.esp_on=not cfg.esp_on; cfg_dirty=true end
  ui.esp_edge=eh
  -- same edge rule for the aimbot master, so the toggle key and the menu switch
  -- can never fight each other while one is held
  local ak=bind.aim_toggle or 0
  local ah=(ak~=0) and ekey(ak) or false
  if ah and not ui.aim_edge and not ui.capture then cfg.aim_on=not cfg.aim_on; cfg_dirty=true end
  ui.aim_edge=ah
  if ui.capture then
    if not ui.capture_ok then if not ekey(0x01) then ui.capture_ok=true end return end
    if ekey(0x1B) then bind[ui.capture]=0; cfg_dirty=true; ui.capture=nil; return end
    for vk=0x01,0xFE do if vk~=0x1B and ekey(vk) then bind[ui.capture]=vk; cfg_dirty=true; ui.capture=nil; return end end
  end
end

-- =========================================================================
-- CONFIG
-- Vector ships the io standard library, so the profile is written to disk with
-- io.open/io.write. A copy is kept in getgenv as a fallback for sandboxes where
-- file io is blocked. HttpService JSON is used when it is reachable, otherwise
-- a plain key=value text format. Everything lives on CFG so the engine costs a
-- single main-local; the schema buttons close over the table, not the functions.
-- =========================================================================
CFG.env=function()
  local g=getgenv and getgenv() or _G
  if type(g)~="table" then return nil end
  if type(g.EGOFUST_CFGS)~="table" then g.EGOFUST_CFGS={} end
  return g
end
CFG.http=function()
  -- standard Roblox wants the colon form; some executors expose a plain
  -- game.GetService function instead, so try both before giving up on json
  local ok,hs=pcall(function() return game:GetService("HttpService") end)
  if ok and hs then return hs end
  ok,hs=pcall(function() return game.GetService("HttpService") end)
  if ok and hs then return hs end
  return nil
end
CFG.last=0
-- Gun Mods are session-only. They must never be written to a profile or
-- restored from one: the patches are global, irreversible without a rejoin, and
-- a saved "on" would silently re-arm them at startup. Every gun_sgc* key is
-- skipped on both save and load, so the section always starts off until the
-- user flips it in this session.
CFG.save=function(slot,quiet)
  slot=tonumber(slot) or tonumber(cfg.cfg_slot) or 1
  local data=nil
  local hs=CFG.http()
  if hs then
    local t={v={},b={},c={}}
    for k,v in pairs(cfg) do if k~="cfg_slot" and k:sub(1,7)~="gun_sgc" then t.v[k]=v end end
    for k,v in pairs(bind) do t.b[k]=v end
    for k,cv in pairs(col) do t.c[k]={cv[1] or 0,cv[2] or 0,cv[3] or 0,cv[4] or 1} end
    local ok,s=pcall(function() return hs:JSONEncode(t) end)
    if ok and type(s)=="string" and #s>0 then data=s end
  end
  if not data then
    local o={"#egofust-config-v1"}
    for k,v in pairs(cfg) do
      if k~="cfg_slot" and k:sub(1,7)~="gun_sgc" then o[#o+1]="v "..k.."="..(type(v)=="boolean" and (v and "1" or "0") or tostring(v)) end
    end
    for k,v in pairs(bind) do o[#o+1]="b "..k.."="..tostring(v) end
    for k,cv in pairs(col) do o[#o+1]="c "..k.."="..(cv[1] or 0)..","..(cv[2] or 0)..","..(cv[3] or 0)..","..(cv[4] or 1) end
    data=table.concat(o,"\n")
  end
  local g=CFG.env()
  if g then g.EGOFUST_CFGS[slot]=data; g.EGOFUST_SLOT=slot end
  local disk=false
  local ok,f=pcall(function() return io.open("egofust_config_"..slot..".cfg","w") end)
  if ok and f then
    local wok=pcall(function() f:write(data) end)
    pcall(function() f:close() end)
    disk=wok
  end
  cfg_dirty=false
  CFG.last=now()
  if not quiet then
    if disk then pcall(function() notify.Success("Config saved","slot "..slot.." - egofust_config_"..slot..".cfg",3) end)
    else pcall(function() notify.Warning("Config saved to session","io.open is blocked, no file written",4) end) end
  end
  return disk
end
CFG.load=function(slot,quiet)
  slot=tonumber(slot) or tonumber(cfg.cfg_slot) or 1
  local g=CFG.env()
  local data=nil
  local ok,f=pcall(function() return io.open("egofust_config_"..slot..".cfg","r") end)
  if ok and f then
    local rok,s=pcall(function() return f:read("*a") end)
    pcall(function() f:close() end)
    if rok and type(s)=="string" and #s>0 then data=s end
  end
  if not data and g and type(g.EGOFUST_CFGS)=="table" then data=g.EGOFUST_CFGS[slot] end
  if not data then
    if not quiet then pcall(function() notify.Warning("Nothing to load","slot "..slot.." is empty",3) end) end
    return false
  end
  local applied=false
  if data:sub(1,1)=="{" then
    local hs=CFG.http()
    if hs then
      local jok,t=pcall(function() return hs:JSONDecode(data) end)
      if jok and type(t)=="table" then
        for k,v in pairs(t.v or {}) do
          if cfg[k]~=nil and k:sub(1,7)~="gun_sgc" then
            if type(v)=="boolean" then cfg[k]=v
            else local x=tonumber(v); if x then cfg[k]=x end end
          end
        end
        for k,v in pairs(t.b or {}) do
          if bind[k]~=nil then local x=tonumber(v); if x then bind[k]=x end end
        end
        for k,v in pairs(t.c or {}) do
          if col[k]~=nil and type(v)=="table" then
            local r1,g1,b1=tonumber(v[1]),tonumber(v[2]),tonumber(v[3])
            if r1 and g1 and b1 then col[k]={r1,g1,b1,tonumber(v[4]) or 1} end
          end
        end
        applied=true
      end
    end
  else
    for line in data:gmatch("[^\n]+") do
      local kind,k,val=line:match("^(%a) ([^=]+)=(.*)$")
      if kind then
        if kind=="v" and cfg[k]~=nil and k:sub(1,7)~="gun_sgc" then
          if type(cfg[k])=="boolean" then cfg[k]=(val=="1" or val=="true")
          else local x=tonumber(val); if x then cfg[k]=x end end
        elseif kind=="b" and bind[k]~=nil then
          local x=tonumber(val); if x then bind[k]=x end
        elseif kind=="c" and col[k]~=nil then
          local r,g1,b1,a1=val:match("([%d%.%-]+),([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)")
          if r then col[k]={tonumber(r),tonumber(g1),tonumber(b1),tonumber(a1) or 1} end
        end
      end
    end
    applied=true
  end
  -- Range rows whose maximum is a game-metre cap. A slot saved before the unit
  -- change (or before a cap was lowered) can hold a bigger real-metre value,
  -- which the menu would print past the row's maximum, so pull those back to the
  -- cap on load instead of letting an old profile exceed it.
  if cfg.aim_range and cfg.aim_range>1500*M_PER_STUD then cfg.aim_range=1500*M_PER_STUD end
  if cfg.esp_maxdist and cfg.esp_maxdist>1500*M_PER_STUD then cfg.esp_maxdist=1500*M_PER_STUD end
  if cfg.npcs_max_dist and cfg.npcs_max_dist>300*M_PER_STUD then cfg.npcs_max_dist=300*M_PER_STUD end
  if cfg.rad_range and cfg.rad_range>500*M_PER_STUD then cfg.rad_range=500*M_PER_STUD end
  if cfg.plants_range and cfg.plants_range>200*M_PER_STUD then cfg.plants_range=200*M_PER_STUD end
  if cfg.pick_range and cfg.pick_range>150*M_PER_STUD then cfg.pick_range=150*M_PER_STUD end
  if cfg.veh_range and cfg.veh_range>1000*M_PER_STUD then cfg.veh_range=1000*M_PER_STUD end
  if cfg.nodes_range and cfg.nodes_range>500*M_PER_STUD then cfg.nodes_range=500*M_PER_STUD end
  if cfg.bd_range and cfg.bd_range>400*M_PER_STUD then cfg.bd_range=400*M_PER_STUD end
  if cfg.loot_range and cfg.loot_range>400*M_PER_STUD then cfg.loot_range=400*M_PER_STUD end
  if cfg.base_range and cfg.base_range>175*M_PER_STUD then cfg.base_range=175*M_PER_STUD end
  if g then g.EGOFUST_SLOT=slot end
  cfg_dirty=false
  if not quiet then
    if applied then pcall(function() notify.Success("Config loaded","slot "..slot,3) end)
    else pcall(function() notify.Error("Config is corrupted","slot "..slot.." could not be parsed",3) end) end
  end
  return applied
end
CFG.reset=function()
  -- re-apply the schema defaults, same loop the menu uses to seed the values
  for _,tab in ipairs(SCHEMA) do for _,g in ipairs(tab.groups) do for _,it in ipairs(g.items) do
    if it.t=="toggle" then cfg[it.id]=it.default or false
    elseif it.t=="slider" then cfg[it.id]=it.default or it.min
    elseif it.t=="combo" then cfg[it.id]=it.default or 1
    elseif it.t=="bind" then bind[it.id]=it.default or 0
    elseif it.t=="color" then
      local dc=DEF_COL[it.id] or it.default
      if dc and type(dc)=="table" then col[it.id]={dc[1] or 1,dc[2] or 1,dc[3] or 1,dc[4] or 1}
      else col[it.id]={1,1,1,1} end
    end
    -- toggles with an inline swatch (NPC / World categories) reset too
    if it.color then
      local d=DEF_COL[it.color]
      if d then col[it.color]={d[1],d[2],d[3],d[4]} end
    end
  end end end
  -- HUD panels go back to their anchored corners on a reset as well
  cfg.hud_mark_x,cfg.hud_mark_y=-1,-1
  cfg.hud_keys_x,cfg.hud_keys_y=-1,-1
  cfg.hud_bar_x,cfg.hud_bar_y=-1,-1
  cfg_dirty=true
  pcall(function() notify.Success("Defaults restored","",3) end)
end

-- restore the last profile on start so the menu comes up the way it was left
cfg.cfg_slot=tonumber(CFG.env().EGOFUST_SLOT) or tonumber(cfg.cfg_slot) or 1
CFG.load(cfg.cfg_slot,true)

-- =========================================================================
-- FRAME LOOP
-- UI only: the window, the tab rail and the controls. No gameplay runs here.
-- =========================================================================

function OnFrame()
  _dt=utility.GetDeltaTime and utility.GetDeltaTime() or 0.016
  if not _dt or _dt<=0 or _dt>0.2 then _dt=0.016 end
  FRAME=FRAME+1
  -- colour memo is per-frame: keeps picker changes live while letting every
  -- target share one table per swatch instead of allocating one each
  COL_MEM={}
  if cfg.accent_chroma then
    local h=now()*0.15
    theme.accent=hsv(h,0.7,1)
    theme.accent2=hsv(h+0.11,0.7,1)
  else
    theme.accent=col.c_accent or theme.accent
    theme.accent2=theme.accent2_base
  end
  update_input()
  ui.appear=approach("appear", ui.open and 1 or 0, 14)
  pcall(run_aim)
  pcall(run_trigger)
  pcall(run_gunmods)
  pcall(scan_npcs_task)
  -- ESP sits under the menu so the window always stays readable; the menu, HUD
  -- and crosshair draw afterwards.
  -- chams sit under everything else: bodies first, then boxes/bones on top
  pcall(run_chams)
  pcall(run_esp)
  if cfg.npc_esp_enabled then pcall(run_npc_esp_h) end
  pcall(run_radar)
  pcall(run_world)
  pcall(draw_aim)
  if ui.appear>0.01 then pcall(draw_menu) end
  theme.opacity=1
  -- HUD sits outside the menu fade: the overlays are toggled on their own and
  -- stay up with the window closed, which is the point of a HUD.
  pcall(run_hud)
  pcall(run_crosshair)
  -- debounced autosave: any widget that touches a setting flags the profile
  -- dirty and it is written out at most once a second.
  if cfg_dirty and cfg.cfg_auto then
    local t=now()
    if t-CFG.last>=1 then CFG.save(cfg.cfg_slot,true) end
  end
end

pcall(function() notify.Success("Fust Survival v1.2 loaded","Right Shift to toggle menu",5) end)
