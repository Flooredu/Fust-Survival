-- Wall Check line of sight for the aimbot.
--
-- The old test was one raycast.IsVisible from the camera to the bone, and it
-- lied both ways. The ray ended exactly on the bone, so the last thing it
-- touched was the target's own body - a "blocked" answer on a shot that was
-- wide open. And it started at the camera, which in third person sits behind
-- the character and can be buried in a wall or inside the player's own head,
-- which reads as blocked from the very first stud. That is the half of the time
-- the Wall Check refused a target standing in the open.
--
-- This walks the same line with raycast.Cast, which reports the instance it hit
-- instead of a bare boolean, so only world geometry counts as a wall: anything
-- belonging to the target (body, hat, held tool) or to the local player is
-- stepped over. The cast stops a fraction of a stud short of the bone, so the
-- target's own surface cannot register at the far end, and a first hit within a
-- stud of the eye means the camera is inside geometry, so that is stepped over
-- too. Four steps covers own body -> target body -> wall. Any raycast error
-- fails open: the check must never cost a shot it cannot justify.
local function los_clear(ox,oy,oz,tx,ty,tz,char)
  local dx,dy,dz=tx-ox,ty-oy,tz-oz
  local d2=dx*dx+dy*dy+dz*dz
  if d2<1e-6 then return true end
  local d=math.sqrt(d2)
  local ux,uy,uz=dx/d,dy/d,dz/d
  -- stop short of the bone: the aim point sits inside the target's own part, so
  -- a full-length ray always ends on the body it is aiming at
  local len=d-0.4
  if len<0.2 then return true end
  local ex,ey,ez=ox+ux*len,oy+uy*len,oz+uz*len
  local cast=raycast and raycast.Cast
  local vnew=Vector3 and Vector3.New
  -- Cast is documented for Vector3 arguments only, so the points are wrapped;
  -- if either half is missing on this build, fall back to the boolean test that
  -- does take six numbers
  if type(cast)~="function" or type(vnew)~="function" then
    local ok,v=pcall(raycast.IsVisible,ox,oy,oz,ex,ey,ez)
    return (not ok) or v~=false
  end
  -- the local character is resolved once a frame, not once per candidate
  if PF.lfr~=FRAME then
    PF.lfr=FRAME
    local lch=nil
    local lp=PF.getview().lp
    if lp then
      local okc,c=pcall(PF.char,lp)
      if okc then lch=c end
    end
    PF.lch=lch
  end
  local lch=PF.lch
  local px,py,pz=ox,oy,oz
  local t=0
  -- the far end never moves, so only the start point is rebuilt per step
  local vEnd=vnew(ex,ey,ez)
  for step=1,4 do
    local ok,hit,pos,dist,inst=pcall(cast,vnew(px,py,pz),vEnd)
    if not ok or not hit or not inst then return true end
    local own=false
    if inst==char then
      own=true
    elseif char then
      local okd,isd=pcall(PF.isd,inst,char)
      if okd and isd then own=true end
    end
    if not own and lch then
      if inst==lch then
        own=true
      else
        local okd,isd=pcall(PF.isd,inst,lch)
        if okd and isd then own=true end
      end
    end
    local nd=tonumber(dist) or 0
    if nd<0 then nd=0 end
    -- a hit this close to the eye is the camera clipping into geometry, not a
    -- wall in front of the player: step out of it and keep looking
    if not own and not (step==1 and nd<=0.6) then return false end
    -- a zero-distance hit means the ray started inside that part (the eye is in
    -- the local head), so dist cannot carry us past it: hop clear of the body
    local adv=nd+0.05
    if own and nd<0.5 then adv=1.1 end
    t=t+adv
    if t>=len-0.05 then return true end
    px,py,pz=ox+ux*t,oy+uy*t,oz+uz*t
  end
  return true
end

-- Scoring state for one aim pass, plus the scorer itself. Keeping this in a
-- real function with a state table means no closure is allocated per player or
-- per NPC per frame, and each bone only reads the property the chosen priority
-- actually needs.
local AIM_ST={cx=0,cy=0,r=0,fstyle=1,style=1,maxdist=0,
  camx=nil,camy=nil,camz=nil,best=nil,best_s=nil}
local function aim_try(hx,hy,hz,part,obj,name,health,char)
  local camx,camy,camz=AIM_ST.camx,AIM_ST.camy,AIM_ST.camz
  local pd3
  if camx then
    local dx3=hx-camx
    local dy3=hy-camy
    local dz3=hz-camz
    pd3=math.sqrt(dx3*dx3+dy3*dy3+dz3*dz3)
    if AIM_ST.maxdist and pd3>AIM_ST.maxdist then return end
  end
  local sx,sy,vis=draw.WorldToScreen(hx,hy,hz)
  if not vis then return end
  local dx,dy=sx-AIM_ST.cx,sy-AIM_ST.cy
  if not aim_in_fov(dx,dy,AIM_ST.r,AIM_ST.fstyle) then return end
  if cfg.aim_wall and camx then
    if not los_clear(camx,camy,camz,hx,hy,hz,char) then return end
  end
  local sd=dx*dx+dy*dy
  local score=sd
  if AIM_ST.style==2 then
    -- camera distance when we have it, otherwise the entity's own DistanceTo
    if pd3 then score=pd3
    else
      local okd,dv=pcall(PF.dist,obj)
      score=(okd and dv) or 0
    end
  elseif AIM_ST.style==3 then
    score=health or 100
  end
  if not AIM_ST.best_s or score<AIM_ST.best_s then
    AIM_ST.best_s=score
    AIM_ST.best={x=hx,y=hy,z=hz,sx=sx,sy=sy,name=name,obj=obj,part=part,char=char}
  end
end

-- frame counter fallback: if the runtime exposes no usable clock at all the
-- sweep still has to run, so a synthetic clock is derived from this counter.
local npc_scan_frames=0

local function is_melee_or_utility_tool(name)
  if not name or name=="" then return false end
  local c=tostring(name):lower()
  if c:find("rock") or c:find("pick") or c:find("axe") or c:find("hatchet")
    or c:find("torch") or c:find("hammer") or c:find("plan")
    or c:find("bandage") or c:find("syringe") or c:find("pumpkin")
    or c:find("corn") or c:find("meat") or c:find("machete")
    or c:find("knife") or c:find("bone") or c:find("spear") then
    return true
  end
  return false
end

-- ==========================================================================
-- Gun mods (GC memory patches)
--
-- The game's GC exposes setgc(key, value), which rewrites that key in every
-- table that owns it - but it filters by key NAME, not by reachability. The
-- 32-key probe in the GC dump is unambiguous:
--
--   writes : rate  spread  sway  kickRoll  adsKick  bloom  shakeDur  climb
--   refuses: kickPitch  kickBack  pitch  yaw  rise  recover  kick  shake
--            shakeStrength  spreadMult  adsTime  s2Damage  rounds  adsSpread
--            moveSpread  damageMult  mag  reload  recoilRecover  recoilPitch
--            recoilYaw  notch  sightHeight
--
-- kickRoll (19 tables) writes while kickPitch and kickBack (18 tables) do not,
-- and they sit in the SAME per-weapon table - so this really is a name filter,
-- not a frozen table. "climb" is the odd one out: the only table owning it is
-- the humanoid animation state map, so it is a false positive and is unused.
--
-- What the toggle therefore actually does:
--   spread / adsSpread / moveSpread          the bullet cone itself: the shot
--                                            direction is spreadDir(LookVector,
--                                            shotSpread(def)), so all three
--                                            have to be 0 or the cone survives
--   MOVE_SPREAD / ADS_SPREAD / AIR_SPREAD    their fallbacks in the tuning table
--   sway / SWAY / SWAY_MAX / SWAY_ROT / SWAY_ROT_MAX   weapon drift
--   kickRoll / adsKick       the viewmodel's sideways kick
--   kickPitch / kickBack     the gun model's up/back jolt (refused by setgc)
--   KICK_PITCH / KICK_BACK   the per-weapon fallbacks for the same two
--   INPUT (Mouse/Touch/Gamepad)   GunControl's recoil multiplier - this is the
--                            one that makes the camera climb after each shot
--   VISUAL_BLOOM             the extra spread ring drawn while moving
--   shakeDur / SHAKE_MAX     camera shake duration and impact amplitude
--
-- "bloom" is deliberately not in the set: 93 tables own a field by that name
-- and they are the lighting / ColorCorrection ones, not the gun.
--
-- Everything is written through the GC node addresses instead of setgc. That
-- is not just to reach the refused names: one getgc scan plus one node walk is
-- a single frozen second, where the old warm-getgc + setgc + memory-getgc trio
-- was two or three. The layout was measured against 22/22 known fields:
--   Table +24 node pointer, +1 log2(node count)
--   Node  32 bytes: +0 double value, +16 key TString pointer
-- A node is only written when its key string reads back as the exact name AND
-- its stored double equals the value getgc reported, so a different layout
-- skips the write instead of corrupting the table. The dump's own run wrote
-- 69 values with 0 skipped, so this is the proven path, not a guess.
--
-- Patching is GLOBAL, not per weapon: rate = 0.09 turns the 1.8 s LR Sniper
-- into a 20x-fire-rate rifle, the most detectable case there is. The slider is
-- therefore capped to 80-190 ms (12.5 down to ~5.3 shots/s); 20 ms is what got
-- the account kicked for firerate.
--
-- The rate node addresses are cached after the scan, so moving the Fire
-- Interval slider is a handful of memory.Write calls instead of another whole
-- VM walk. The scan itself runs once per toggle that is switched on; the
-- Re-apply button forces one more.
--
-- Turning the master toggle off cannot restore stock values: there is no
-- read-back and the stock rate differs per weapon. Re-equip or rejoin.
PF.sgc={force=0,mem={},memory=nil,memdone=false,done=false,hold=0,
  last_rate=false,last_clean=false,
  rate_addrs=nil,rate_keys=nil,rate_ms=nil,rate_val=nil}

-- Names the clean toggle zeroes, as a lookup for the node walk. SGC_KEYS is the
-- getgc query list and must contain every name here, plus "rate": getgc only
-- returns a table if it owns one of the queried names, so a missing entry means
-- that table is never walked. "rate" is not in SGC_Z because it is written to
-- ms/1000 rather than zeroed.
local SGC_Z={spread=0,adsSpread=0,moveSpread=0,sway=0,kickRoll=0,adsKick=0,
  shakeDur=0,kickPitch=0,kickBack=0,KICK_PITCH=0,KICK_BACK=0,SHAKE_MAX=0,
  MOVE_SPREAD=0,ADS_SPREAD=0,AIR_SPREAD=0,VISUAL_BLOOM=0,
  SWAY=0,SWAY_MAX=0,SWAY_ROT=0,SWAY_ROT_MAX=0}
local SGC_KEYS={"rate","spread","adsSpread","moveSpread","sway","kickRoll",
  "adsKick","shakeDur","kickPitch","kickBack","KICK_PITCH","KICK_BACK",
  "SHAKE_MAX","MOVE_SPREAD","ADS_SPREAD","AIR_SPREAD","VISUAL_BLOOM",
  "SWAY","SWAY_MAX","SWAY_ROT","SWAY_ROT_MAX","MAX_CLIMB"}

-- Resolve the GC API. In the dumper getgc is a bare global, but this script can
-- be loaded into an environment where it only lives on _G or on the executor's
-- shared table. A nil getgc used to make the whole feature fail silently.
-- Hoisted out of setgc_apply so the per-frame path allocates no closure.
local function gc_api(name)
  local fn=nil
  pcall(function() if type(_G)=="table" and type(_G[name])=="function" then fn=_G[name] end end)
  if not fn then
    pcall(function()
      if type(getgenv)=="function" then
        local g=getgenv()
        if type(g)=="table" and type(g[name])=="function" then fn=g[name] end
      end
    end)
  end
  if not fn then
    pcall(function()
      if name=="getgc" and type(getgc)=="function" then fn=getgc end
    end)
  end
  return fn
end

-- ---------------------------------------------------------------------------
-- Memory pass for the gun-mod keys (see the block at the top of the section for
-- the layout and the key list).
--
-- Every shot runs
--   u17.kickBack  = (def.kickBack  or KICK_BACK)  * KICK167[itemId]
--   u17.kickPitch = (def.kickPitch or KICK_PITCH) * KICK167[itemId]
-- and the viewmodel pose multiplies both by the kick spring, so those two
-- numbers are the gun model's up/back jolt. setgc returns 0 for both names
-- while patching kickRoll in the same table, so they are written directly -
-- together with rate, so the whole mod is one scan instead of a scan plus a
-- setgc walk.
--
-- getgc(keys) in this build returns the GC nodes as
--   { fields = <name -> value map>, table = <address> }
-- which is the whole reason the dump could patch them.
-- ---------------------------------------------------------------------------
local function sgc_mem()
  local st=PF.sgc
  local mem=st.mem
  local m=st.memory
  if not m then
    local cand=nil
    pcall(function() if type(_G)=="table" then cand=_G.memory end end)
    if type(cand)~="table" then
      pcall(function()
        if type(getgenv)=="function" then
          local g=getgenv()
          if type(g)=="table" then cand=g.memory end
        end
      end)
    end
    if type(cand)~="table" or type(cand.Read)~="function"
      or type(cand.Write)~="function" or type(cand.ReadBuffer)~="function" then
      mem.ok=false
      return
    end
    m=cand
    st.memory=m
  end
  local g=st.getgc or gc_api("getgc")
  st.getgc=g
  if not g then mem.ok=false return end
  local ms=math.floor((tonumber(cfg.gun_sgc_rate_ms) or 90)+0.5)
  if ms<80 then ms=80 elseif ms>190 then ms=190 end
  local ratev=ms/1000
  local rate_on=(cfg.gun_sgc and cfg.gun_sgc_rate) and true or false
  local clean_on=(cfg.gun_sgc and cfg.gun_sgc_clean) and true or false
  -- KICK_PITCH / KICK_BACK are the module-level fallbacks used by any weapon
  -- def that does not carry its own pair. They are only scales, never spring
  -- constants, so zeroing them cannot leave the pose stuck.
  -- SHAKE_MAX is the amplitude constant behind the impact shake: a bullet that
  -- lands inside SHAKE_RANGE (120 studs) does
  --   shakeStrength = max(shakeStrength, SHAKE_MAX * strength * falloff)
  -- on every hit, which is the rest of the "Shake" label. setgc refuses
  -- shakeStrength itself, and the value is rebuilt per shot, so the constant is
  -- what has to go.
  local ok,nodes=pcall(g,SGC_KEYS)
  if not ok or type(nodes)~="table" then mem.ok=false return end
  -- getgc returns an array in this build, but the dumper also guards against a
  -- hash-keyed node map, so do the same instead of silently walking zero items.
  local list=nodes
  if #nodes==0 then
    list={}
    for _,v in pairs(nodes) do list[#list+1]=v end
  end

  local function ptr(a)
    local okp,v=pcall(m.Read,a,"ptr")
    if okp and type(v)=="number" and v>65536 then return v end
    return nil
  end
  -- every identifier run in a TString, so a short key is not beaten by a
  -- longer run inside the string header
  local function ident(buf)
    local out,cur={},nil
    for i=1,#buf do
      local c=buf:byte(i)
      if (c>=48 and c<=57) or (c>=65 and c<=90)
        or (c>=97 and c<=122) or c==95 then
        cur=cur or {}
        cur[#cur+1]=string.char(c)
      elseif cur then
        if #cur>=3 and #cur<=24 then out[#out+1]=table.concat(cur) end
        cur=nil
      end
    end
    if cur and #cur>=3 and #cur<=24 then out[#out+1]=table.concat(cur) end
    return out
  end

  local wrote,tables=0,0
  local raddr,rkey={},{}
  -- GunControl's u1.INPUT is a nested table, so it cannot be matched by the
  -- value gate below (its node holds a pointer, not a double). The camera
  -- recoil is  kick * mult294(), and mult294() is
  --   1 * (ADS blend) * (CROUCH) * u1.INPUT[device]
  -- so zeroing the three device multipliers makes the per-shot camera
  -- pitch/yaw exactly 0 while leaving the kick pattern and the recoil spring
  -- alone. Walking the inner table directly is the only way to reach them.
  local function zero_input(t)
    local np2=ptr(t+24)
    if not np2 then return end
    local okb2,b2=pcall(m.Read,t+1,"uint8")
    local n2=4
    if okb2 and type(b2)=="number" and b2>=0 and b2<=4 then
      n2=math.max(4,2^b2)
    end
    for k=0,n2-1 do
      local b2p=np2+k*32
      local kp2=ptr(b2p+16)
      if kp2 then
        local okr2,buf2=pcall(m.ReadBuffer,kp2,48)
        if okr2 and type(buf2)=="string" and #buf2>=16 then
          local runs2=ident(buf2)
          for r2=1,#runs2 do
            local s2=runs2[r2]
            if s2=="Mouse" or s2=="Touch" or s2=="Gamepad" then
              -- the stock values are 1 / 0.7 / 0.8, so anything else means a
              -- different layout and is left alone
              local okv2,v2=pcall(m.Read,b2p,"double")
              if okv2 and type(v2)=="number" and v2>0 and v2<4 then
                if pcall(m.Write,b2p,"double",0) then wrote=wrote+1 end
              end
              break
            end
          end
        end
      end
    end
  end
  for i=1,#list do
    local d=list[i]
    if type(d)=="table" then
      local f=d.fields
      local addr=d.table
      if type(f)=="table" and type(addr)=="number" and addr>65536 then
        local np=ptr(addr+24)
        if np then
          tables=tables+1
          local okb,b=pcall(m.Read,addr+1,"uint8")
          local n=64
          if okb and type(b)=="number" and b>=0 and b<=7 then n=2^b end
          for j=0,n-1 do
            local base=np+j*32
            local kp=ptr(base+16)
            if kp then
              local okr,buf=pcall(m.ReadBuffer,kp,64)
              if okr and type(buf)=="string" and #buf>=16 then
                local runs=ident(buf)
                local nm=nil
                for r=1,#runs do
                  local s=runs[r]
                  if f[s]~=nil and (s=="rate" or SGC_Z[s]~=nil) then
                    local okv,v=pcall(m.Read,base,"double")
                    local want=f[s]
                    if okv and type(v)=="number" and type(want)=="number"
                      and v==v and want==want then
                      local tol=math.max(math.abs(v),math.abs(want),1e-9)*1e-9
                      if math.abs(v-want)<=tol then nm=s break end
                    end
                  end
                end
                -- MAX_CLIMB is unique to GunControl's module table (u1), so
                -- finding it proves the INPUT node beside it is u1.INPUT and
                -- not some unrelated field with the same name.
                if not nm and clean_on and f["MAX_CLIMB"]~=nil then
                  for r=1,#runs do
                    if runs[r]=="INPUT" then
                      local it=ptr(base)
                      if it then zero_input(it) end
                      break
                    end
                  end
                end
                if nm=="rate" then
                  -- cache the node so the slider can rewrite it without a scan.
                  -- The key pointer is kept as an identity check for later
                  -- writes, because a freed table's address can be reused.
                  raddr[#raddr+1]=base
                  rkey[#rkey+1]=kp
                  if rate_on and pcall(m.Write,base,"double",ratev) then
                    wrote=wrote+1
                  end
                elseif nm and clean_on and f[nm]~=0 then
                  if pcall(m.Write,base,"double",0) then wrote=wrote+1 end
                end
              end
            end
          end
        end
      end
    end
  end
  mem.ok=(wrote>0)
  mem.wrote=wrote
  mem.tables=tables
  st.rate_addrs=raddr
  st.rate_keys=rkey
  -- nil when rate was off during the scan, so the first enable writes through
  -- the slider fast path instead of waiting for another scan.
  st.rate_ms=rate_on and ms or nil
  st.rate_val=ratev
end

local function setgc_apply()
  local st=PF.sgc
  local forced=(sgc_force~=st.force)
  local rate_on=(cfg.gun_sgc and cfg.gun_sgc_rate) and true or false
  local clean_on=(cfg.gun_sgc and cfg.gun_sgc_clean) and true or false
  local ms=math.floor((tonumber(cfg.gun_sgc_rate_ms) or 90)+0.5)
  if ms<80 then ms=80 elseif ms>190 then ms=190 end
  if not rate_on and not clean_on then
    if forced then st.force=sgc_force end
    st.last_rate=false
    st.last_clean=false
    return
  end
  -- Slider fast path: the scan already cached every rate node, so a drag is a
  -- few memory writes instead of another whole-VM walk. The key pointer check
  -- makes sure the cached address still holds a "rate" node before writing.
  if rate_on and st.rate_addrs and st.rate_ms~=ms then
    local m=st.memory
    if m then
      local v=ms/1000
      local keys=st.rate_keys
      for i=1,#st.rate_addrs do
        local okp,p=pcall(m.Read,st.rate_addrs[i]+16,"ptr")
        if okp and p==keys[i] then
          pcall(m.Write,st.rate_addrs[i],"double",v)
        end
      end
      st.rate_ms=ms
      st.rate_val=v
    end
  end
  -- ONE automatic scan per toggle that is switched ON. A whole-VM getgc walk
  -- freezes the game for about a second, so re-running it on every toggle click
  -- (and on every slider pixel) was a hitch per click. The scan waits 45 frames
  -- (~0.75 s) after the last change, so switching the master on and then the
  -- sub-toggles on still costs a single pass, and once that pass has run only
  -- another enable or the Re-apply button starts a new one.
  --
  -- Switching a toggle OFF does not scan: the values are already written and
  -- there is no read-back to restore, so a scan would only cost a second.
  --
  -- The old code keyed this on "has a scan ever run", which meant enabling
  -- Reduce Spread / Sway / Kick / Bloom / Shake after Fire Rate had already
  -- scanned did nothing until Re-apply was pressed. The two enable edges are
  -- tracked instead, so every toggle gets its own single pass.
  -- Fire Rate only needs a scan the first time, to find the rate nodes; after
  -- that the slider fast path above writes them directly, so enabling it again
  -- must not cost another second. Reduce Spread / Sway / Kick / Bloom / Shake
  -- always needs the walk, because that is the only place its names are zeroed.
  local added=(clean_on and not st.last_clean)
    or (rate_on and not st.last_rate and not st.rate_addrs)
  st.last_rate=rate_on
  st.last_clean=clean_on
  if forced then
    st.force=sgc_force
    st.memdone=false
    st.done=false
    st.hold=44
  elseif added then
    st.memdone=false
    st.done=false
    st.hold=0
  elseif st.done then
    return
  end
  st.hold=st.hold+1
  if st.hold<45 then return end
  st.hold=0
  st.done=true
  if not st.memdone then
    st.memdone=true
    pcall(sgc_mem)
  end
end

-- ---------------------------------------------------------------------------
-- NPC instance accessors.
-- The runtime exposes Roblox instances with either PascalCase methods
-- (FindFirstChild / GetChildren) or the snake_case binding hub.txt uses
-- (find_first_child / get_children). Every lookup below tries both, so the NPC
-- pass works on either build instead of failing silently inside a pcall.
-- ---------------------------------------------------------------------------
local function o_children(obj)
  if not obj then return nil end
  -- method names are unrolled instead of walked from a fresh {"GetChildren",
  -- "get_children"} table: this runs per instance per sweep, and the tables were
  -- pure garbage.
  local fn=obj.GetChildren
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj)
    if ok and type(v)=="table" then return v end
  end
  fn=obj.get_children
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj)
    if ok and type(v)=="table" then return v end
  end
  return nil
end

local function o_first(obj,name)
  if not obj then return nil end
  local fn=obj.FindFirstChild
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj,name)
    if ok and v then return v end
  end
  fn=obj.find_first_child
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj,name)
    if ok and v then return v end
  end
  local okd,d=pcall(PF.get,obj,name)
  if okd and d then return d end
  local ch=o_children(obj)
  if ch then
    for i=1,#ch do
      local c=ch[i]
      local okn,nm=pcall(PF.name,c)
      if okn and nm==name then return c end
    end
  end
  return nil
end

local function o_class(obj)
  if not obj then return nil end
  local ok,v=pcall(PF.cls,obj)
  if ok and type(v)=="string" then return v end
  local ok2,v2=pcall(PF.get,obj,"class_name")
  if ok2 and type(v2)=="string" then return v2 end
  return nil
end

local function o_pos(part)
  if not part then return nil end
  local ok,cf=pcall(PF.cframe,part)
  if ok and cf then
    local okp,p=pcall(PF.cfpos,cf)
    if okp and p then
      local x=p.X or p.x; local y=p.Y or p.y; local z=p.Z or p.z
      if x and y and z then return x,y,z end
    end
  end
  ok,cf=pcall(PF.get,part,"cframe")
  if ok and cf then
    local okp,p=pcall(PF.cfpos,cf)
    if okp and p then
      local x=p.X or p.x; local y=p.Y or p.y; local z=p.Z or p.z
      if x and y and z then return x,y,z end
    end
  end
  local ok3,q=pcall(PF.pos,part)
  if ok3 and q then
    local x=q.X or q.x; local y=q.Y or q.y; local z=q.Z or q.z
    if x and y and z then return x,y,z end
  end
  ok3,q=pcall(PF.get,part,"position")
  if ok3 and q then
    local x=q.X or q.x; local y=q.Y or q.y; local z=q.Z or q.z
    if x and y and z then return x,y,z end
  end
  return nil
end

local function o_root(inst)
  if not inst then return nil end
  local hum=o_first(inst,"Humanoid")
  if hum then
    local okr,rp=pcall(PF.rootpart,hum)
    if not (okr and rp) then
      local ok2,v2=pcall(PF.get,hum,"root_part")
      if ok2 then rp=v2 end
    end
    if rp and o_pos(rp) then return rp end
  end
  local names={"HumanoidRootPart","UpperTorso","Torso","Head","RootPart","Body"}
  for i=1,#names do
    local p=o_first(inst,names[i])
    if p and o_pos(p) then return p end
  end
  local ch=o_children(inst)
  if ch then
    for i=1,#ch do
      local c=ch[i]; local cl=o_class(c)
      if cl=="Part" or cl=="MeshPart" or cl=="BasePart" or cl=="UnionOperation" then
        if o_pos(c) then return c end
      end
    end
  end
  return nil
end

-- Resolves an instance that may itself be a part, a Model wrapping parts, or a
-- Model-of-Models. The patrol heli is the reason this exists: its "Fuselage" is
-- a Model, so taking the first named child and projecting it yields no position
-- and the whole helicopter silently disappears.
local function o_part_in(obj)
  if not obj then return nil end
  local cl=o_class(obj)
  if cl~="Model" and o_pos(obj) then return obj end
  local okd,d=pcall(PF.desc,obj)
  if not okd then
    local g=obj.get_descendants
    if type(g)=="function" then okd,d=pcall(g,obj) end
  end
  if okd and type(d)=="table" then
    for i=1,#d do
      local c=d[i]; local cc=o_class(c)
      if (cc=="Part" or cc=="MeshPart" or cc=="BasePart" or cc=="UnionOperation") and o_pos(c) then return c end
    end
  end
  local ch=o_children(obj)
  if ch then
    for i=1,#ch do
      local c=ch[i]; local cc=o_class(c)
      if (cc=="Part" or cc=="MeshPart" or cc=="BasePart") and o_pos(c) then return c end
    end
  end
  return nil
end

-- Bone set for the NPC rig, and the links drawn between them. Kept as data so
-- the skeleton pass projects each bone exactly once per frame instead of once
-- per line.
local NPC_BONES={"Head","UpperTorso","LowerTorso",
  "LeftUpperArm","LeftLowerArm","LeftHand",
  "RightUpperArm","RightLowerArm","RightHand",
  "LeftUpperLeg","LeftLowerLeg","LeftFoot",
  "RightUpperLeg","RightLowerLeg","RightFoot"}
-- Links as numeric bone indices, and a flat scratch buffer for the projected
-- points. Reusing these means the skeleton pass allocates nothing per frame:
-- building a {x,y} table per bone per NPC was pure GC churn. The topology is
-- taken from the player rig's own list (PF.bone_links) and re-expressed in
-- NPC_BONES indices, so the two skeletons cannot drift apart; a bone the NPC
-- rig does not have is skipped by the nil guard.
local NPC_BONE_IDX={}
for i=1,#NPC_BONES do NPC_BONE_IDX[NPC_BONES[i]]=i end
local NPC_LINKS={}
for i=1,#PF.bone_links do
  local l=PF.bone_links[i]
  local a=NPC_BONE_IDX[PF.bone_names[l[1]]]
  local b=NPC_BONE_IDX[PF.bone_names[l[2]]]
  if a and b then NPC_LINKS[#NPC_LINKS+1]={a,b} end
end
-- same path batching as the player rig: 14 links collapse to 5 polylines
PF.npc_chains=PF.chains(NPC_LINKS)
local NPC_PX={}
local NPC_PY={}
local NPC_POK={}
-- shared constants: a default swatch and a precomputed health ramp, so the NPC
-- draw path does not allocate colour tables per NPC per frame
local NPC_COL={
  def={0.25,0.85,1.00,1},
  skel={1,0.35,0.35,1},
  hat={0.99,0.78,0.36,1},
  box={0.45,0.78,1,1},
  -- shared scratch for Chroma NPC: one table reused by every tinted element,
  -- so a rainbow overlay allocates nothing per frame (draw calls copy the
  -- colour immediately, the same way the radar reuses its blip scratch)
  ch={1,1,1,1},
  hp_bg={0.1,0.1,0.1,0.8},
  hp={},
  -- real metres per stud, and its square. A range row is stored in real metres
  -- and the cull compares squared studs, so the squared range has to divide by
  -- m2 (a 400 m limit is 1429 studs). The distance row itself prints studs - the
  -- game's own metres - so the number beside an NPC matches the kill feed.
  m=PF.m,
  m2=PF.m*PF.m,
  -- The patrol heli is exempt from the NPC Range slider: it flies, so a fixed
  -- ceiling keeps it on screen whatever the slider is set to. 1000m, converted
  -- to studs the same way the slider is.
  heli=1000/PF.m,
  -- Bone indices the box needs: head, left foot, right foot. Kept on this table
  -- so the projection helper does not add another main-chunk local.
  boxidx={1,12,15},
}
NPC_COL.heli2=NPC_COL.heli*NPC_COL.heli
for i=0,20 do local p=i/20; NPC_COL.hp[i]={1-p,p,0.2,1} end

-- Resolving Humanoid/RootPart again on every sweep was a per-NPC reflection
-- cost we never needed to pay twice.
local NPC_ROOT_CACHE=setmetatable({},{__mode="k"})

-- Incremental sweep state. The scan touches only a handful of NPCs per frame
-- and swaps the published list in when the sweep finishes, so no single frame
-- ever pays for the whole map. NPC_LIST is what the draw pass iterates.
local NPC_LIST={}
local NPC_NEXT={}
local NPC_LIVE=setmetatable({},{__mode="k"})
local NPC_KIDS={}
local NPC_HELI=false
local npc_kid_idx=0
local npc_kids_t=-1
local npc_next_n=0
local npc_sweep_active=false
local npc_sweep_id=0

-- Head hitbox expander, for players and NPCs. The visible Head part is never
-- resized: instead the Vector raycast silent-aim hook is fed a target every
-- frame, and any head whose centre lies within the fixed 130% radius of the aim
-- ray is treated as hit. 130% is the largest radius that still registers - above
-- roughly 132% the server stops accepting the redirected hit - so the radius is
-- pinned there instead of being exposed as a slider. The same radius is drawn as
-- a thin ring around each head (Show Hitbox), so the effective hitbox is visible
-- while the head itself keeps its normal size on screen.
-- The redirect is only armed while the toggle is on, only for heads actually
-- visible from the aim origin (no silent wallbang), and cleared the moment no
-- head is in range. NPC rigs come from the same incremental sweep the NPC ESP
-- and aim passes use; that sweep is kept warm by cfg.hb_on, so the expander
-- works on NPCs without NPC ESP or Target NPC being enabled.
local HB_ST={hook=false,col={0.45,0.78,1,0.8}}
-- Enable/disable the silent hook once per state change. Kept on HB_ST so the
-- pass adds no extra main-chunk local.
HB_ST.hook_set=function(on)
  if HB_ST.hook==on then return end
  local rc=raycast
  if not rc then return end
  if on then
    local fn=rc.EnableSilentHook
    if type(fn)~="function" then return end
    local ok,res=pcall(fn)
    if ok and res~=false then HB_ST.hook=true end
  else
    pcall(function()
      if rc.ClearSilentTarget then rc.ClearSilentTarget() end
      if rc.DisableSilentHook then rc.DisableSilentHook() end
    end)
    HB_ST.hook=false
  end
end
local function run_hitbox()
  local scale=1.3
  if not cfg.hb_on then
    HB_ST.hook_set(false)
    return
  end
  local vw=PF.getview()
  local lp=vw.lp
  local origin
  if lp then
    local okh,h=pcall(PF.head,lp)
    if okh then origin=h end
  end
  if not origin then origin=vw.cpv end
  local look=vw.lvv
  local rc=raycast
  if not (origin and look and rc and rc.SetSilentTarget) then
    HB_ST.hook_set(false)
    return
  end
  HB_ST.hook_set(true)
  -- Ring depth has to be measured from the camera, not from the local head. The
  -- third-person camera sits a couple of studs behind and above the head, so a
  -- target off to the side of the screen got a much shallower depth than its
  -- real camera distance, and the ring radius (which is inverse depth) blew up.
  -- The silent-aim origin stays the head: SetSilentTarget and the visibility
  -- test below still use it, they are about aim, not about drawing.
  local eye=vw.cpv or origin
  -- look vector components, read once: the per-target depth and offset tests
  -- below are plain arithmetic on these instead of Vector3 subtract / Dot / #
  -- calls, which allocated three temporary vectors per candidate per frame
  local lkx,lky,lkz=look.X or look.x or 0,look.Y or look.y or 0,look.Z or look.z or 0
  -- Two separate reaches. The silent-aim redirect itself keeps its old bounds -
  -- Aimbot Range for players, NPC Range for NPCs - so widening or narrowing the
  -- ESP rows never changes what the expander can actually grab. Only the rings
  -- are gated by the ESP rows: Player Range for players, NPC Range for NPCs, so
  -- Show Hitbox draws exactly the heads the ESP would show. Player Range 0 is
  -- that slider's "show nothing" position, so it hides the player rings.
  local maxd=(cfg.aim_range or 1500)/PF.m
  local ringd=cfg.esp_maxdist or 1500*M_PER_STUD
  if ringd<0 then ringd=0 end
  if ringd>1500*M_PER_STUD then ringd=1500*M_PER_STUD end
  ringd=ringd/PF.m
  local best=nil
  local bestd=scale
  -- ring colour comes from the inline picker on the Show Hitbox row; chroma
  -- overrides it with a cycling hue but keeps the picked alpha
  local hc=col.c_hb or HB_ST.col
  if cfg.hb_chroma then
    local base=col.c_hb
    local c=hsv(FRAME*0.002,0.8,1)
    local sc=HB_ST.col
    sc[1],sc[2],sc[3],sc[4]=c[1],c[2],c[3],(base and base[4]) or 0.8
    hc=sc
  end
  local can_draw=(cfg.hb_draw~=false) and draw.Circle and true or false
  local sw,sh=scr()
  -- Pixels per stud at one stud of depth, measured instead of assumed. Two
  -- points one stud apart, ten studs down the look vector, give the exact
  -- projection constant for this frame. Deriving it from GetFov alone assumed
  -- the host's FOV and the draw projection agreed; when they did not, the ring
  -- grew and shrank against the real head, which is the size wobble. FOV is only
  -- the fallback for a camera that refuses to project.
  local fscale
  if eye then
    local ax,ay,az=eye.X+look.X*10,eye.Y+look.Y*10,eye.Z+look.Z*10
    -- step sideways when the look vector is near vertical, so the two probes do
    -- not land on the same pixel and hand back a zero scale
    local bx,by,bz
    if math.abs(look.Y)>0.9 then bx,by,bz=ax+1,ay,az
    else bx,by,bz=ax,ay+1,az end
    local o1,sx1,sy1,v1=pcall(draw.WorldToScreen,ax,ay,az)
    local o2,sx2,sy2,v2=pcall(draw.WorldToScreen,bx,by,bz)
    if o1 and o2 and sx1 and sy1 and sx2 and sy2 and v1~=false and v2~=false then
      local dx,dy=sx2-sx1,sy2-sy1
      local g=math.sqrt(dx*dx+dy*dy)
      -- g is pixels per stud at 10 studs, so g*10 is pixels per stud at 1
      if g>0.001 and g<100000 then fscale=g*10 end
    end
  end
  if not fscale then
    local fov
    if camera then
      local okf,fv=pcall(camera.GetFov)
      if okf then fov=fv end
    end
    if not fov or fov<10 then fov=70 end
    fscale=(sh*0.5)/math.tan(math.rad(fov)*0.5)
  end
  local function ring(h,t)
    if not can_draw then return end
    -- a head right on the camera would divide the radius into nonsense
    if t<1.5 then return end
    local ok,sx,sy,vis=pcall(draw.WorldToScreen,h.X or h.x,h.Y or h.y,h.Z or h.z)
    if not ok or not sx or not sy or vis==false then return end
    if sx<-8 or sy<-8 or sx>sw+8 or sy>sh+8 then return end
    local pr=scale*fscale/t
    if pr<1.5 then return end
    if pr>sh then pr=sh end
    pcall(draw.Circle,sx,sy,pr,hc,20,1.2)
  end
  local players=PF.players()
  if players then
    for i=1,#players do
      local p=players[i]
      local fl=PF.pflag(p)
      if not fl.il and fl.al~=false and not (cfg.aim_team and esp_mate(p,lp)) then
        local okh,h=pcall(PF.head,p)
        if okh and h then
          local vx,vy,vz=h.X-eye.X,h.Y-eye.Y,h.Z-eye.Z
          local t=vx*lkx+vy*lky+vz*lkz
          if t>0 and t<=maxd then
            -- the ring is the ESP-gated part; the redirect below is not
            if t<=ringd then ring(h,t) end
            local ox,oy,oz=vx-lkx*t,vy-lky*t,vz-lkz*t
            local d=math.sqrt(ox*ox+oy*oy+oz*oz)
            if d<bestd then bestd=d; best=h end
          end
        end
      end
    end
  end
  -- NPC heads use the same radius and the same redirect. No gate on the NPC ESP
  -- or Target NPC toggles: cfg.hb_on keeps the sweep warm (scan_npcs_task), so
  -- the expander covers NPCs on its own. Dead rigs are skipped so a shot is
  -- never pulled onto a corpse. NPC Range bounds both halves here, so the ring
  -- gate and the redirect gate are the same test - unlike the player half, where
  -- Aimbot Range reaches further than the rings.
  local npcmax=cfg.npcs_max_dist or 300*M_PER_STUD
  if npcmax>300*M_PER_STUD then npcmax=300*M_PER_STUD end
  npcmax=npcmax/PF.m
  if npcmax>maxd then npcmax=maxd end
  local list=cache_npcs or NPC_LIST
  for i=1,#list do
    local n=list[i]
    if n and n.inst and not n.is_heli and (n.hp or 1)>0 then
      local hp=n.hbhead
      if hp==nil then
        hp=n.bones and n.bones[1]
        if not hp then hp=o_first(n.inst,"Head") end
        n.hbhead=hp or false
      end
      if hp then
        local ok,hh=pcall(PF.pos,hp)
        if ok and hh then
          local vx,vy,vz=hh.X-eye.X,hh.Y-eye.Y,hh.Z-eye.Z
          local t=vx*lkx+vy*lky+vz*lkz
          if t>0 and t<=npcmax then
            ring(hh,t)
            local ox,oy,oz=vx-lkx*t,vy-lky*t,vz-lkz*t
            local d=math.sqrt(ox*ox+oy*oy+oz*oz)
            if d<bestd then bestd=d; best=hh end
          end
        end
      end
    end
  end
  if best then
    -- never expand through geometry: the head itself has to be visible from
    -- the aim origin, otherwise this would silently wallbang
    local vis=true
    if rc.IsVisible then
      local okv,v=pcall(rc.IsVisible,origin,best)
      if okv then vis=v~=false end
    end
    if vis then
      pcall(rc.SetSilentTarget,origin,best-origin)
    else
      pcall(rc.ClearSilentTarget)
    end
  else
    pcall(rc.ClearSilentTarget)
  end
end

-- Project a world point and keep it only when it actually lands on the screen.
-- Points behind the camera still come back with coordinates, and those mirrored
-- values are what made the overlay streak across the display.
local function npc_proj(wx,wy,wz,sw,sh)
  local ok,sx,sy,vis=pcall(draw.WorldToScreen,wx,wy,wz)
  -- only fall back when the primary call itself failed: retrying on "no result"
  -- doubled the cost of every off-screen bone projection
  if not ok and utility then
    local w2=utility.WorldToScreen or utility.world_to_screen
    if w2 then
      local ok2,vx,vy,vv=pcall(w2,wx,wy,wz)
      if ok2 then sx,sy,vis=vx,vy,vv end
    end
  end
  if not sx or not sy or vis==false then return nil end
  if sx<-4 or sy<-4 or sx>sw+4 or sy>sh+4 then return nil end
  return sx,sy
end

-- Origin for the range filter. The camera object is not exposed on every build,
-- so this walks down to the local player and only then to the camera.
local function npc_origin()
  -- the memo already resolved the local player's root and the camera eye
  local vw=PF.getview()
  local x,y,z=vw.lx,vw.ly,vw.lz
  if not x then
    local lp=vw.lp
    if lp then
      local okh,h=pcall(PF.head,lp)
      if okh and h then x,y,z=h.X or h.x,h.Y or h.y,h.Z or h.z end
      if not x then
        local okc,c=pcall(PF.char,lp)
        if okc and c then
          local okr,rp=pcall(PF.prim,c)
          if not okr or not rp then okr,rp=pcall(PF.rootpart,c) end
          if okr and rp then
            local okq,q=pcall(PF.pos,rp)
            if okq and q then x,y,z=q.X or q.x,q.Y or q.y,q.Z or q.z end
          end
        end
      end
    end
    if not x then x,y,z=vw.cx,vw.cy,vw.cz end
  end
  return x,y,z
end

local function o_parts(inst)
  local t={}
  if not inst then return t end
  -- One sweep of the direct children first: every Guard/Soldier bone in the dump
  -- (Head, UpperTorso, limbs, hands, feet, HumanoidRootPart) sits directly under
  -- the model. Doing this once beats 21 separate lookups per NPC per scan.
  local ch=o_children(inst)
  if ch then
    for i=1,#ch do
      local c=ch[i]
      local okn,nm=pcall(PF.name,c)
      if okn and type(nm)=="string" then t[nm]=c end
    end
  end
  -- Anything the model keeps one level down (wrapped rigs, a Gun sub-model) is
  -- picked up here, but only when the name is not already a direct child.
  local okd,desc=pcall(PF.desc,inst)
  if not okd then
    local g=inst.get_descendants
    if type(g)=="function" then okd,desc=pcall(g,inst) end
  end
  if okd and type(desc)=="table" then
    for i=1,#desc do
      local c=desc[i]
      local okn,nm=pcall(PF.name,c)
      if okn and type(nm)=="string" and not t[nm] then t[nm]=c end
    end
  end
  return t
end

local function o_hp(inst)
  local hum=o_first(inst,"Humanoid")
  if not hum then return 100,100 end
  local hp,maxhp=100,100
  local okh,hv=pcall(PF.hp,hum); if okh then hp=tonumber(hv) or 100 end
  local okm,mv=pcall(PF.mhp,hum); if okm then maxhp=tonumber(mv) or 100 end
  if maxhp<1 then maxhp=100 end
  if hp<0 then hp=0 end
  return hp,maxhp
end

-- Non-allocating position read. o_pos wraps every property access in a fresh
-- closure, which is fine for a handful of calls but not for 15 bones per NPC
-- per frame: that is hundreds of throwaway closures every frame, and the GC
-- pauses from them are what made the overlay stutter with skeletons on.
local function bone_xyz(part)
  if not part then return nil end
  -- Position first: it is the same point CFrame.Position gives, but for one
  -- host call and one throwaway table instead of two. This is the hottest read
  -- in the NPC pass (15 bones x every NPC x every frame), so the reorder alone
  -- halves that cost. CFrame stays as the fallback for parts without Position.
  local ok,p=pcall(PF.pos,part)
  if ok and p then
    local x=p.X or p.x; local y=p.Y or p.y; local z=p.Z or p.z
    if x and y and z then return x,y,z end
  end
  local ok2,cf=pcall(PF.cframe,part)
  if ok2 and cf then
    local ok3,q=pcall(PF.cfpos,cf)
    if ok3 and q then
      local x=q.X or q.x; local y=q.Y or q.y; local z=q.Z or q.z
      if x and y and z then return x,y,z end
    end
  end
  return nil
end

-- Project a rig's bones once per frame into the shared screen arrays. The draw
-- pass used to re-read and re-project the head and a foot for the box, then the
-- head again for the dot and the whole rig again for the skeleton: on a screen
-- full of NPCs that was thousands of host calls per frame, which is what
-- dragged the FPS down. all=false projects only the three points the box needs.
local function npc_project_bones(arr,sw,sh,all)
  if not arr then return end
  local n=all and #arr or #NPC_COL.boxidx
  for i=1,n do
    local k=all and i or NPC_COL.boxidx[i]
    local pr=arr[k]
    local wx,wy,wz
    if pr then wx,wy,wz=bone_xyz(pr) end
    if wx then
      local sx,sy=npc_proj(wx,wy,wz,sw,sh)
      if sx then
        NPC_PX[k]=sx; NPC_PY[k]=sy; NPC_POK[k]=true
      else
        NPC_POK[k]=false
      end
    else
      NPC_POK[k]=false
    end
  end
end

-- Ordered bone parts per rig, resolved once per NPC entry. The name-keyed table
-- from o_parts would work, but an array keeps the per-frame loop allocation free
-- and lets a missing bone be remembered as "false" instead of retried forever.
local function npc_bone_array(inst)
  local arr={}
  local t=o_parts(inst) or {}
  for i=1,#NPC_BONES do
    local bn=NPC_BONES[i]
    local pr=t[bn]
    if not pr then pr=o_first(inst,bn) end
    arr[i]=pr or false
  end
  return arr
end

local function scan_npcs_task()
  -- Incremental sweep: only a handful of NPCs are touched per frame instead of
  -- the whole folder in one go. The published list is replaced only when a
  -- sweep completes, so the draw pass always sees a coherent snapshot and no
  -- single frame ever pays for the whole map.
  npc_scan_frames=npc_scan_frames+1
  -- the aimbot NPC toggle keeps the scan warm on its own, so targeting NPCs
  -- works without the NPC ESP master switch being on. The patrol heli is
  -- resolved by this same sweep, so its aim toggle counts too.
  if not (cfg.npc_esp_enabled or cfg.aim_npc or cfg.aim_heli or cfg.hb_on) then
    if #NPC_LIST>0 or npc_sweep_active then
      NPC_LIST={}
      NPC_NEXT={}
      NPC_LIVE=setmetatable({},{__mode="k"})
      NPC_KIDS={}
      NPC_HELI=false
      npc_kid_idx=0
      npc_next_n=0
      npc_kids_t=-1
      npc_sweep_active=false
      cache_npcs=NPC_LIST
    end
    return
  end

  local okc,nowt=pcall(now)
  if not okc or type(nowt)~="number" or nowt<=0 then
    -- no usable clock on this build: derive one from the frame counter
    nowt=npc_scan_frames*0.016
  end

  -- Start a sweep at most once a second, and never while one is still running.
  -- The frame-count valve matters if GetTime is frame-granular on some build:
  -- without it a frozen clock would stop sweeps from ever restarting.
  if not npc_sweep_active then
    if nowt-npc_kids_t<1.0 and (npc_scan_frames%90)~=0 then return end
    npc_sweep_active=true
    npc_kids_t=nowt
    npc_kid_idx=0
    npc_next_n=0
    npc_sweep_id=npc_sweep_id+1
    local ws=nil
    pcall(function()
      if game then
        ws=game.Workspace or game.workspace
        if not ws and game.GetService then ws=game:GetService("Workspace") end
      end
    end)
    if not ws and workspace then ws=workspace end
    local kids=NPC_KIDS
    for i=#kids,1,-1 do kids[i]=nil end
    NPC_HELI=false
    if ws then
      local folder=o_first(ws,"Npcs")
      if not folder then
        -- only when the folder is genuinely absent, and only by name: probing
        -- every top-level model for a Humanoid was a map-wide walk per scan.
        local top=o_children(ws)
        if top then
          for i=1,#top do
            local inst=top[i]
            local nm=""
            pcall(function() nm=(inst.Name or ""):lower() end)
            if nm:find("npc",1,true) then folder=inst; break end
          end
        end
      end
      if folder then
        local ch=o_children(folder)
        if ch then
          for i=1,#ch do kids[#kids+1]=ch[i] end
        end
      end
      -- heli is resolved once per sweep; its position is read live when drawn
      local hf=o_first(ws,"FustPatrolHeli")
      if hf then
        local heli=o_first(hf,"PatrolHeliModel") or o_first(hf,"PatrolHeli") or hf
        local main=NPC_ROOT_CACHE[heli]
        if main==nil then
          local cand={"Engine","Body","Fuselage","MainRotor"}
          for i=1,#cand do
            local p=o_first(heli,cand[i])
            if p then main=o_part_in(p); if main then break end end
          end
          if not main then main=o_part_in(heli) end
          NPC_ROOT_CACHE[heli]=main or false
        end
        if main then
          local px,py,pz=bone_xyz(main)
          if px then
            NPC_HELI={x=px,y=py,z=pz,name="Patrol Helicopter",inst=heli,obj=heli,
              root=main,head=main,torso=main,parts={},hp=5000,max_hp=5000,is_heli=true,
              color=col.npc_heli_col or {1.00,0.20,0.20,1}}
          end
        end
      end
    end
  end

  local nkids=#NPC_KIDS
  if npc_kid_idx<nkids then
    local ox0,oy0,oz0=npc_origin()
    local maxd0=cfg.npcs_max_dist or 300*M_PER_STUD
    if maxd0<1 then maxd0=300*M_PER_STUD end
    -- the row stops at 300 game metres; clamp in case a saved config predates it
    if maxd0>300*M_PER_STUD then maxd0=300*M_PER_STUD end
    -- slider is metres; cull is studs, so convert before squaring
    local maxsq0=(maxd0*maxd0/NPC_COL.m2)*1.44
    local nextl=NPC_NEXT
    local budget=16    -- total children visited this frame
    local newbudget=6  -- fresh rigs resolved this frame (the costly path)
    while npc_kid_idx<nkids and budget>0 do
      local inst=NPC_KIDS[npc_kid_idx+1]
      if not inst then
        npc_kid_idx=npc_kid_idx+1
        budget=budget-1
      else
        -- key on the instance address: wrappers can be recreated between calls,
        -- and losing the entry throws away its cached bone array (the flash)
        local key=inst
        local oka,ad=pcall(PF.addr,inst)
        if oka and type(ad)=="number" then key=ad end
        local e=NPC_LIVE[key]
        if e then
          npc_kid_idx=npc_kid_idx+1
          budget=budget-1
          local px,py,pz=bone_xyz(e.root)
          if px then
            e.x=px; e.y=py; e.z=pz
            local hp,maxhp=o_hp(inst)
            -- Hardcoded corpse filter: a dead rig never enters the published
            -- list, so the draw pass has nothing to render for it. Leaving
            -- e.seen untouched also drops it from NPC_LIVE at publish.
            if hp>0 then
              e.hp=hp; e.max_hp=maxhp
              if not e.hum then e.hum=o_first(inst,"Humanoid") or false end
              e.seen=npc_sweep_id
              npc_next_n=npc_next_n+1
              nextl[npc_next_n]=e
            end
          end
        elseif newbudget>0 then
          newbudget=newbudget-1
          npc_kid_idx=npc_kid_idx+1
          budget=budget-1
          local root=NPC_ROOT_CACHE[inst]
          if root==nil then
            root=o_root(inst) or false
            NPC_ROOT_CACHE[inst]=root
          end
          if root then
            local px,py,pz=bone_xyz(root)
            if px then
              local near=true
              if ox0 then
                local dx=px-ox0; local dy=py-oy0; local dz=pz-oz0
                near=(dx*dx+dy*dy+dz*dz<=maxsq0)
              end
              if near then
                local hp,maxhp=o_hp(inst)
                -- same hardcoded corpse filter on first sight: never create an
                -- entry for a rig that is already dead
                if hp>0 then
                  local nm="NPC"
                  local okn,nv=pcall(PF.name,inst)
                  if okn and type(nv)=="string" then nm=nv end
                  -- the bone array stays nil here and is resolved lazily by the
                  -- draw path, so a scan never walks GetDescendants
                  e={x=px,y=py,z=pz,name=nm,inst=inst,obj=inst,root=root,
                    key=key,seen=npc_sweep_id,hum=o_first(inst,"Humanoid") or false,
                    parts=nil,hp=hp,max_hp=maxhp,is_heli=false,
                    color=col.npc_soldier_col or {0.25,0.85,1.00,1}}
                  NPC_LIVE[key]=e
                  npc_next_n=npc_next_n+1
                  nextl[npc_next_n]=e
                end
              end
            end
          end
        else
          -- out of the new-rig budget: retry this child on the next frame
          break
        end
      end
    end
  end

  -- Sweep complete: publish. Truncate the reused table first so entries from
  -- the previous sweep cannot leak into the new list.
  if npc_sweep_active and npc_kid_idx>=nkids then
    local nextl=NPC_NEXT
    for i=#nextl,npc_next_n+1,-1 do nextl[i]=nil end
    if NPC_HELI then
      npc_next_n=npc_next_n+1
      nextl[npc_next_n]=NPC_HELI
    end
    local tmp=NPC_LIST
    NPC_LIST=nextl
    NPC_NEXT=tmp
    npc_sweep_active=false
    -- drop entries for NPCs that are no longer in the folder, so the table stays
    -- bounded and a recycled address cannot inherit a dead rig's bones
    for k,v in pairs(NPC_LIVE) do
      if type(v)=="table" and v.seen~=npc_sweep_id then NPC_LIVE[k]=nil end
    end
    -- the root/part cache is keyed on instance wrappers, which are not stable
    -- between calls, so it would gain an entry per rig per sweep otherwise.
    -- every rig that survives is already held in NPC_LIVE, so nothing is lost.
    for k in pairs(NPC_ROOT_CACHE) do NPC_ROOT_CACHE[k]=nil end
    cache_npcs=NPC_LIST
  end
end

-- Chroma support for the NPC pass. Both helpers write into a caller-supplied
-- scratch table: hsv()/hue_or() return a fresh table per call, and at 40 NPCs
-- x 7 colours that is thousands of throwaway tables a second. NPC_COL.ch is
-- the one scratch every tinted element shares.
PF.hue_fill=function(t,h,s,v)
  h=(h%1)*6
  local i=math.floor(h)
  local f=h-i
  local p=v*(1-s)
  local q=v*(1-s*f)
  local u=v*(1-s*(1-f))
  local r,g,b
  if i==0 then r,g,b=v,u,p
  elseif i==1 then r,g,b=q,v,p
  elseif i==2 then r,g,b=p,v,u
  elseif i==3 then r,g,b=p,q,v
  elseif i==4 then r,g,b=u,p,v
  else r,g,b=v,p,q end
  t[1]=r; t[2]=g; t[3]=b
  return t
end
-- returns base untouched when chroma is off, so the non-chroma path never
-- mutates the shared scratch and stays allocation-free
PF.tint=function(c,base,al)
  if not c then return base end
  c[4]=(base[4] or 1)*(al or 1)
  return c
end

-- China Hat for NPCs: the player ESP's cone, laid out in screen space from the
-- head point and the probe's pixels-per-stud scale. That removes the 17 world
-- projections per NPC per frame the wireframe used to pay, and keeps the cone
-- glued to the head at any distance. sq is the brim squash from the camera's
-- elevation above the rig, so the ring reads as an ellipse seen from above
-- rather than a flat circle. Lives on PF rather than in a new main-level local
-- so the chunk stays inside its 200-local budget. Returns the apex y when the
-- cone was drawn, so the caller can lift the name row above it.
PF.npc_hat=function(px,py,pps,hs,c,sq)
  if not px or not py or not pps or pps<=0 then return nil end
  -- same squash floor as the player hat: edge-on the ring is degenerate and the
  -- host drops it, which read as the cone going sharp and then disappearing
  if not sq or sq<0.25 then sq=0.25 elseif sq>1 then sq=1 end
  local rad=0.62*hs*pps
  local brimy=py-0.44*hs*pps
  local apex=py-1.16*hs*pps
  if rad<3 then
    -- below ~3px the rim segments and ribs land on the same pixels and the black
    -- shadow pass of every line wins; one filled silhouette keeps the colour
    if draw.PolyFilled then
      draw.PolyFilled({{px,apex},{px+rad,brimy},{px-rad,brimy}},c)
    else
      draw.Line(px,apex,px+rad,brimy,c,1)
      draw.Line(px+rad,brimy,px-rad,brimy,c,1)
      draw.Line(px-rad,brimy,px,apex,c,1)
    end
    return apex
  end
  local hc,hsn=PF.hc,PF.hs
  local xs,ys=PF.xs,PF.ys
  local seg=16
  for i=1,seg do
    xs[i]=px+hc[i]*rad
    ys[i]=brimy+hsn[i]*rad*sq
  end
  -- one closed polyline for the brim (16 draw.Line calls, each with its own
  -- shadow pass, become one call), with reused point tables. Same fallback as
  -- the player hat on a build without draw.PolyClosed.
  local pc=draw.PolyClosed
  local ring=PF.ring
  if type(pc)=="function" then
    for i=1,seg do
      local p=ring[i]
      if not p then p={0,0}; ring[i]=p end
      p[1]=xs[i]; p[2]=ys[i]
    end
    for i=seg+1,#ring do ring[i]=nil end
    pc(ring,c,1)
  else
    for i=1,seg do local j=i%seg+1; draw.Line(xs[i],ys[i],xs[j],ys[j],c,1) end
  end
  for i=1,seg,2 do draw.Line(px,apex,xs[i],ys[i],c,1) end
  return apex
end

local function run_npc_esp_h()
  if not cfg.npc_esp_enabled then return end
  -- the sweep is stepped once per frame from OnFrame; stepping it here too
  -- would double the per-frame work
  local list=cache_npcs or NPC_LIST
  if #list==0 then return end
  local sw,sh=scr()
  local maxd=cfg.npcs_max_dist or 300*M_PER_STUD
  if maxd<1 then maxd=300*M_PER_STUD end
  -- the row stops at 300 game metres; clamp in case a saved config predates it
  if maxd>300*M_PER_STUD then maxd=300*M_PER_STUD end
  -- slider is metres, the cull is in studs: 300m ~ 1071 studs, so squaring the
  -- slider directly culled targets that the distance row said were in range
  local maxsq=maxd*maxd/NPC_COL.m2
  local ox,oy,oz=npc_origin()
  -- camera position + forward for the behind-camera cull below, from the same
  -- per-frame memo the rest of the overlay uses
  local vw=PF.getview()
  local cpx,cpy,cpz,cfx,cfy,cfz=vw.cx,vw.cy,vw.cz,vw.fx,vw.fy,vw.fz
  local tsz=cfg.npcs_font_size or 13
  -- one hue clock per frame for Chroma NPC; the per-NPC offset further down
  -- spreads neighbouring targets across the wheel so they do not pulse together
  NPC_COL.chue=cfg.npc_chroma and now()*0.12 or 0
  local skel_col=col.npc_skel_col
  if type(skel_col)~="table" or #skel_col<3 then skel_col=NPC_COL.skel
  elseif #skel_col==3 then skel_col={skel_col[1],skel_col[2],skel_col[3],1} end
  -- box swatch resolved once per frame, not once per NPC: the picker always
  -- stores four channels, so the copy only happens if a 3-channel value sneaks in
  local box_col=col.npc_box_col
  if type(box_col)~="table" or #box_col<3 then box_col=NPC_COL.box
  elseif #box_col==3 then box_col={box_col[1],box_col[2],box_col[3],1} end
  -- skeletons resolve their bone array on first draw and keep it on the entry
  for i=1,#list do
    local n=list[i]
    -- the patrol heli is not an NPC: it has its own toggle, so it can be shown
    -- or hidden without touching the Name row (and without the scan/aim passes
    -- losing it, which key off the entry itself)
    if n and not (n.is_heli and not cfg.npcs_heli) then
      -- the heli has its own hardcoded ceiling instead of the NPC Range
      -- slider, so moving the slider never hides or reveals it
      local lim=n.is_heli and NPC_COL.heli2 or maxsq
      -- cheap cull first: the scan already recorded a position, so anything well
      -- outside the range never pays for a live read or a projection.
      local near=true
      if ox and n.x then
        local cdx=n.x-ox; local cdy=n.y-oy; local cdz=n.z-oz
        near=((cdx*cdx+cdy*cdy+cdz*cdz)<=lim*1.44)
      end
      local wx,wy,wz=nil,nil,nil
      if near then
        -- read the root live: the scan only refreshes a few times a second, and
        -- drawing from cached coordinates made the overlay lag behind the target.
        wx,wy,wz=bone_xyz(n.root)
        if not wx then wx,wy,wz=n.x,n.y,n.z end
      end
      -- behind-camera cull on the live root: the projection, the probe and the
      -- whole bone pass are skipped for a rig the camera cannot see
      if wx and cfx then
        local ax,ay,az=wx-cpx,wy-cpy,wz-cpz
        if ax*cfx+ay*cfy+az*cfz<=0 then wx=nil end
      end
      if wx then
        local d_sq=0
        if ox then
          local dx=wx-ox; local dy=wy-oy; local dz=wz-oz
          d_sq=dx*dx+dy*dy+dz*dz
        end
        if d_sq<=lim then
          local sx,sy=npc_proj(wx,wy,wz,sw,sh)
          -- A point behind the camera still projects onto the screen (mirrored),
          -- which is why targets behind you could draw at a random spot. There
          -- is no camera object on every build, but world-up maps to screen-down
          -- behind the camera, so a one-stud probe is a cheap tell. The same
          -- probe gives the pixels-per-stud scale at the target's depth.
          local behind=false
          local pps=0
          if sx then
            local okp,_,py2=pcall(draw.WorldToScreen,wx,wy+1,wz)
            if okp and type(py2)=="number" then
              pps=sy-py2
              behind=pps<-1
            end
          end
          -- Hardcoded corpse filter, re-read live so a target that dies between
          -- sweeps vanishes immediately instead of waiting for the next pass.
          -- The Humanoid wrapper is cached on the entry by the scan, and the read
          -- is staggered over three frames per rig: a corpse still disappears
          -- within ~50 ms, but the health call no longer runs for every NPC on
          -- every frame.
          local dead=(n.hp or 1)<=0
          local hum=n.hum
          if hum and (not n.hpn or FRAME>=n.hpn) then
            local okh,hv=pcall(PF.hp,hum)
            if okh and type(hv)=="number" then
              n.hp=hv
              if hv<=0 then dead=true end
            end
            n.hpn=FRAME+3
          end
          if sx and not behind and not dead then
            -- n.color is the swatch table itself, so only copy when it is short
            -- of an alpha. the old unconditional copy was one table per NPC per
            -- frame, every frame, for a value the name/dist pickers override anyway.
            local ncol=n.color
            if type(ncol)~="table" or #ncol<3 then ncol=NPC_COL.def
            elseif #ncol==3 then ncol={ncol[1],ncol[2],ncol[3],1} end
            -- one hue per NPC, offset by list index, shared by every element
            -- below. PF.tint returns the base swatch untouched when this is nil.
            local cch=nil
            if cfg.npc_chroma then cch=PF.hue_fill(NPC_COL.ch,(NPC_COL.chue+i*0.07)%1,0.8,1) end
            -- One projection pass per NPC per frame. Every element below reads
            -- the shared screen arrays instead of re-reading and re-projecting
            -- the same bones: the old path walked the head and a foot again for
            -- the box, the head again for the dot and the whole rig again for the
            -- skeleton. That was thousands of extra host calls per frame once a
            -- lot of NPCs were on screen, which is what dragged the FPS down.
            local arr=nil
            if not n.is_heli then
              arr=n.bones
              if not arr then
                arr=npc_bone_array(n.inst or n.obj)
                n.bones=arr
              end
            end
            -- The skeleton is only worth projecting while it is more than a few
            -- pixels tall: below ~1.5 px per stud (about 180 m) the 12 links land
            -- on the same handful of pixels but still cost the same 15 reads and
            -- 15 projections. A failed probe (pps<=0) keeps the full rig, since
            -- the size is unknown.
            local want_skel=cfg.npc_skeleton and arr~=nil and (pps<=0 or pps>=1.5)
            if arr then npc_project_bones(arr,sw,sh,want_skel) end
            -- Screen rect for this NPC, shared by the box, the health bar and the
            -- text rows. The probe's pixels-per-stud gives the real projected
            -- size of a ~5.6-stud rig at any range, so the box hugs the NPC up
            -- close instead of being clipped by a fixed pixel cap. The measured
            -- bone span is only trusted when it agrees with that estimate, which
            -- is what keeps a near-plane bone from blowing the rect up.
            local box_x,box_y,box_w,box_h
            if cfg.npc_box or cfg.npcs_show_health or cfg.npcs_show_name or cfg.npcs_show_dist
              or cfg.npc_headdot or n.is_heli then
              local expect=(pps>0.05 and pps*5.6) or 0
              local hh2=0
              if n.is_heli then
                local tx,ty2=npc_proj(wx,wy+5,wz,sw,sh)
                local ux,uy2=npc_proj(wx,wy-5,wz,sw,sh)
                if tx and ux and uy2>ty2 then hh2=uy2-ty2 end
                expect=expect*1.8
              else
                -- crown and sole come straight from the projection pass above;
                -- the half-stud offsets are applied in screen space with the
                -- probe's pixels-per-stud, so no extra reads or projections
                local tx,ty2,ux,uy2
                if NPC_POK[1] then tx,ty2=NPC_PX[1],NPC_PY[1]-0.55*pps end
                local fi=NPC_POK[12] and 12 or 15
                if NPC_POK[fi] then ux,uy2=NPC_PX[fi],NPC_PY[fi]+0.35*pps end
                if tx and ux and uy2>ty2 then hh2=uy2-ty2 end
              end
              local hh
              if hh2>0 and (expect<=0 or (hh2<=expect*2.2 and hh2>=expect*0.4)) then
                hh=hh2
              elseif expect>4 then
                hh=expect
              else
                -- no usable probe or bones (R6 rig, odd build): distance curve.
                -- This one stays in real metres - the 1530 constant is tuned to
                -- that scale - so it must not switch to the stud readout.
                local dm0=math.floor(math.sqrt(d_sq)*NPC_COL.m)
                hh=clamp(1530/math.max(1,dm0),24,190)*(n.is_heli and 1.26 or 0.9)
              end
              -- last-resort guard: never let one target fill more than two screens
              if hh>sh*2 then hh=sh*2 end
              box_h=hh
              box_w=hh*(n.is_heli and 1.6 or 0.42)
              box_x=sx-box_w*0.5
              box_y=sy-box_h*0.5
            end
            -- the patrol heli is a vehicle, not an NPC: only its name and
            -- distance are drawn, never the tag, box or health bar.
            if cfg.npc_box and not n.is_heli then
              local style=cfg.npc_boxstyle or 1
              local bcol=PF.tint(cch,box_col,1)
              if style==3 then
                -- same picture set as the player box: the combo index selects
                -- the portrait, and the plain rectangle stands in until it loads
                local tex=pic_tex(cfg.npc_picstyle or 1)
                if tex then
                  -- same opacity rule as the player Picture box: the photo fills
                  -- the box edge to edge, tinted only by the swatch's alpha
                  local pop=clamp(cfg.npc_pic_opacity or 100,10,100)/100
                  local al=math.floor(clamp(box_col[4] or 1,0,1)*pop*255+0.5)
                  if al>0 then draw.Image(tex,box_x,box_y,box_w,box_h,255,255,255,al) end
                else
                  -- texture still downloading: plain box for now
                  draw.Rect(box_x,box_y,box_w,box_h,bcol,0,1)
                end
              elseif style==1 then
                if draw.CornerBox then draw.CornerBox(box_x,box_y,box_w,box_h,bcol) else draw.Rect(box_x,box_y,box_w,box_h,bcol,0,1) end
              else
                draw.Rect(box_x,box_y,box_w,box_h,bcol,0,1)
              end
            end
            -- Name above the target, distance below it, both centred on the box,
            -- exactly the way the player ESP stacks them. The rect is computed
            -- for these rows too, so the name clears the head instead of sitting
            -- on the torso even with Box off.
            local cx=box_x and (box_x+box_w*0.5) or sx
            local name_y=box_y and (box_y-tsz-4) or (sy-tsz-4)
            -- China Hat: same cone as the player ESP, anchored to this NPC's
            -- Head bone and drawn before the text rows so the name can be
            -- lifted above the apex when the hat would otherwise cover it.
            if cfg.npc_hat and not n.is_heli and NPC_POK[1] and pps>0 then
              -- brim squash: the camera's elevation above this rig decides how
              -- open the ring looks. The head sits ~1.6 studs above the root we
              -- have here; looking down on a target it opens into a full
              -- ellipse, and the floor inside npc_hat keeps it a cone edge-on.
              local sq=1
              if cpx then
                local hx2,hy2,hz2=wx-cpx,(wy+1.6)-cpy,wz-cpz
                local hl=math.sqrt(hx2*hx2+hy2*hy2+hz2*hz2)
                if hl>0.001 then sq=math.abs(hy2)/hl end
              elseif cfy then
                sq=math.abs(cfy)
              end
              if sq>1 then sq=1 end
              local ay=PF.npc_hat(NPC_PX[1],NPC_PY[1],pps,(cfg.npc_hat_size or 100)/100,
                PF.tint(cch,col.npc_hat_col or NPC_COL.hat,1),sq)
              if ay and ay<name_y then name_y=ay-tsz-4 end
            end
            -- the heli label rides on its own toggle, so it still draws with the
            -- Name row off; the tag has to clear it in that case too
            local has_name=cfg.npcs_show_name or n.is_heli
            if cfg.npc_tag and not n.is_heli then
              -- "NPC" tag sits directly above the name row, so the target type
              -- reads before the name does. with Name off it takes that slot.
              local tag_sz=math.max(8,tsz-2)
              local tag_y=has_name and (name_y-tag_sz-2) or name_y
              local tw=n.tag_w
              if not tw or n.tag_sz~=tag_sz then
                tw=0
                if draw.GetTextSize then tw=draw.GetTextSize("NPC",tag_sz) or 0 end
                n.tag_w=tw; n.tag_sz=tag_sz
              end
              draw.Text(cx-tw*0.5, tag_y, "NPC", PF.tint(cch,col.npc_tag_col or ncol,1), tag_sz)
            end
            if has_name then
              local txt=n.name
              if type(txt)~="string" then txt=tostring(txt or "NPC") end
              local tw=n.name_w
              if not tw or n.name_tsz~=tsz then
                tw=0
                if draw.GetTextSize then tw=draw.GetTextSize(txt,tsz) or 0 end
                n.name_w=tw; n.name_tsz=tsz
              end
              local nc=ncol
              if n.is_heli then nc=col.npc_heli_col or ncol
              else nc=col.npc_name_col or ncol end
              draw.Text(cx-tw*0.5, name_y, txt, PF.tint(cch,nc,1), tsz)
            end
            if cfg.npcs_show_dist then
              -- cache the label per whole game metre (a stud). Formatting a new
              -- string and measuring it for every NPC every frame was pure
              -- garbage, and the integer only changes when the target moves a
              -- metre
              local dm=math.floor(math.sqrt(d_sq))
              local dtxt=n.dtxt
              if not dtxt or n.dm~=dm or n.dtsz~=tsz then
                dtxt=string.format("[%dm]",dm)
                local w=0
                if draw.GetTextSize then w=draw.GetTextSize(dtxt,tsz-2) or 0 end
                n.dtxt=dtxt; n.dtw=w; n.dm=dm; n.dtsz=tsz
              end
              local dist_y=box_y and (box_y+box_h+3) or (sy+4)
              draw.Text(cx-(n.dtw or 0)*0.5, dist_y, dtxt, PF.tint(cch,col.npc_dist_col or ncol,1), tsz-2)
            end
            if want_skel then
              -- Bones were projected once at the top of this NPC; just stroke the
              -- links out of the shared arrays. No reads, no projections, no
              -- allocations here. Connected paths go out as one polyline each
              -- (14 Line calls -> 5 polys); a path with a bone culled off screen
              -- falls back to per-link lines.
              local scol=PF.tint(cch,skel_col,1)
              local chains=PF.npc_chains
              local poly=draw.Poly
              local can_poly=type(poly)=="function"
              for ci=1,#chains do
                local chn=chains[ci]
                local nodes=chn.nodes
                local n=#nodes
                -- 2-point paths stay on the line branch (see the player rig)
                local all=can_poly and n>2
                if all then
                  for k=1,n do if not NPC_POK[nodes[k]] then all=false; break end end
                end
                if all then
                  local pts=chn.pts
                  for k=1,n do
                    local i=nodes[k]
                    local p=pts[k]
                    p[1]=NPC_PX[i]; p[2]=NPC_PY[i]
                  end
                  poly(pts,scol,1)
                else
                  for k=1,n-1 do
                    local a,b=nodes[k],nodes[k+1]
                    if NPC_POK[a] and NPC_POK[b] then
                      draw.Line(NPC_PX[a],NPC_PY[a],NPC_PX[b],NPC_PY[b],scol,1)
                    end
                  end
                end
              end
            end
            -- Head dot: the player ESP's world-space ring, on the NPC's Head
            -- bone. The radius is 1.24 studs of head projected at the target's
            -- depth and halved, which is exactly the old probe without the extra
            -- world read and projection. Box height is the fallback.
            if cfg.npc_headdot and arr and NPC_POK[1] then
              local hs=(cfg.npc_headdot_size or 100)/100
              local hr=pps>0 and (0.62*hs*pps) or nil
              if not hr and box_h then hr=box_h*0.11*hs end
              if hr and hr>0.4 then
                local dcol=PF.tint(cch,skel_col,1)
                if hr<2.4 then
                  -- at this size the outline and its shadow overlap and read
                  -- as a black smudge, so keep a filled pip like the players
                  draw.CircleFilled(NPC_PX[1],NPC_PY[1],math.max(hr,1.6),dcol,10)
                else
                  draw.Circle(NPC_PX[1],NPC_PY[1],hr,dcol,math.max(10,math.floor(hr*3)),1)
                end
              end
            end
            if cfg.npcs_show_health and not n.is_heli then
              local hp=n.hp or 100; local mh=n.max_hp or 100
              if mh<1 then mh=100 end
              -- vertical bar hugging the left edge of the target, same as the
              -- player ESP: the gap tracks the box width so it stays close at
              -- range instead of drifting off to the left
              local gap=clamp(box_w*0.12,1.5,5)
              local bxx=box_x-gap; local byy=box_y; local bhh=box_h
              if draw.HealthBar then
                pcall(draw.HealthBar,bxx,byy,bhh,hp,mh)
              else
                -- no native helper on this build: draw the same track and fill
                -- by hand, filled from the bottom like a vertical bar should be
                local pct=clamp(hp/mh,0,1)
                draw.RectFilled(bxx,byy,3,bhh,NPC_COL.hp_bg,1)
                if pct>0 then
                  draw.RectFilled(bxx,byy+bhh*(1-pct),3,bhh*pct,NPC_COL.hp[math.floor(pct*20+0.5)],1)
                end
              end
            end
          end
        end
      end
    end
  end
end

local function run_gunmods()
  -- weapon-stat patches: one GC scan, then memory writes only. Applies once
  -- (after a short settle) or on the Re-apply button - never on a timer.
  pcall(setgc_apply)
end

-- One player's candidate scan. This used to be an inline closure built inside
-- the player loop, which meant a fresh closure plus an upvalue cell per captured
-- local for every player, every frame, purely to get the body inside a pcall.
-- As a named function nothing is captured: the pass parameters ride on AIM_ST
-- (already the scorer's state table) and pcall can take the function directly.
local function aim_player(p,lp)
  local fl=PF.pflag(p)
  if not p.IsValid or p==lp or fl.il or fl.al==false then return end
  if cfg.aim_team and esp_mate(p,lp) then return end
  local char=nil
  local okc,cv=pcall(PF.char,p)
  if okc then char=cv end
  if not char then return end
  local nm=p.Name
  local style=AIM_ST.style
  -- health is only read when the priority is Low HP: it used to be a host
  -- call per player per frame even with the default Crosshair priority
  local health=100
  if style==3 then
    local okh0,hv0=pcall(PF.hp,p)
    if okh0 then health=tonumber(hv0) or 100 end
  end
  local cx,cy=AIM_ST.cx,AIM_ST.cy
  local r,fstyle=AIM_ST.r,AIM_ST.fstyle
  local aimbone=cfg.aim_bone or 1
  local blist=PF.aimset[aimbone] or AIM_BONES
  if aimbone==8 then
    -- Closest to Crosshair: every on-screen bone is a candidate, but only
    -- the ones already inside the FOV pay for a part lookup, a position read
    -- and the Wall Check walk inside aim_try. ONE GetBonesScreen
    -- call replaces 17 FindFirstChild + 17 position reads + 17 projections
    -- per player per frame, and on a busy server most players are nowhere
    -- near the crosshair, so they now cost a single call. The dictionary is
    -- shared with the ESP skeleton through PF.bonesmemo.
    local bs=PF.bonesmemo(p)
    if not bs then return end
    local any=false
    for bi=1,#blist do
      local b=bs[blist[bi]]
      if b and b[1] and b[2] then
        any=true
        if aim_in_fov(b[1]-cx,b[2]-cy,r,fstyle) then
          local okf,pr=pcall(PF.find,char,blist[bi])
          if okf and pr then
            local okp,pp=pcall(PF.pos,pr)
            if okp and pp then aim_try(pp.X,pp.Y,pp.Z,pr,p,nm,health,char) end
          end
        end
      end
    end
    if not any then
      local okhp,hp=pcall(PF.head,p)
      if okhp and hp then aim_try(hp.X,hp.Y,hp.Z,nil,p,nm,health,char) end
    end
  else
    -- named bone: the first part that resolves wins, same as before
    local part,hx,hy,hz
    for bi=1,#blist do
      local okf,pr=pcall(PF.find,char,blist[bi])
      if okf and pr then
        local okp,pp=pcall(PF.pos,pr)
        if okp and pp then part=pr; hx,hy,hz=pp.X,pp.Y,pp.Z; break end
      end
    end
    if not hx and aimbone==1 then
      local okhp,hp=pcall(PF.head,p)
      if okhp and hp then hx,hy,hz=hp.X,hp.Y,hp.Z end
    end
    if not part then
      local okf,pr=pcall(PF.find,char,"HumanoidRootPart")
      if okf and pr then
        part=pr
        if not hx then
          local okp,pp=pcall(PF.pos,pr)
          if okp and pp then hx,hy,hz=pp.X,pp.Y,pp.Z end
        end
      end
    end
    if hx then aim_try(hx,hy,hz,part,p,nm,health,char) end
  end
end
local function run_aim()
  aim_tgt=nil
  -- mouse aim only: the aimbot always moves the cursor, it never turns the
  -- camera, so there is no type switch to read.
  if not cfg.aim_on then return end
  local vw=PF.getview()
  local lp=vw.lp
  local players=PF.players()
  if not players then return end
  local cx,cy=aim_center()
  local r=cfg.aim_fov or 160
  local style=cfg.aim_priority or 1
  local fstyle=cfg.aim_fovstyle or 1
  -- the range row is metres; every cull below, and AIM_ST.maxdist, works in studs
  local maxdist=(cfg.aim_range or 1500)/PF.m
  -- Held-weapon lookup, re-run only on a swap. It sits above the range cull so
  -- the Bow Lead & Drop cap always sees the bow that is actually in your hands rather
  -- than last frame's, and the lead pass at the bottom of this function reuses
  -- the cached speed, gravity and bow numbers instead of reading them twice.
  if cfg.aim_pred or cfg.aim_bowdrop then
    local tname=""
    local okt,tv=pcall(PF.tool,lp)
    if okt and type(tv)=="string" then tname=tv end
    if tname=="" and lp then
      local okc,ch=pcall(PF.char,lp)
      if okc and ch then
        local fn=ch.FindFirstChildOfClass
        if type(fn)=="function" then
          local okf,tl=pcall(fn,ch,"Tool")
          if okf and tl then
            local okn,nv=pcall(PF.name,tl)
            if okn and type(nv)=="string" then tname=nv end
          end
        end
      end
    end
    if tname~=AIM_ST.gname then
      AIM_ST.gname=tname
      local sp,gr,bw=0,8,false
      if tname~="" and not is_melee_or_utility_tool(tname) then
        local low=tname:lower()
        for gi=1,#PF.bows do
          if low:find(PF.bows[gi][1],1,true) then
            bw=true; gr=PF.bows[gi][4]
            -- full-draw speed, held constant so the aim point does not move
            -- with the draw charge
            sp=PF.bows[gi][2]+PF.bows[gi][3]; break
          end
        end
        if not bw then
          for gi=1,#PF.guns do
            if low:find(PF.guns[gi][1],1,true) then
              sp=PF.guns[gi][2]; gr=PF.guns[gi][3]; break
            end
          end
          if sp<=0 then sp=1400 end
        end
      end
      AIM_ST.gspeed=sp; AIM_ST.ggrav=gr; AIM_ST.gbow=bw
    end
  end
  -- Bow lead & drop holds up out to 300 game metres, so the aim range is capped while
  -- an arrow is what is actually being compensated. Every range in this function
  -- is already in studs and the game counts one stud as one metre, so the cap is
  -- a plain 300 - the same unit the distance labels print.
  if cfg.aim_bowdrop and AIM_ST.gbow and maxdist>300 then maxdist=300 end
  local camx,camy,camz=vw.cx,vw.cy,vw.cz
  -- Aim pass: players first, then NPCs below. Scoring lives in aim_try, and the
  -- per-player scan lives in aim_player, so this loop allocates nothing at all
  -- (it used to build a table per bone per player per frame, two closures per
  -- bone, and one wrapper closure per player).
  local aimbone=cfg.aim_bone or 1
  AIM_ST.cx,AIM_ST.cy=cx,cy
  AIM_ST.r=r; AIM_ST.fstyle=fstyle; AIM_ST.style=style
  -- Players are only engaged inside the Player Range row, the same way the NPC
  -- pass honours NPC Range, so the aimbot can never lock a target the player ESP
  -- is hiding. Aimbot Range stays the outer bound: whichever is smaller wins.
  -- aim_try culls on AIM_ST.maxdist, so narrow it for this pass and put it back
  -- afterwards, leaving the NPC pass measuring against Aimbot Range.
  AIM_ST.aimmax=maxdist
  AIM_ST.maxdist=maxdist
  if cfg.esp_maxdist and cfg.esp_maxdist/PF.m<AIM_ST.maxdist then AIM_ST.maxdist=cfg.esp_maxdist/PF.m end
  AIM_ST.camx,AIM_ST.camy,AIM_ST.camz=camx,camy,camz
  AIM_ST.best=nil; AIM_ST.best_s=nil
  for i=1,#players do pcall(aim_player,players[i],lp) end
  -- Player Range only bound the player pass; the NPC pass below measures against
  -- Aimbot Range (then narrows to NPC Range itself).
  AIM_ST.maxdist=AIM_ST.aimmax
  local best,best_s=AIM_ST.best,AIM_ST.best_s
  -- NPC pass: same scorer, fed by the NPC snapshot the ESP scanner keeps warm.
  -- Its own toggle, so NPC ESP can stay off. Skipped once a player is dead-centre
  -- on the crosshair, and skipped entirely when "Target Players over NPC & Heli"
  -- is on and a player is already in the FOV, so an NPC can never steal a shot
  -- from a visible player.
  if cfg.aim_npc and best_s~=0 and not (cfg.aim_pp and best~=nil) then
    local list=cache_npcs or NPC_LIST
    -- NPCs are only engaged inside the NPC ESP Range row, so the aimbot
    -- can never lock onto a rig the NPC ESP is hiding. The aimbot range still
    -- applies as the outer bound - whichever of the two is smaller wins. aim_try
    -- culls on AIM_ST.maxdist, so narrow it for this pass and put it back after.
    AIM_ST.aimmax=AIM_ST.maxdist
    AIM_ST.nmax=cfg.npcs_max_dist or 300*M_PER_STUD
    if AIM_ST.nmax<1 then AIM_ST.nmax=300*M_PER_STUD end
    if AIM_ST.maxdist>AIM_ST.nmax/PF.m then AIM_ST.maxdist=AIM_ST.nmax/PF.m end
    -- NPC_BONES order: 1 Head, 2-3 torso, 4-9 arms, 10-15 legs. index 0 is the
    -- root part, which is not in the bone array.
    local i0,i1
    if aimbone==1 then i0,i1=1,1
    elseif aimbone==2 then i0,i1=2,3
    elseif aimbone==3 then i0,i1=0,0
    elseif aimbone==4 then i0,i1=4,6
    elseif aimbone==5 then i0,i1=7,9
    elseif aimbone==6 then i0,i1=10,12
    elseif aimbone==7 then i0,i1=13,15
    else i0,i1=1,15 end
    for ni=1,#list do
      local n=list[ni]
      -- the heli rides in this list for the ESP, but it has no humanoid rig: it
      -- is aimed at by its own block below, never by a bone lookup
      if n and n.inst and (n.hp or 1)>0 and not n.is_heli then
        local arr=n.bones
        if not arr then
          local okb,b=pcall(npc_bone_array,n.inst)
          if okb then arr=b end
          n.bones=arr
        end
        if arr then
          for k=i0,i1 do
            local pr
            if k==0 then pr=n.root else pr=arr[k] end
            if pr then
              local hx,hy,hz=bone_xyz(pr)
              if hx then aim_try(hx,hy,hz,pr,n.inst,n.name,n.hp or 100,n.inst) end
            end
          end
        end
      end
    end
    AIM_ST.maxdist=AIM_ST.aimmax
    best=AIM_ST.best; best_s=AIM_ST.best_s
  end
  -- Patrol heli: its own toggle, its own ceiling and its own aim point. A heli
  -- has no humanoid rig, so it never enters the bone loop above - the fuselage
  -- part the NPC scan already resolved is the target. Range is the same 1000
  -- game metres the ESP gives it, still under Aimbot Range, and the
  -- "Target Players over NPC & Heli" row applies to it exactly like an NPC, so it
  -- can never steal a shot from a player already under the crosshair. It sits
  -- outside the Target NPC block so the heli can be aimed at on its own.
  if cfg.aim_heli and best_s~=0 and not (cfg.aim_pp and best~=nil) then
    local h=NPC_HELI
    if h and h.inst and h.root then
      local hl=1000/PF.m
      if AIM_ST.maxdist>hl then AIM_ST.maxdist=hl end
      local hx,hy,hz=bone_xyz(h.root)
      if hx then aim_try(hx,hy,hz,h.root,h.inst,"Patrol Helicopter",h.hp or 5000,h.inst) end
      AIM_ST.maxdist=AIM_ST.aimmax
      best=AIM_ST.best; best_s=AIM_ST.best_s
    end
  end
  -- Auto gun lead + bow lead & drop.
  -- The held tool is read on every swap, so the speed, fall rate and class used
  -- below always match what is in your hands. Nothing here is a setting: the
  -- prediction for the weapon you are holding is picked from that weapon's own
  -- numbers.
  --
  -- Both classes use the whole flight time. An arrow is flown by the server, and
  -- a bullet is resolved from the shot the client sends (origin + direction) once
  -- the server has it, so in both cases the target keeps travelling until the
  -- round gets there. Cutting the lead back by an assumed network lag left the
  -- crosshair consistently behind a strafing target, so the lag term is gone and
  -- the lead is the plain v * tof projection the bow already used.
  -- Melee and utility tools get nothing, and neither does an empty hand.
  if cfg.aim_pred or cfg.aim_bowdrop then
    -- Arrow speed is pinned to a full draw. Scaling it by the live draw charge
    -- made the drop compensation explode on a half-drawn arrow and yank the
    -- view upward during and right after the shot, so the aim point uses the
    -- top speed the bow can reach and stays put.
    local sp=AIM_ST.gspeed or 0
    local gbow=AIM_ST.gbow
    -- a gun is only predicted while Auto Gun Lead is on; an arrow is predicted
    -- whenever either helper is on, so turning one off cannot break the bow
    if sp>0 and best and camx and (gbow or cfg.aim_pred) then
      local dx0=best.x-camx; local dy0=best.y-camy; local dz0=best.z-camz
      local dist=math.sqrt(dx0*dx0+dy0*dy0+dz0*dz0)
      -- Target travel. The live root velocity is exact and carries none of the
      -- animation noise a bone-to-bone delta does, so it is used whenever the
      -- wrapper exposes it (players). NPC rigs have no Velocity, so those keep
      -- the old estimate from where the aim point was last frame.
      local vx,vy,vz=0,0,0
      local okv,lvx,lvy,lvz=pcall(PF.vel,best.obj)
      local live=okv and type(lvx)=="number"
      if live then
        vx,vy,vz=lvx,lvy,lvz
      else
        vx,vy,vz=AIM_ST.vx or 0,AIM_ST.vy or 0,AIM_ST.vz or 0
        -- a jump too big to be a walking target is a bone swap or a target
        -- switch, so the estimate resets instead of flinging the crosshair
        -- across the screen. the ceiling is a fast sprint, not the old
        -- 200 studs/s, which let a head-to-torso swap through as a shake.
        local px,py,pz=AIM_ST.px,AIM_ST.py,AIM_ST.pz
        if px and _dt and _dt>0.0001 then
          local mx,my,mz=best.x-px,best.y-py,best.z-pz
          if mx*mx+my*my+mz*mz<=(70*_dt)*(70*_dt) then
            vx=vx*0.55+(mx/_dt)*0.45
            vy=vy*0.55+(my/_dt)*0.45
            vz=vz*0.55+(mz/_dt)*0.45
          else
            vx,vy,vz=0,0,0
          end
        else
          vx,vy,vz=0,0,0
        end
        -- idle animation micro-movement is not travel: deadband it so the lead
        -- does not drift while a target stands still
        local vsp=math.sqrt(vx*vx+vy*vy+vz*vz)
        if vsp<2.5 then vx,vy,vz=0,0,0 end
        AIM_ST.vx,AIM_ST.vy,AIM_ST.vz=vx,vy,vz
      end
      AIM_ST.px,AIM_ST.py,AIM_ST.pz=best.x,best.y,best.z
      -- flight time to the bone, then one refinement at the lead point so the
      -- lead is not sized from a distance the target has already left
      local tof=dist/sp
      local qx=dx0+vx*tof; local qy=dy0+vy*tof; local qz=dz0+vz*tof
      tof=math.sqrt(qx*qx+qy*qy+qz*qz)/sp
      if tof>2 then tof=2 end
      local ax,ay,az=best.x,best.y,best.z
      -- The lead offset is low-passed in world space. The velocity sample is
      -- noisy frame to frame, and applying it raw made the crosshair buzz on
      -- both camera and mouse aim; the filter keeps the average lead while
      -- killing the per-frame jitter. It is seeded with the full lead on a new
      -- target instead of easing up from the last one (or from zero): that ramp
      -- was the other half of the under-prediction, leaving the crosshair behind
      -- for the first tenth of a second of every engagement.
      local lx,ly,lz=AIM_ST.lx,AIM_ST.ly,AIM_ST.lz
      if not lx or AIM_ST.lchar~=best.char then
        AIM_ST.lchar=best.char
        lx,ly,lz=vx*tof,vy*tof,vz*tof
      else
        -- 16 rather than 10: a strafe reversal has to swing the whole lead, and
        -- the slower filter spent ~0.2 s catching up. Arrows keep the old 10 -
        -- their lead is several times longer, so the same smoothing matters more
        -- there and the bow was already tracking well.
        local k=(_dt or 0.016)*(gbow and 10 or 16)
        if k>1 then k=1 end
        lx=lx+(vx*tof-lx)*k
        ly=ly+(vy*tof-ly)*k
        lz=lz+(vz*tof-lz)*k
      end
      AIM_ST.lx,AIM_ST.ly,AIM_ST.lz=lx,ly,lz
      ax=ax+lx
      ay=ay+ly
      az=az+lz
      local grav=AIM_ST.ggrav or 8
      if gbow then
        -- arrows: Bow Lead & Drop owns the holdover. Across the 300 game metre cap the
        -- longest flight is ~1.4 s (hunting bow), so the clamp only guards
        -- against a bad gravity read - it never shortens a real shot.
        if cfg.aim_bowdrop then
          local lift=0.5*grav*tof*tof
          if lift>400 then lift=400 end
          ay=ay+lift
        end
      elseif cfg.aim_pred then
        -- bullets: the drop is real over the whole flight, but a few studs at
        -- sniper range, so the cap sits well under a body
        local lift=0.5*grav*tof*tof
        if lift>40 then lift=40 end
        ay=ay+lift
      end
      if ax~=best.x or ay~=best.y or az~=best.z then
        local asx,asy,av=draw.WorldToScreen(ax,ay,az)
        if av then
          -- the crosshair is pulled to the predicted screen point; x/y/z keep
          -- the raw bone so the target line still ends on the bone
          best.sx,best.sy=asx,asy
        end
      end
    else
      -- no target, or a melee/empty hand: drop the sample so the next engage
      -- does not compute a lead from a stale point
      AIM_ST.px=nil
      AIM_ST.lx,AIM_ST.ly,AIM_ST.lz=nil,nil,nil
      AIM_ST.lchar=nil
    end
  else
    -- both toggles off: drop the sample and forget the cached gun, so switching
    -- either feature back on re-reads the held weapon and its prediction speed
    AIM_ST.px=nil
    AIM_ST.lx,AIM_ST.ly,AIM_ST.lz=nil,nil,nil
    AIM_ST.lchar=nil
    AIM_ST.gname=nil
  end
  aim_tgt=best
  local key=bind.aim_key or 0
  local held=(key~=0) and not ui.capture and ekey(key) or false
  local engaged=(held and best~=nil) or false
  local dz=cfg.aim_dz or 0
  if not engaged then
    aim_dz_state=0
    return
  end
  local sm=math.floor(cfg.aim_smooth or 1)
  if sm<1 then sm=1 end
  local ex,ey=best.sx-cx,best.sy-cy
  local dist=math.sqrt(ex*ex+ey*ey)
  if aim_dz_tgt~=best.name then aim_dz_state=0; aim_dz_tgt=best.name end
  local zs=dz
  local zstart=zs*2.2
  if aim_dz_state==1 then
    if dist>zstart then aim_dz_state=0 end
  elseif dist<=zs then
    aim_dz_state=1
  end
  if aim_dz_state==0 then
    if dist<0.5 then return end
    local sx,sy=aim_step(ex,ey,sm)
    if math.abs(sx)>0.001 or math.abs(sy)>0.001 then
      aim_emit(sx,sy)
    end
  end
end
local function draw_aim()
  if not cfg.aim_on then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  local r=cfg.aim_fov or 160
  local hue=(now()*0.12)%1
  local chroma=cfg.aim_fovchroma
  if cfg.aim_fovcircle then
    local cfov=col.c_fov or {0.45,0.78,1,1}
    local c=hue_or(chroma and hsv(hue,0.8,1) or nil,cfov,1)
    local st=cfg.aim_fovstyle or 1
    if st==1 then
      draw.Circle(cx,cy,r,c,48,1.2)
    elseif st==2 then
      xh_poly({{cx-r,cy-r},{cx+r,cy-r},{cx+r,cy+r},{cx-r,cy+r}},c,1.2)
    elseif st==3 then
      xh_poly({{cx,cy-r},{cx+r,cy},{cx,cy+r},{cx-r,cy}},c,1.2)
    else
      -- corner brackets: one horizontal and one vertical arm per corner
      local k=r*0.28
      draw.Line(cx-r,cy-r,cx-r+k,cy-r,c,1.2); draw.Line(cx-r,cy-r,cx-r,cy-r+k,c,1.2)
      draw.Line(cx+r,cy-r,cx+r-k,cy-r,c,1.2); draw.Line(cx+r,cy-r,cx+r,cy-r+k,c,1.2)
      draw.Line(cx-r,cy+r,cx-r+k,cy+r,c,1.2); draw.Line(cx-r,cy+r,cx-r,cy+r-k,c,1.2)
      draw.Line(cx+r,cy+r,cx+r-k,cy+r,c,1.2); draw.Line(cx+r,cy+r,cx+r,cy+r-k,c,1.2)
    end
  end
  -- active-state tag under the FOV region, so it is obvious which prediction
  -- helpers are running. Bow Lead & Drop is appended to the right of Auto Gun
  -- Lead, clamped to the screen so a huge FOV cannot push it off the bottom edge.
  local lbl=nil
  if cfg.aim_pred then lbl="(Auto Gun Lead)" end
  if cfg.aim_bowdrop then
    if lbl then lbl=lbl.." (Bow Lead & Drop)" else lbl="(Bow Lead & Drop)" end
  end
  if lbl then
    local lw=0
    if draw.GetTextSize then lw=draw.GetTextSize(lbl,12) or 0 end
    local ly=cy+r+8
    if ly>sh-14 then ly=sh-14 end
    local lc=hue_or(chroma and hsv(hue,0.8,1) or nil,col.c_fov or {0.45,0.78,1,1},1)
    draw.Text(cx-lw*0.5,ly,lbl,lc,12)
  end
  if cfg.aim_tline and aim_tgt then
    local tx,ty,tz=aim_tgt.x,aim_tgt.y,aim_tgt.z
    if aim_tgt.part and aim_tgt.part.Position then
      local pp=aim_tgt.part.Position
      tx,ty,tz=pp.X,pp.Y,pp.Z
    elseif aim_tgt.obj then
      local p=aim_tgt.obj
      local part=nil
      local aimbone=cfg.aim_bone or 1
      local blist=PF.aimset[aimbone] or AIM_BONES
      local char=nil
      local okc,cv=pcall(PF.char,p)
      if okc then char=cv end
      if char then
        for bi=1,#blist do
          local okf,pr=pcall(PF.find,char,blist[bi])
          if okf and pr then
            local okp,pp=pcall(PF.pos,pr)
            if okp and pp then part=pr; tx,ty,tz=pp.X,pp.Y,pp.Z; break end
          end
        end
      end
    end
    local sx,sy,vis=draw.WorldToScreen(tx,ty,tz)
    if vis then
      local ctl=col.c_tline or {1,1,1,1}
      local c=hue_or(chroma and hsv((hue+0.5)%1,0.8,1) or nil,ctl,1)
      draw.Line(cx,cy,sx,sy,c,1.2)
    end
  end
end

local function draw_menu()
  -- a queued window grab never outlives the frame that queued it
  ui.win_grab=nil
  local e=ease_out(ui.appear); if e<0.01 then return end
  theme.opacity=(cfg.ui_opacity or 100)/100 * e
  local x,y,w=ui.x,ui.y,ui.w

  local cx=x+SIDEBAR_W
  local cw=w-SIDEBAR_W
  local ctop=y+TOPBAR_H
  local ncol=2; local colw=(cw-PAD*2-GUT)/ncol; local colx={cx+PAD, cx+PAD+colw+GUT}

  -- Layout scratch, reused every frame: the section list and the two column
  -- heights were rebuilt as fresh tables on every frame the menu was open, for a
  -- layout that only changes when the tab or a row's visibility changes.
  local placed=ui.placed
  if not placed then placed={}; ui.placed=placed end
  local coly=ui.coly
  if not coly then coly={0,0}; ui.coly=coly end
  coly[1]=0; coly[2]=0
  local pn=0
  for _,g in ipairs(SCHEMA[ui.tab].groups) do
    local gh=30; for _,it in ipairs(g.items) do if row_visible(it) then gh=gh+row_h(it) end end
    local c=(coly[1]<=coly[2]) and 1 or 2
    pn=pn+1
    local pl=placed[pn]
    if not pl then pl={}; placed[pn]=pl end
    pl.g=g; pl.c=c; pl.oy=coly[c]; pl.h=gh
    coly[c]=coly[c]+gh+GUT
  end
  for i=pn+1,#placed do placed[i]=nil end
  local contentH=math.max(coly[1],coly[2]); if contentH>0 then contentH=contentH-GUT end
  local sideH=6+#SCHEMA*26
  ui.h=approach("winh", TOPBAR_H+math.max(contentH,sideH)+PAD, 18)
  local h=ui.h
  SNOW.update(72,w,h)

  -- soft drop shadow, then framed window
  for i=4,1,-1 do draw.RectFilled(x-i*2.5, y-i*1.5, w+i*5, h+i*4, {0,0,0,0.09*theme.opacity}, theme.round+i*2) end
  draw.RectFilled(x,y,w,h, {theme.base[1],theme.base[2],theme.base[3],0.94*theme.opacity}, theme.round)
  draw.RectFilled(x+theme.round,y,SIDEBAR_W,h-TOPBAR_H, {theme.base2[1],theme.base2[2],theme.base2[3],0.5*theme.opacity}, 0)
  -- topbar fades downward, lighter at the very top
  grad_v(x+theme.round,y,w-theme.round*2,TOPBAR_H,
    {theme.panel_hi[1],theme.panel_hi[2],theme.panel_hi[3],0.34*theme.opacity},
    {theme.panel[1],theme.panel[2],theme.panel[3],0.12*theme.opacity}, 48)
  -- crisp single frame, with a faint inner echo line for depth
  draw.Rect(x,y,w,h, a(theme.line,0.95), theme.round, 1)
  draw.Rect(x+3,y+3,w-6,h-6, a(theme.line,0.22), theme.round, 1)
  draw.Line(x+theme.round, y+TOPBAR_H, x+w-theme.round, y+TOPBAR_H, a(theme.line,0.6), 1)
  draw.Line(x+SIDEBAR_W, y+TOPBAR_H, x+SIDEBAR_W, y+h-theme.round, a(theme.line,0.5), 1)
  -- solid accent rule pinned to the top edge (no gradient steps = no banding)
  draw.RectFilled(x+theme.round, y, w-theme.round*2, 2, a(mix(theme.accent,theme.accent2,0.5), 0.92*e), 0)
  corners(x,y,w,h, 18, a(mix(theme.accent,theme.accent2,0.5), 0.95*e), 2, a(mix(theme.accent,theme.accent2,0.5), 0.5*e))

  -- brand lockup: Ego wordmark, diamond, then the product line
  local lw=ts("Ego",17)
  draw.Text(x+PAD,y+11,"Ego", a(theme.text,1),17)
  local dx,dy=x+PAD+lw+11, y+19
  if draw.PolyFilled then pcall(draw.PolyFilled, {{dx,dy-4},{dx+4,dy},{dx,dy+4},{dx-4,dy}}, a(theme.accent,1))
  else draw.RectFilled(dx-3,dy-3,6,6, a(theme.accent,1), 1) end
  -- product line, sat just past the diamond so it reads as part of the lockup
  tmid(dx+11, y, TOPBAR_H, "Fust Survival", a(theme.sub,1), 12)
  trt(x+w-PAD,y+12,16,"v1.3", a(theme.faint,1),10)

  -- vertical tab rail
  local sy=ctop+6
  for i,tab in ipairs(SCHEMA) do
    local label=string.lower(tab.name); local ty=sy+(i-1)*26
    local hot=inside(x+8,ty,SIDEBAR_W-16,24) and interactable()
    if hot and ui.m.click then ui.tab=i; ui.m.click=false end
    local act=approach("tab"..i,(ui.tab==i) and 1 or 0,18)
    if act>0.01 then
      draw.RectFilled(x+8,ty,SIDEBAR_W-16,24, a(theme.accent, 0.12*act), 2)
      -- slanted wedge instead of a plain bar
      local wq={{x+8,ty},{x+11,ty},{x+15,ty+24},{x+12,ty+24}}
      if draw.PolyFilled then pcall(draw.PolyFilled, wq, a(theme.accent,act)) else draw.RectFilled(x+8,ty,3,24, a(theme.accent,act), 0) end
      local qx, qy = x+SIDEBAR_W-19, ty+12
      for i=0,2 do
        draw.RectFilled(qx+i*2, qy-4+i*2, 1.4,1.4, a(theme.accent,act*0.8),0)
        draw.RectFilled(qx+i*2, qy+4-i*2, 1.4,1.4, a(theme.accent,act*0.8),0)
      end
    end
    tmid(x+18,ty,24,label, a(mix(theme.faint,theme.text,math.max(act, hot and 0.5 or 0)),1),12)
  end

  -- flat sections: numbered index + small caps label + hairline rule
  local secn=0
  for _,pl in ipairs(placed) do
    local g=pl.g; local gx=colx[pl.c]; local gy=ctop+pl.oy; local gh=pl.h
    secn=secn+1
    local num=string.format("%02d",secn)
    local nw=ts(num,10)
    draw.RectFilled(gx,gy, nw+7, 13, a(theme.accent,0.16), 2)
    draw.Text(gx+4, gy+2, num, a(theme.accent,0.95), 10)
    local caps=string.upper(g.name); local hw=ts(caps,11)
    draw.Text(gx+nw+13, gy+1, caps, a(theme.faint,1), 11)
    draw.Line(gx+nw+hw+21, gy+9, gx+colw, gy+9, a(theme.line,0.5), 1)
    local iy=gy+18
    for _,it in ipairs(g.items) do
      if row_visible(it) then local f=WI[it.t]; if f then f(it,gx,iy,colw) end iy=iy+row_h(it) end
    end
  end
  -- Whole-window drag grab, DEFERRED. This runs after the top bar, the tab rail
  -- and every widget have drawn, because each of those clears ui.m.click (or
  -- sets ui.drag) when it takes a press. So a click that is still unclaimed
  -- anywhere inside the window is empty space - the background, the gap between
  -- rows, a section header, a note row - and that is what grabs the panel.
  --
  -- It only records the grab here instead of taking it. run_hud draws after this
  -- function and its watermark / keybind / feature panels sit on top of the
  -- window, so a press on a panel has to reach that panel's own grab first. If
  -- the click is still unclaimed at the end of run_hud the window takes it then.
  --
  -- ui.picker is excluded: while a picker is open an outside click belongs to
  -- picker_draw, which closes it, and grabbing the window on the same click
  -- would make dismissing a picker also shift the menu.
  if ui.m.click and not ui.drag and not ui.picker and inside(x,y,w,h) then
    ui.win_grab={ox=ui.m.x-x,oy=ui.m.y-y}
  end
  picker_draw()
  SNOW.draw(x,y,w,h,theme.opacity)
end

local function update_input()
  ui.m.x,ui.m.y=mouse_pos()
  local d=ekey(0x01); ui.m.click=d and not ui.m.was; ui.m.down=d; ui.m.was=d
  if not d and ui.drag and ui.drag.k~="slider" then ui.drag=nil end
  if ui.drag and ui.drag.k=="win" then local sw,sh=scr(); ui.x=clamp(ui.m.x-ui.drag.ox,0,sw-ui.w); ui.y=clamp(ui.m.y-ui.drag.oy,0,sh-ui.h) end
  if ui.drag and (ui.drag.k=="hud_mark" or ui.drag.k=="hud_keys" or ui.drag.k=="hud_bar") then
    local sw,sh=scr()
    local key=ui.drag.k=="hud_mark" and "mark" or (ui.drag.k=="hud_keys" and "keys" or "bar")
    -- straight into the profile keys: the panels come back where they were left
    -- after a reload, and the debounced autosave persists the drag
    cfg["hud_"..key.."_x"]=clamp(ui.m.x-ui.drag.ox,0,sw-24)
    cfg["hud_"..key.."_y"]=clamp(ui.m.y-ui.drag.oy,0,sh-14)
    cfg_dirty=true
  end
  local mk=bind.menu_key or 0xA1; local held=ekey(mk)
  if held and not ui.menu_edge then ui.open=not ui.open; ui.picker=nil; ui.capture=nil end
  ui.menu_edge=held
  -- ESP enable hotkey, edge triggered like the menu key so holding the bind
  -- flips once instead of every frame. skipped while a bind is being captured,
  -- because the capture loop reads every key and would bind and toggle at once.
  local ek=bind.esp_toggle or 0
  local eh=(ek~=0) and ekey(ek) or false
  if eh and not ui.esp_edge and not ui.capture then cfg.esp_on=not cfg.esp_on; cfg_dirty=true end
  ui.esp_edge=eh
  -- same edge rule for the aimbot master, so the toggle key and the menu switch
  -- can never fight each other while one is held
  local ak=bind.aim_toggle or 0
  local ah=(ak~=0) and ekey(ak) or false
  if ah and not ui.aim_edge and not ui.capture then cfg.aim_on=not cfg.aim_on; cfg_dirty=true end
  ui.aim_edge=ah
  if ui.capture then
    if not ui.capture_ok then if not ekey(0x01) then ui.capture_ok=true end return end
    if ekey(0x1B) then bind[ui.capture]=0; cfg_dirty=true; ui.capture=nil; return end
    for vk=0x01,0xFE do if vk~=0x1B and ekey(vk) then bind[ui.capture]=vk; cfg_dirty=true; ui.capture=nil; return end end
  end
end

-- =========================================================================
-- CONFIG
-- Vector ships the io standard library, so the profile is written to disk with
-- io.open/io.write. A copy is kept in getgenv as a fallback for sandboxes where
-- file io is blocked. HttpService JSON is used when it is reachable, otherwise
-- a plain key=value text format. Everything lives on CFG so the engine costs a
-- single main-local; the schema buttons close over the table, not the functions.
-- =========================================================================
CFG.env=function()
  local g=getgenv and getgenv() or _G
  if type(g)~="table" then return nil end
  if type(g.EGOFUST_CFGS)~="table" then g.EGOFUST_CFGS={} end
  return g
end
CFG.http=function()
  -- standard Roblox wants the colon form; some executors expose a plain
  -- game.GetService function instead, so try both before giving up on json
  local ok,hs=pcall(function() return game:GetService("HttpService") end)
  if ok and hs then return hs end
  ok,hs=pcall(function() return game.GetService("HttpService") end)
  if ok and hs then return hs end
  return nil
end
CFG.last=0
-- Gun Mods are session-only. They must never be written to a profile or
-- restored from one: the patches are global, irreversible without a rejoin, and
-- a saved "on" would silently re-arm them at startup. Every gun_sgc* key is
-- skipped on both save and load, so the section always starts off until the
-- user flips it in this session.
CFG.save=function(slot,quiet)
  slot=tonumber(slot) or tonumber(cfg.cfg_slot) or 1
  local data=nil
  local hs=CFG.http()
  if hs then
    local t={v={},b={},c={}}
    for k,v in pairs(cfg) do if k~="cfg_slot" and k:sub(1,7)~="gun_sgc" then t.v[k]=v end end
    for k,v in pairs(bind) do t.b[k]=v end
    for k,cv in pairs(col) do t.c[k]={cv[1] or 0,cv[2] or 0,cv[3] or 0,cv[4] or 1} end
    local ok,s=pcall(function() return hs:JSONEncode(t) end)
    if ok and type(s)=="string" and #s>0 then data=s end
  end
  if not data then
    local o={"#egofust-config-v1"}
    for k,v in pairs(cfg) do
      if k~="cfg_slot" and k:sub(1,7)~="gun_sgc" then o[#o+1]="v "..k.."="..(type(v)=="boolean" and (v and "1" or "0") or tostring(v)) end
    end
    for k,v in pairs(bind) do o[#o+1]="b "..k.."="..tostring(v) end
    for k,cv in pairs(col) do o[#o+1]="c "..k.."="..(cv[1] or 0)..","..(cv[2] or 0)..","..(cv[3] or 0)..","..(cv[4] or 1) end
    data=table.concat(o,"\n")
  end
  local g=CFG.env()
  if g then g.EGOFUST_CFGS[slot]=data; g.EGOFUST_SLOT=slot end
  local disk=false
  local ok,f=pcall(function() return io.open("egofust_config_"..slot..".cfg","w") end)
  if ok and f then
    local wok=pcall(function() f:write(data) end)
    pcall(function() f:close() end)
    disk=wok
  end
  cfg_dirty=false
  CFG.last=now()
  if not quiet then
    if disk then pcall(function() notify.Success("Config saved","slot "..slot.." - egofust_config_"..slot..".cfg",3) end)
    else pcall(function() notify.Warning("Config saved to session","io.open is blocked, no file written",4) end) end
  end
  return disk
end
CFG.load=function(slot,quiet)
  slot=tonumber(slot) or tonumber(cfg.cfg_slot) or 1
  local g=CFG.env()
  local data=nil
  local ok,f=pcall(function() return io.open("egofust_config_"..slot..".cfg","r") end)
  if ok and f then
    local rok,s=pcall(function() return f:read("*a") end)
    pcall(function() f:close() end)
    if rok and type(s)=="string" and #s>0 then data=s end
  end
  if not data and g and type(g.EGOFUST_CFGS)=="table" then data=g.EGOFUST_CFGS[slot] end
  if not data then
    if not quiet then pcall(function() notify.Warning("Nothing to load","slot "..slot.." is empty",3) end) end
    return false
  end
  local applied=false
  if data:sub(1,1)=="{" then
    local hs=CFG.http()
    if hs then
      local jok,t=pcall(function() return hs:JSONDecode(data) end)
      if jok and type(t)=="table" then
        for k,v in pairs(t.v or {}) do
          if cfg[k]~=nil and k:sub(1,7)~="gun_sgc" then
            if type(v)=="boolean" then cfg[k]=v
            else local x=tonumber(v); if x then cfg[k]=x end end
          end
        end
        for k,v in pairs(t.b or {}) do
          if bind[k]~=nil then local x=tonumber(v); if x then bind[k]=x end end
        end
        for k,v in pairs(t.c or {}) do
          if col[k]~=nil and type(v)=="table" then
            local r1,g1,b1=tonumber(v[1]),tonumber(v[2]),tonumber(v[3])
            if r1 and g1 and b1 then col[k]={r1,g1,b1,tonumber(v[4]) or 1} end
          end
        end
        applied=true
      end
    end
  else
    for line in data:gmatch("[^\n]+") do
      local kind,k,val=line:match("^(%a) ([^=]+)=(.*)$")
      if kind then
        if kind=="v" and cfg[k]~=nil and k:sub(1,7)~="gun_sgc" then
          if type(cfg[k])=="boolean" then cfg[k]=(val=="1" or val=="true")
          else local x=tonumber(val); if x then cfg[k]=x end end
        elseif kind=="b" and bind[k]~=nil then
          local x=tonumber(val); if x then bind[k]=x end
        elseif kind=="c" and col[k]~=nil then
          local r,g1,b1,a1=val:match("([%d%.%-]+),([%d%.%-]+),([%d%.%-]+),([%d%.%-]+)")
          if r then col[k]={tonumber(r),tonumber(g1),tonumber(b1),tonumber(a1) or 1} end
        end
      end
    end
    applied=true
  end
  -- Range rows whose maximum is a game-metre cap. A slot saved before the unit
  -- change (or before a cap was lowered) can hold a bigger real-metre value,
  -- which the menu would print past the row's maximum, so pull those back to the
  -- cap on load instead of letting an old profile exceed it.
  if cfg.aim_range and cfg.aim_range>1500*M_PER_STUD then cfg.aim_range=1500*M_PER_STUD end
  if cfg.esp_maxdist and cfg.esp_maxdist>1500*M_PER_STUD then cfg.esp_maxdist=1500*M_PER_STUD end
  if cfg.npcs_max_dist and cfg.npcs_max_dist>300*M_PER_STUD then cfg.npcs_max_dist=300*M_PER_STUD end
  if cfg.rad_range and cfg.rad_range>500*M_PER_STUD then cfg.rad_range=500*M_PER_STUD end
  if cfg.plants_range and cfg.plants_range>125*M_PER_STUD then cfg.plants_range=125*M_PER_STUD end
  if cfg.pick_range and cfg.pick_range>75*M_PER_STUD then cfg.pick_range=75*M_PER_STUD end
  if cfg.veh_range and cfg.veh_range>1000*M_PER_STUD then cfg.veh_range=1000*M_PER_STUD end
  if cfg.nodes_range and cfg.nodes_range>225*M_PER_STUD then cfg.nodes_range=225*M_PER_STUD end
  if cfg.bd_range and cfg.bd_range>300*M_PER_STUD then cfg.bd_range=300*M_PER_STUD end
  if cfg.loot_range and cfg.loot_range>225*M_PER_STUD then cfg.loot_range=225*M_PER_STUD end
  if cfg.base_range and cfg.base_range>175*M_PER_STUD then cfg.base_range=175*M_PER_STUD end
  if g then g.EGOFUST_SLOT=slot end
  cfg_dirty=false
  if not quiet then
    if applied then pcall(function() notify.Success("Config loaded","slot "..slot,3) end)
    else pcall(function() notify.Error("Config is corrupted","slot "..slot.." could not be parsed",3) end) end
  end
  return applied
end
CFG.reset=function()
  -- re-apply the schema defaults, same loop the menu uses to seed the values
  for _,tab in ipairs(SCHEMA) do for _,g in ipairs(tab.groups) do for _,it in ipairs(g.items) do
    if it.t=="toggle" then cfg[it.id]=it.default or false
    elseif it.t=="slider" then cfg[it.id]=it.default or it.min
    elseif it.t=="combo" then cfg[it.id]=it.default or 1
    elseif it.t=="bind" then bind[it.id]=it.default or 0
    elseif it.t=="color" then
      local dc=DEF_COL[it.id] or it.default
      if dc and type(dc)=="table" then col[it.id]={dc[1] or 1,dc[2] or 1,dc[3] or 1,dc[4] or 1}
      else col[it.id]={1,1,1,1} end
    end
    -- toggles with an inline swatch (NPC / World categories) reset too
    if it.color then
      local d=DEF_COL[it.color]
      if d then col[it.color]={d[1],d[2],d[3],d[4]} end
    end
  end end end
  -- HUD panels go back to their anchored corners on a reset as well
  cfg.hud_mark_x,cfg.hud_mark_y=-1,-1
  cfg.hud_keys_x,cfg.hud_keys_y=-1,-1
  cfg.hud_bar_x,cfg.hud_bar_y=-1,-1
  cfg_dirty=true
  pcall(function() notify.Success("Defaults restored","",3) end)
end

-- restore the last profile on start so the menu comes up the way it was left
cfg.cfg_slot=tonumber(CFG.env().EGOFUST_SLOT) or tonumber(cfg.cfg_slot) or 1
CFG.load(cfg.cfg_slot,true)

-- =========================================================================
-- FRAME LOOP
-- UI only: the window, the tab rail and the controls. No gameplay runs here.
-- =========================================================================

function OnFrame()
  _dt=utility.GetDeltaTime and utility.GetDeltaTime() or 0.016
  if not _dt or _dt<=0 or _dt>0.2 then _dt=0.016 end
  FRAME=FRAME+1
  -- colour memo is per-frame: keeps picker changes live while letting every
  -- target share one table per swatch instead of allocating one each
  COL_MEM={}
  if cfg.accent_chroma then
    local h=now()*0.15
    theme.accent=hsv(h,0.7,1)
    theme.accent2=hsv(h+0.11,0.7,1)
  else
    theme.accent=col.c_accent or theme.accent
    theme.accent2=theme.accent2_base
  end
  update_input()
  ui.appear=approach("appear", ui.open and 1 or 0, 14)
  pcall(run_aim)
  pcall(run_gunmods)
  pcall(run_hitbox)
  pcall(scan_npcs_task)
  -- ESP sits under the menu so the window always stays readable; the menu, HUD
  -- and crosshair draw afterwards.
  -- chams sit under everything else: bodies first, then boxes/bones on top
  pcall(run_chams)
  pcall(run_esp)
  if cfg.npc_esp_enabled then pcall(run_npc_esp_h) end
  pcall(run_radar)
  pcall(run_world)
  pcall(draw_aim)
  if ui.appear>0.01 then pcall(draw_menu) end
  theme.opacity=1
  -- HUD sits outside the menu fade: the overlays are toggled on their own and
  -- stay up with the window closed, which is the point of a HUD.
  pcall(run_hud)
  pcall(run_crosshair)
  -- debounced autosave: any widget that touches a setting flags the profile
  -- dirty and it is written out at most once a second.
  if cfg_dirty and cfg.cfg_auto then
    local t=now()
    if t-CFG.last>=1 then CFG.save(cfg.cfg_slot,true) end
  end
end

pcall(function() notify.Success("Fust Survival v1.3 loaded","Right Shift to toggle menu",5) end)
