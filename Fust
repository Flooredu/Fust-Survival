local function is_melee_or_utility_tool(name)
  if not name or name=="" then return false end
  local c=tostring(name):lower()
  if c:find("rock") or c:find("pick") or c:find("axe") or c:find("hatchet") or c:find("torch") or c:find("hammer") or c:find("plan") or c:find("bandage") or c:find("syringe") or c:find("pumpkin") or c:find("corn") or c:find("meat") or c:find("machete") or c:find("knife") or c:find("bone") or c:find("spear") then
    return true
  end
  return false
end

-- ==========================================================================
-- setgc weapon patches
--
-- setgc(key, value) rewrites that key in EVERY GC table that owns it, and it
-- filters by key NAME rather than by reachability. A 23-key probe against the
-- live build found exactly eight keys it will actually patch:
--
--   rate  spread  sway  kickRoll  adsKick  bloom  shakeDur   (climb is a no-op)
--
-- Everything else is silently ignored even when the table owns the key:
-- kickPitch, kickBack, pitch, yaw, rise, recover, kick, shake, shakeStrength,
-- spreadMult, adsTime, s2Damage, rounds, adsSpread, moveSpread, damageMult,
-- mag, reload, recoilRecover, recoilPitch, recoilYaw, notch, sightHeight.
-- So this is a weapon-STAT mod only - vertical camera recoil is not reachable
-- through setgc, so it cannot be suppressed at all.
--
-- Patching is GLOBAL, not per weapon: rate = 0.09 turns the 1.8 s LR Sniper
-- into a 20x-fire-rate rifle, the most detectable case there is. The slider is
-- therefore capped to 80-190 ms (12.5 down to ~5.3 shots/s); 20 ms is what got
-- the account kicked for firerate.
--
-- setgc walks the whole VM and in this build it is SLOW: one getgc pre-warm
-- plus one setgc pass is about a second of frozen frames. It is therefore
-- applied once per toggle change and never re-pinned on a timer - the old 20 s
-- re-pin was what froze the game while the mods were on. Re-pinning is also
-- pointless: setgc patches by key name across every table, so all weapon defs
-- are covered even while they sit in the bag.
--
-- Turning the master toggle off cannot restore stock values, because setgc has
-- no read-back and the stock rate differs per weapon. Re-equip or rejoin.
PF.sgc={state=nil,pending=nil,hold=0,force=0,warmed=false}

-- Resolve the GC API. In the dumper setgc is a bare global, but this script can
-- be loaded into an environment where it only lives on _G or on the executor's
-- shared table. A nil setgc used to make the whole feature fail silently.
-- Hoisted out of setgc_apply so the per-frame path allocates no closure.
local function gc_api(name)
  local fn=nil
  pcall(function() if type(_G)=="table" and type(_G[name])=="function" then fn=_G[name] end end)
  if not fn then
    pcall(function()
      if type(getgenv)=="function" then
        local g=getgenv()
        if type(g)=="table" and type(g[name])=="function" then fn=g[name] end
      end
    end)
  end
  if not fn then
    pcall(function()
      if name=="setgc" and type(setgc)=="function" then fn=setgc
      elseif name=="getgc" and type(getgc)=="function" then fn=getgc end
    end)
  end
  return fn
end

local function setgc_apply()
  local st=PF.sgc
  local forced=(sgc_force~=st.force)
  -- Cheap idle gate: two booleans plus the interval packed into one number.
  -- No table, no string, no closure on the path that runs every frame.
  local rate_on=(cfg.gun_sgc and cfg.gun_sgc_rate) and true or false
  local clean_on=(cfg.gun_sgc and cfg.gun_sgc_clean) and true or false
  local ms=math.floor((tonumber(cfg.gun_sgc_rate_ms) or 90)+0.5)
  if ms<80 then ms=80 elseif ms>190 then ms=190 end
  local state=(rate_on and 1 or 0)+(clean_on and 2 or 0)+ms*4
  if not rate_on and not clean_on then
    st.state=nil; st.pending=nil; st.hold=0
    if forced then st.force=sgc_force end
    return
  end
  if forced then
    -- the Re-apply button always does a full warm + patch
    st.warmed=false
  elseif state==st.state then
    st.pending=nil; st.hold=0
    return
  else
    -- 24 frames (~0.4 s) after the last change. Without this, dragging the
    -- Fire Interval slider would fire a full GC walk on every pixel.
    if state~=st.pending then st.pending=state; st.hold=0 end
    st.hold=st.hold+1
    if st.hold<24 then return end
  end
  st.state,st.force=state,sgc_force
  st.pending=nil; st.hold=0
  local f=st.setgc or gc_api("setgc")
  st.setgc=f
  if not f then
    if not st.warned then
      st.warned=true
      pcall(function() print("[egofust] setgc not found - weapon patches disabled") end)
    end
    return
  end
  local list={}
  if rate_on then list[#list+1]={"rate",ms/1000} end
  if clean_on then
    list[#list+1]={"spread",0}
    list[#list+1]={"sway",0}
    list[#list+1]={"kickRoll",0}
    list[#list+1]={"adsKick",0}
    list[#list+1]={"bloom",0}
    list[#list+1]={"shakeDur",0}
  end
  -- The getgc pre-warm is the whole reason the identical call worked in the
  -- dumper and did nothing here: this build's setgc only rewrites nodes that
  -- getgc has already cached. Warm all seven names once, ever. The cache keeps
  -- them even when only some toggles are on, so later flips cost no new scan.
  if not st.warmed then
    local g=st.getgc or gc_api("getgc")
    st.getgc=g
    if g then
      local wok=pcall(g,{"rate","spread","sway","kickRoll","adsKick","bloom","shakeDur"})
      if wok then st.warmed=true end
    end
  end
  local patch={}
  for i=1,#list do patch[list[i][1]]=list[i][2] end
  -- One call, one GC walk. setgc({...}) is the exact form the dumper printed
  -- as its WORKING block, and it patches every key in a single pass instead of
  -- one full walk per key. Per-key is kept as a fallback only.
  local ok,n=pcall(f,patch)
  if not (ok and type(n)=="number" and n>0) then
    for i=1,#list do pcall(f,list[i][1],list[i][2]) end
  end
end

-- ---------------------------------------------------------------------------
-- NPC instance accessors.
-- The runtime exposes Roblox instances with either PascalCase methods
-- (FindFirstChild / GetChildren) or the snake_case binding hub.txt uses
-- (find_first_child / get_children). Every lookup below tries both, so the NPC
-- pass works on either build instead of failing silently inside a pcall.
-- ---------------------------------------------------------------------------
local function o_children(obj)
  if not obj then return nil end
  -- method names are unrolled instead of walked from a fresh {"GetChildren",
  -- "get_children"} table: this runs per instance per sweep, and the tables were
  -- pure garbage.
  local fn=obj.GetChildren
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj)
    if ok and type(v)=="table" then return v end
  end
  fn=obj.get_children
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj)
    if ok and type(v)=="table" then return v end
  end
  return nil
end

local function o_first(obj,name)
  if not obj then return nil end
  local fn=obj.FindFirstChild
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj,name)
    if ok and v then return v end
  end
  fn=obj.find_first_child
  if type(fn)=="function" then
    local ok,v=pcall(fn,obj,name)
    if ok and v then return v end
  end
  local okd,d=pcall(PF.get,obj,name)
  if okd and d then return d end
  local ch=o_children(obj)
  if ch then
    for i=1,#ch do
      local c=ch[i]
      local okn,nm=pcall(PF.name,c)
      if okn and nm==name then return c end
    end
  end
  return nil
end

local function o_class(obj)
  if not obj then return nil end
  local ok,v=pcall(PF.cls,obj)
  if ok and type(v)=="string" then return v end
  local ok2,v2=pcall(PF.get,obj,"class_name")
  if ok2 and type(v2)=="string" then return v2 end
  return nil
end

local function o_pos(part)
  if not part then return nil end
  local ok,cf=pcall(PF.cframe,part)
  if ok and cf then
    local okp,p=pcall(PF.cfpos,cf)
    if okp and p then
      local x=p.X or p.x; local y=p.Y or p.y; local z=p.Z or p.z
      if x and y and z then return x,y,z end
    end
  end
  ok,cf=pcall(PF.get,part,"cframe")
  if ok and cf then
    local okp,p=pcall(PF.cfpos,cf)
    if okp and p then
      local x=p.X or p.x; local y=p.Y or p.y; local z=p.Z or p.z
      if x and y and z then return x,y,z end
    end
  end
  local ok3,q=pcall(PF.pos,part)
  if ok3 and q then
    local x=q.X or q.x; local y=q.Y or q.y; local z=q.Z or q.z
    if x and y and z then return x,y,z end
  end
  ok3,q=pcall(PF.get,part,"position")
  if ok3 and q then
    local x=q.X or q.x; local y=q.Y or q.y; local z=q.Z or q.z
    if x and y and z then return x,y,z end
  end
  return nil
end

local function o_root(inst)
  if not inst then return nil end
  local hum=o_first(inst,"Humanoid")
  if hum then
    local okr,rp=pcall(PF.rootpart,hum)
    if not (okr and rp) then
      local ok2,v2=pcall(PF.get,hum,"root_part")
      if ok2 then rp=v2 end
    end
    if rp and o_pos(rp) then return rp end
  end
  local names={"HumanoidRootPart","UpperTorso","Torso","Head","RootPart","Body"}
  for i=1,#names do
    local p=o_first(inst,names[i])
    if p and o_pos(p) then return p end
  end
  local ch=o_children(inst)
  if ch then
    for i=1,#ch do
      local c=ch[i]; local cl=o_class(c)
      if cl=="Part" or cl=="MeshPart" or cl=="BasePart" or cl=="UnionOperation" then
        if o_pos(c) then return c end
      end
    end
  end
  return nil
end

-- Resolves an instance that may itself be a part, a Model wrapping parts, or a
-- Model-of-Models. The patrol heli is the reason this exists: its "Fuselage" is
-- a Model, so taking the first named child and projecting it yields no position
-- and the whole helicopter silently disappears.
local function o_part_in(obj)
  if not obj then return nil end
  local cl=o_class(obj)
  if cl~="Model" and o_pos(obj) then return obj end
  local okd,d=pcall(PF.desc,obj)
  if not okd then
    local g=obj.get_descendants
    if type(g)=="function" then okd,d=pcall(g,obj) end
  end
  if okd and type(d)=="table" then
    for i=1,#d do
      local c=d[i]; local cc=o_class(c)
      if (cc=="Part" or cc=="MeshPart" or cc=="BasePart" or cc=="UnionOperation") and o_pos(c) then return c end
    end
  end
  local ch=o_children(obj)
  if ch then
    for i=1,#ch do
      local c=ch[i]; local cc=o_class(c)
      if (cc=="Part" or cc=="MeshPart" or cc=="BasePart") and o_pos(c) then return c end
    end
  end
  return nil
end

-- Bone set and the links drawn between them. Kept as data so the skeleton pass
-- projects each bone exactly once per frame instead of once per line.
local NPC_BONES={"Head","UpperTorso","LowerTorso",
  "LeftUpperArm","LeftLowerArm","LeftHand",
  "RightUpperArm","RightLowerArm","RightHand",
  "LeftUpperLeg","LeftLowerLeg","LeftFoot",
  "RightUpperLeg","RightLowerLeg","RightFoot"}
local NPC_BONE_LINKS={
  {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
  {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
  {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
  {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
  {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
-- Links as numeric bone indices, and a flat scratch buffer for the projected
-- points. Reusing these means the skeleton pass allocates nothing per frame:
-- building a {x,y} table per bone per NPC was pure GC churn.
local NPC_BONE_IDX={}
for i=1,#NPC_BONES do NPC_BONE_IDX[NPC_BONES[i]]=i end
local NPC_LINKS={}
for i=1,#NPC_BONE_LINKS do
  local a=NPC_BONE_IDX[NPC_BONE_LINKS[i][1]]
  local b=NPC_BONE_IDX[NPC_BONE_LINKS[i][2]]
  if a and b then NPC_LINKS[#NPC_LINKS+1]={a,b} end
end
local NPC_PX={}
local NPC_PY={}
local NPC_POK={}
-- shared constants: a default swatch and a precomputed health ramp, so the NPC
-- draw path does not allocate colour tables per NPC per frame
local NPC_COL={
  def={0.25,0.85,1.00,1},
  skel={1,0.35,0.35,1},
  hat={0.99,0.78,0.36,1},
  box={0.45,0.78,1,1},
  -- shared scratch for Chroma NPC: one table reused by every tinted element,
  -- so a rainbow overlay allocates nothing per frame (draw calls copy the
  -- colour immediately, the same way the radar reuses its blip scratch)
  ch={1,1,1,1},
  hp_bg={0.1,0.1,0.1,0.8},
  hp={},
  -- real metres per stud, and its square. A range row is stored in real metres
  -- and the cull compares squared studs, so the squared range has to divide by
  -- m2 (a 400 m limit is 1429 studs). The distance row itself prints studs - the
  -- game's own metres - so the number beside an NPC matches the kill feed.
  m=PF.m,
  m2=PF.m*PF.m,
  -- The patrol heli is exempt from the NPC Range slider: it flies, so a fixed
  -- ceiling keeps it on screen whatever the slider is set to. 1000m, converted
  -- to studs the same way the slider is.
  heli=1000/PF.m,
  -- Bone indices the box needs: head, left foot, right foot. Kept on this table
  -- so the projection helper does not add another main-chunk local.
  boxidx={1,12,15},
}
NPC_COL.heli2=NPC_COL.heli*NPC_COL.heli
for i=0,20 do local p=i/20; NPC_COL.hp[i]={1-p,p,0.2,1} end

-- Resolving Humanoid/RootPart again on every sweep was a per-NPC reflection
-- cost we never needed to pay twice.
local NPC_ROOT_CACHE=setmetatable({},{__mode="k"})

-- Incremental sweep state. The scan touches only a handful of NPCs per frame
-- and swaps the published list in when the sweep finishes, so no single frame
-- ever pays for the whole map. NPC_LIST is what the draw pass iterates.
local NPC_LIST={}
local NPC_NEXT={}
local NPC_LIVE=setmetatable({},{__mode="k"})
local NPC_KIDS={}
local NPC_HELI=false
local npc_kid_idx=0
local npc_kids_t=-1
local npc_next_n=0
local npc_sweep_active=false
local npc_sweep_id=0

-- Project a world point and keep it only when it actually lands on the screen.
-- Points behind the camera still come back with coordinates, and those mirrored
-- values are what made the overlay streak across the display.
local function npc_proj(wx,wy,wz,sw,sh)
  local ok,sx,sy,vis=pcall(draw.WorldToScreen,wx,wy,wz)
  -- only fall back when the primary call itself failed: retrying on "no result"
  -- doubled the cost of every off-screen bone projection
  if not ok and utility then
    local w2=utility.WorldToScreen or utility.world_to_screen
    if w2 then
      local ok2,vx,vy,vv=pcall(w2,wx,wy,wz)
      if ok2 then sx,sy,vis=vx,vy,vv end
    end
  end
  if not sx or not sy or vis==false then return nil end
  if sx<-4 or sy<-4 or sx>sw+4 or sy>sh+4 then return nil end
  return sx,sy
end

-- Origin for the range filter. The camera object is not exposed on every build,
-- so this walks down to the local player and only then to the camera.
local function npc_origin()
  local x,y,z
  pcall(function()
    local lp=entity.GetLocalPlayer()
    local p=lp and lp.Position
    if p then x=p.X or p.x; y=p.Y or p.y; z=p.Z or p.z end
    if not x then
      local h=lp and lp.HeadPosition
      if h then x=h.X or h.x; y=h.Y or h.y; z=h.Z or h.z end
    end
    if not x then
      local c=lp and lp.Character
      local rp=c and (c.PrimaryPart or c.HumanoidRootPart)
      if rp then
        local q=rp.Position
        if q then x=q.X or q.x; y=q.Y or q.y; z=q.Z or q.z end
      end
    end
    if not x then
      local cw=nil
      if game and game.Workspace then cw=game.Workspace.CurrentCamera end
      if not cw and workspace then cw=workspace.CurrentCamera end
      local cf=cw and (cw.CFrame or cw.cframe)
      local q=cf and cf.Position
      if q then x=q.X or q.x; y=q.Y or q.y; z=q.Z or q.z end
    end
  end)
  return x,y,z
end

local function o_parts(inst)
  local t={}
  if not inst then return t end
  -- One sweep of the direct children first: every Guard/Soldier bone in the dump
  -- (Head, UpperTorso, limbs, hands, feet, HumanoidRootPart) sits directly under
  -- the model. Doing this once beats 21 separate lookups per NPC per scan.
  local ch=o_children(inst)
  if ch then
    for i=1,#ch do
      local c=ch[i]
      local okn,nm=pcall(PF.name,c)
      if okn and type(nm)=="string" then t[nm]=c end
    end
  end
  -- Anything the model keeps one level down (wrapped rigs, a Gun sub-model) is
  -- picked up here, but only when the name is not already a direct child.
  local okd,desc=pcall(PF.desc,inst)
  if not okd then
    local g=inst.get_descendants
    if type(g)=="function" then okd,desc=pcall(g,inst) end
  end
  if okd and type(desc)=="table" then
    for i=1,#desc do
      local c=desc[i]
      local okn,nm=pcall(PF.name,c)
      if okn and type(nm)=="string" and not t[nm] then t[nm]=c end
    end
  end
  return t
end

local function o_hp(inst)
  local hum=o_first(inst,"Humanoid")
  if not hum then return 100,100 end
  local hp,maxhp=100,100
  local okh,hv=pcall(PF.hp,hum); if okh then hp=tonumber(hv) or 100 end
  local okm,mv=pcall(PF.mhp,hum); if okm then maxhp=tonumber(mv) or 100 end
  if maxhp<1 then maxhp=100 end
  if hp<0 then hp=0 end
  return hp,maxhp
end

-- Non-allocating position read. o_pos wraps every property access in a fresh
-- closure, which is fine for a handful of calls but not for 15 bones per NPC
-- per frame: that is hundreds of throwaway closures every frame, and the GC
-- pauses from them are what made the overlay stutter with skeletons on.
local function bone_xyz(part)
  if not part then return nil end
  -- Position first: it is the same point CFrame.Position gives, but for one
  -- host call and one throwaway table instead of two. This is the hottest read
  -- in the NPC pass (15 bones x every NPC x every frame), so the reorder alone
  -- halves that cost. CFrame stays as the fallback for parts without Position.
  local ok,p=pcall(PF.pos,part)
  if ok and p then
    local x=p.X or p.x; local y=p.Y or p.y; local z=p.Z or p.z
    if x and y and z then return x,y,z end
  end
  local ok2,cf=pcall(PF.cframe,part)
  if ok2 and cf then
    local ok3,q=pcall(PF.cfpos,cf)
    if ok3 and q then
      local x=q.X or q.x; local y=q.Y or q.y; local z=q.Z or q.z
      if x and y and z then return x,y,z end
    end
  end
  return nil
end

-- Project a rig's bones once per frame into the shared screen arrays. The draw
-- pass used to re-read and re-project the head and a foot for the box, then the
-- head again for the dot and the whole rig again for the skeleton: on a screen
-- full of NPCs that was thousands of host calls per frame, which is what
-- dragged the FPS down. all=false projects only the three points the box needs.
local function npc_project_bones(arr,sw,sh,all)
  if not arr then return end
  local n=all and #arr or #NPC_COL.boxidx
  for i=1,n do
    local k=all and i or NPC_COL.boxidx[i]
    local pr=arr[k]
    local wx,wy,wz
    if pr then wx,wy,wz=bone_xyz(pr) end
    if wx then
      local sx,sy=npc_proj(wx,wy,wz,sw,sh)
      if sx then
        NPC_PX[k]=sx; NPC_PY[k]=sy; NPC_POK[k]=true
      else
        NPC_POK[k]=false
      end
    else
      NPC_POK[k]=false
    end
  end
end

-- Ordered bone parts per rig, resolved once per NPC entry. The name-keyed table
-- from o_parts would work, but an array keeps the per-frame loop allocation free
-- and lets a missing bone be remembered as "false" instead of retried forever.
local function npc_bone_array(inst)
  local arr={}
  local t=o_parts(inst) or {}
  for i=1,#NPC_BONES do
    local bn=NPC_BONES[i]
    local pr=t[bn]
    if not pr then pr=o_first(inst,bn) end
    arr[i]=pr or false
  end
  return arr
end

local function scan_npcs_task()
  -- Incremental sweep: only a handful of NPCs are touched per frame instead of
  -- the whole folder in one go. The published list is replaced only when a
  -- sweep completes, so the draw pass always sees a coherent snapshot and no
  -- single frame ever pays for the whole map.
  npc_scan_frames=npc_scan_frames+1
  -- the aimbot / triggerbot NPC toggles keep the scan warm on their own, so
  -- targeting NPCs works without the NPC ESP master switch being on. The patrol
  -- heli is resolved by this same sweep, so its aim toggle counts too.
  if not (cfg.npc_esp_enabled or cfg.aim_npc or cfg.trig_npc or cfg.aim_heli) then
    if #NPC_LIST>0 or npc_sweep_active then
      NPC_LIST={}
      NPC_NEXT={}
      NPC_LIVE=setmetatable({},{__mode="k"})
      NPC_KIDS={}
      NPC_HELI=false
      npc_kid_idx=0
      npc_next_n=0
      npc_kids_t=-1
      npc_sweep_active=false
      cache_npcs=NPC_LIST
    end
    return
  end

  local okc,nowt=pcall(now)
  if not okc or type(nowt)~="number" or nowt<=0 then
    -- no usable clock on this build: derive one from the frame counter
    nowt=npc_scan_frames*0.016
  end

  -- Start a sweep at most once a second, and never while one is still running.
  -- The frame-count valve matters if GetTime is frame-granular on some build:
  -- without it a frozen clock would stop sweeps from ever restarting.
  if not npc_sweep_active then
    if nowt-npc_kids_t<1.0 and (npc_scan_frames%90)~=0 then return end
    npc_sweep_active=true
    npc_kids_t=nowt
    npc_kid_idx=0
    npc_next_n=0
    npc_sweep_id=npc_sweep_id+1
    local ws=nil
    pcall(function()
      if game then
        ws=game.Workspace or game.workspace
        if not ws and game.GetService then ws=game:GetService("Workspace") end
      end
    end)
    if not ws and workspace then ws=workspace end
    local kids=NPC_KIDS
    for i=#kids,1,-1 do kids[i]=nil end
    NPC_HELI=false
    if ws then
      local folder=o_first(ws,"Npcs")
      if not folder then
        -- only when the folder is genuinely absent, and only by name: probing
        -- every top-level model for a Humanoid was a map-wide walk per scan.
        local top=o_children(ws)
        if top then
          for i=1,#top do
            local inst=top[i]
            local nm=""
            pcall(function() nm=(inst.Name or ""):lower() end)
            if nm:find("npc",1,true) then folder=inst; break end
          end
        end
      end
      if folder then
        local ch=o_children(folder)
        if ch then
          for i=1,#ch do kids[#kids+1]=ch[i] end
        end
      end
      -- heli is resolved once per sweep; its position is read live when drawn
      local hf=o_first(ws,"FustPatrolHeli")
      if hf then
        local heli=o_first(hf,"PatrolHeliModel") or o_first(hf,"PatrolHeli") or hf
        local main=NPC_ROOT_CACHE[heli]
        if main==nil then
          local cand={"Engine","Body","Fuselage","MainRotor"}
          for i=1,#cand do
            local p=o_first(heli,cand[i])
            if p then main=o_part_in(p); if main then break end end
          end
          if not main then main=o_part_in(heli) end
          NPC_ROOT_CACHE[heli]=main or false
        end
        if main then
          local px,py,pz=bone_xyz(main)
          if px then
            NPC_HELI={x=px,y=py,z=pz,name="Patrol Helicopter",inst=heli,obj=heli,
              root=main,head=main,torso=main,parts={},hp=5000,max_hp=5000,is_heli=true,
              color=col.npc_heli_col or {1.00,0.20,0.20,1}}
          end
        end
      end
    end
  end

  local nkids=#NPC_KIDS
  if npc_kid_idx<nkids then
    local ox0,oy0,oz0=npc_origin()
    local maxd0=cfg.npcs_max_dist or 300*M_PER_STUD
    if maxd0<1 then maxd0=300*M_PER_STUD end
    -- the row stops at 300 game metres; clamp in case a saved config predates it
    if maxd0>300*M_PER_STUD then maxd0=300*M_PER_STUD end
    -- slider is metres; cull is studs, so convert before squaring
    local maxsq0=(maxd0*maxd0/NPC_COL.m2)*1.44
    local nextl=NPC_NEXT
    local budget=16    -- total children visited this frame
    local newbudget=6  -- fresh rigs resolved this frame (the costly path)
    while npc_kid_idx<nkids and budget>0 do
      local inst=NPC_KIDS[npc_kid_idx+1]
      if not inst then
        npc_kid_idx=npc_kid_idx+1
        budget=budget-1
      else
        -- key on the instance address: wrappers can be recreated between calls,
        -- and losing the entry throws away its cached bone array (the flash)
        local key=inst
        local oka,ad=pcall(PF.addr,inst)
        if oka and type(ad)=="number" then key=ad end
        local e=NPC_LIVE[key]
        if e then
          npc_kid_idx=npc_kid_idx+1
          budget=budget-1
          local px,py,pz=bone_xyz(e.root)
          if px then
            e.x=px; e.y=py; e.z=pz
            local hp,maxhp=o_hp(inst)
            -- Hardcoded corpse filter: a dead rig never enters the published
            -- list, so the draw pass has nothing to render for it. Leaving
            -- e.seen untouched also drops it from NPC_LIVE at publish.
            if hp>0 then
              e.hp=hp; e.max_hp=maxhp
              if not e.hum then e.hum=o_first(inst,"Humanoid") or false end
              e.seen=npc_sweep_id
              npc_next_n=npc_next_n+1
              nextl[npc_next_n]=e
            end
          end
        elseif newbudget>0 then
          newbudget=newbudget-1
          npc_kid_idx=npc_kid_idx+1
          budget=budget-1
          local root=NPC_ROOT_CACHE[inst]
          if root==nil then
            root=o_root(inst) or false
            NPC_ROOT_CACHE[inst]=root
          end
          if root then
            local px,py,pz=bone_xyz(root)
            if px then
              local near=true
              if ox0 then
                local dx=px-ox0; local dy=py-oy0; local dz=pz-oz0
                near=(dx*dx+dy*dy+dz*dz<=maxsq0)
              end
              if near then
                local hp,maxhp=o_hp(inst)
                -- same hardcoded corpse filter on first sight: never create an
                -- entry for a rig that is already dead
                if hp>0 then
                  local nm="NPC"
                  pcall(function() nm=inst.Name or "NPC" end)
                  -- the bone array stays nil here and is resolved lazily by the
                  -- draw path, so a scan never walks GetDescendants
                  e={x=px,y=py,z=pz,name=nm,inst=inst,obj=inst,root=root,
                    key=key,seen=npc_sweep_id,hum=o_first(inst,"Humanoid") or false,
                    parts=nil,hp=hp,max_hp=maxhp,is_heli=false,
                    color=col.npc_soldier_col or {0.25,0.85,1.00,1}}
                  NPC_LIVE[key]=e
                  npc_next_n=npc_next_n+1
                  nextl[npc_next_n]=e
                end
              end
            end
          end
        else
          -- out of the new-rig budget: retry this child on the next frame
          break
        end
      end
    end
  end

  -- Sweep complete: publish. Truncate the reused table first so entries from
  -- the previous sweep cannot leak into the new list.
  if npc_sweep_active and npc_kid_idx>=nkids then
    local nextl=NPC_NEXT
    for i=#nextl,npc_next_n+1,-1 do nextl[i]=nil end
    if NPC_HELI then
      npc_next_n=npc_next_n+1
      nextl[npc_next_n]=NPC_HELI
    end
    local tmp=NPC_LIST
    NPC_LIST=nextl
    NPC_NEXT=tmp
    npc_sweep_active=false
    -- drop entries for NPCs that are no longer in the folder, so the table stays
    -- bounded and a recycled address cannot inherit a dead rig's bones
    for k,v in pairs(NPC_LIVE) do
      if type(v)=="table" and v.seen~=npc_sweep_id then NPC_LIVE[k]=nil end
    end
    -- the root/part cache is keyed on instance wrappers, which are not stable
    -- between calls, so it would gain an entry per rig per sweep otherwise.
    -- every rig that survives is already held in NPC_LIVE, so nothing is lost.
    for k in pairs(NPC_ROOT_CACHE) do NPC_ROOT_CACHE[k]=nil end
    cache_npcs=NPC_LIST
  end
end

-- Chroma support for the NPC pass. Both helpers write into a caller-supplied
-- scratch table: hsv()/hue_or() return a fresh table per call, and at 40 NPCs
-- x 7 colours that is thousands of throwaway tables a second. NPC_COL.ch is
-- the one scratch every tinted element shares.
PF.hue_fill=function(t,h,s,v)
  h=(h%1)*6
  local i=math.floor(h)
  local f=h-i
  local p=v*(1-s)
  local q=v*(1-s*f)
  local u=v*(1-s*(1-f))
  local r,g,b
  if i==0 then r,g,b=v,u,p
  elseif i==1 then r,g,b=q,v,p
  elseif i==2 then r,g,b=p,v,u
  elseif i==3 then r,g,b=p,q,v
  elseif i==4 then r,g,b=u,p,v
  else r,g,b=v,p,q end
  t[1]=r; t[2]=g; t[3]=b
  return t
end
-- returns base untouched when chroma is off, so the non-chroma path never
-- mutates the shared scratch and stays allocation-free
PF.tint=function(c,base,al)
  if not c then return base end
  c[4]=(base[4] or 1)*(al or 1)
  return c
end

-- China Hat for NPCs: the player ESP's wireframe cone, rebuilt on the NPC's Head
-- bone. It lives on PF rather than in a new main-level local so the chunk stays
-- inside its 200-local budget. Returns the projected apex y when the cone was
-- drawn, so the caller can lift the name row above it.
-- China Hat for NPCs: the player ESP's cone, laid out in screen space from the
-- head point and the probe's pixels-per-stud scale. That removes the 17 world
-- projections per NPC per frame the wireframe used to pay, and keeps the cone
-- glued to the head at any distance. sq is the brim squash from the camera's
-- elevation above the rig, so the ring reads as an ellipse seen from above
-- rather than a flat circle. Lives on PF rather than in a new main-level local
-- so the chunk stays inside its 200-local budget. Returns the apex y when the
-- cone was drawn, so the caller can lift the name row above it.
PF.npc_hat=function(px,py,pps,hs,c,sq)
  if not px or not py or not pps or pps<=0 then return nil end
  if not sq or sq<0 then sq=1 elseif sq>1 then sq=1 end
  local rad=0.62*hs*pps
  local brimy=py-0.44*hs*pps
  local apex=py-1.16*hs*pps
  if rad<3 then
    -- below ~3px the rim segments and ribs land on the same pixels and the black
    -- shadow pass of every line wins; one filled silhouette keeps the colour
    if draw.PolyFilled then
      draw.PolyFilled({{px,apex},{px+rad,brimy},{px-rad,brimy}},c)
    end
    return apex
  end
  local hc,hsn=PF.hc,PF.hs
  local xs,ys=PF.xs,PF.ys
  local seg=rad<4 and 8 or (rad<12 and 12 or 16)
  for i=1,seg do
    local k=math.floor((i-1)*16/seg)+1
    xs[i]=px+hc[k]*rad
    ys[i]=brimy+hsn[k]*rad*sq
  end
  for i=1,seg do local j=i%seg+1; draw.Line(xs[i],ys[i],xs[j],ys[j],c,1) end
  for i=1,seg,2 do draw.Line(px,apex,xs[i],ys[i],c,1) end
  return apex
end

local function run_npc_esp_h()
  if not cfg.npc_esp_enabled then return end
  -- the sweep is stepped once per frame from OnFrame; stepping it here too
  -- would double the per-frame work
  local list=cache_npcs or NPC_LIST
  if #list==0 then return end
  local sw,sh=scr()
  local maxd=cfg.npcs_max_dist or 300*M_PER_STUD
  if maxd<1 then maxd=300*M_PER_STUD end
  -- the row stops at 300 game metres; clamp in case a saved config predates it
  if maxd>300*M_PER_STUD then maxd=300*M_PER_STUD end
  -- slider is metres, the cull is in studs: 300m ~ 1071 studs, so squaring the
  -- slider directly culled targets that the distance row said were in range
  local maxsq=maxd*maxd/NPC_COL.m2
  local ox,oy,oz=npc_origin()
  -- camera position + forward for the behind-camera cull below. Nil on builds
  -- without a camera object, in which case the cull is simply skipped.
  local cpx,cpy,cpz,cfx,cfy,cfz
  pcall(function()
    local cp=camera.GetPosition()
    local lv=camera.GetLookVector()
    if cp then cpx,cpy,cpz=cp.X,cp.Y,cp.Z end
    if lv then cfx,cfy,cfz=lv.X or 0,lv.Y or 0,lv.Z or 0 end
  end)
  if cfx and cfx*cfx+cfy*cfy+cfz*cfz<1e-9 then cfx=nil end
  local tsz=cfg.npcs_font_size or 13
  -- one hue clock per frame for Chroma NPC; the per-NPC offset further down
  -- spreads neighbouring targets across the wheel so they do not pulse together
  NPC_COL.chue=cfg.npc_chroma and now()*0.12 or 0
  local skel_col=col.npc_skel_col
  if type(skel_col)~="table" or #skel_col<3 then skel_col=NPC_COL.skel
  elseif #skel_col==3 then skel_col={skel_col[1],skel_col[2],skel_col[3],1} end
  -- box swatch resolved once per frame, not once per NPC: the picker always
  -- stores four channels, so the copy only happens if a 3-channel value sneaks in
  local box_col=col.npc_box_col
  if type(box_col)~="table" or #box_col<3 then box_col=NPC_COL.box
  elseif #box_col==3 then box_col={box_col[1],box_col[2],box_col[3],1} end
  -- skeletons resolve their bone array on first draw and keep it on the entry
  for i=1,#list do
    local n=list[i]
    -- the patrol heli is not an NPC: it has its own toggle, so it can be shown
    -- or hidden without touching the Name row (and without the scan/aim/trigger
    -- passes losing it, which key off the entry itself)
    if n and not (n.is_heli and not cfg.npcs_heli) then
      -- the heli has its own hardcoded ceiling instead of the NPC Range
      -- slider, so moving the slider never hides or reveals it
      local lim=n.is_heli and NPC_COL.heli2 or maxsq
      -- cheap cull first: the scan already recorded a position, so anything well
      -- outside the range never pays for a live read or a projection.
      local near=true
      if ox and n.x then
        local cdx=n.x-ox; local cdy=n.y-oy; local cdz=n.z-oz
        near=((cdx*cdx+cdy*cdy+cdz*cdz)<=lim*1.44)
      end
      local wx,wy,wz=nil,nil,nil
      if near then
        -- read the root live: the scan only refreshes a few times a second, and
        -- drawing from cached coordinates made the overlay lag behind the target.
        wx,wy,wz=bone_xyz(n.root)
        if not wx then wx,wy,wz=n.x,n.y,n.z end
      end
      -- behind-camera cull on the live root: the projection, the probe and the
      -- whole bone pass are skipped for a rig the camera cannot see
      if wx and cfx then
        local ax,ay,az=wx-cpx,wy-cpy,wz-cpz
        if ax*cfx+ay*cfy+az*cfz<=0 then wx=nil end
      end
      if wx then
        local d_sq=0
        if ox then
          local dx=wx-ox; local dy=wy-oy; local dz=wz-oz
          d_sq=dx*dx+dy*dy+dz*dz
        end
        if d_sq<=lim then
          local sx,sy=npc_proj(wx,wy,wz,sw,sh)
          -- A point behind the camera still projects onto the screen (mirrored),
          -- which is why targets behind you could draw at a random spot. There
          -- is no camera object on every build, but world-up maps to screen-down
          -- behind the camera, so a one-stud probe is a cheap tell. The same
          -- probe gives the pixels-per-stud scale at the target's depth.
          local behind=false
          local pps=0
          if sx then
            local okp,_,py2=pcall(draw.WorldToScreen,wx,wy+1,wz)
            if okp and type(py2)=="number" then
              pps=sy-py2
              behind=pps<-1
            end
          end
          -- Hardcoded corpse filter, re-read live so a target that dies between
          -- sweeps vanishes immediately instead of waiting for the next pass.
          -- The Humanoid wrapper is cached on the entry by the scan, and the read
          -- is staggered over three frames per rig: a corpse still disappears
          -- within ~50 ms, but the health call no longer runs for every NPC on
          -- every frame.
          local dead=(n.hp or 1)<=0
          local hum=n.hum
          if hum and (not n.hpn or FRAME>=n.hpn) then
            local okh,hv=pcall(PF.hp,hum)
            if okh and type(hv)=="number" then
              n.hp=hv
              if hv<=0 then dead=true end
            end
            n.hpn=FRAME+3
          end
          if sx and not behind and not dead then
            -- n.color is the swatch table itself, so only copy when it is short
            -- of an alpha. the old unconditional copy was one table per NPC per
            -- frame, every frame, for a value the name/dist pickers override anyway.
            local ncol=n.color
            if type(ncol)~="table" or #ncol<3 then ncol=NPC_COL.def
            elseif #ncol==3 then ncol={ncol[1],ncol[2],ncol[3],1} end
            -- one hue per NPC, offset by list index, shared by every element
            -- below. PF.tint returns the base swatch untouched when this is nil.
            local cch=nil
            if cfg.npc_chroma then cch=PF.hue_fill(NPC_COL.ch,(NPC_COL.chue+i*0.07)%1,0.8,1) end
            -- One projection pass per NPC per frame. Every element below reads
            -- the shared screen arrays instead of re-reading and re-projecting
            -- the same bones: the old path walked the head and a foot again for
            -- the box, the head again for the dot and the whole rig again for the
            -- skeleton. That was thousands of extra host calls per frame once a
            -- lot of NPCs were on screen, which is what dragged the FPS down.
            local arr=nil
            if not n.is_heli then
              arr=n.bones
              if not arr then
                arr=npc_bone_array(n.inst or n.obj)
                n.bones=arr
              end
            end
            -- The skeleton is only worth projecting while it is more than a few
            -- pixels tall: below ~1.5 px per stud (about 180 m) the 12 links land
            -- on the same handful of pixels but still cost the same 15 reads and
            -- 15 projections. A failed probe (pps<=0) keeps the full rig, since
            -- the size is unknown.
            local want_skel=cfg.npc_skeleton and arr~=nil and (pps<=0 or pps>=1.5)
            if arr then npc_project_bones(arr,sw,sh,want_skel) end
            -- Screen rect for this NPC, shared by the box, the health bar and the
            -- text rows. The probe's pixels-per-stud gives the real projected
            -- size of a ~5.6-stud rig at any range, so the box hugs the NPC up
            -- close instead of being clipped by a fixed pixel cap. The measured
            -- bone span is only trusted when it agrees with that estimate, which
            -- is what keeps a near-plane bone from blowing the rect up.
            local box_x,box_y,box_w,box_h
            if cfg.npc_box or cfg.npcs_show_health or cfg.npcs_show_name or cfg.npcs_show_dist
              or cfg.npc_headdot or n.is_heli then
              local expect=(pps>0.05 and pps*5.6) or 0
              local hh2=0
              if n.is_heli then
                local tx,ty2=npc_proj(wx,wy+5,wz,sw,sh)
                local ux,uy2=npc_proj(wx,wy-5,wz,sw,sh)
                if tx and ux and uy2>ty2 then hh2=uy2-ty2 end
                expect=expect*1.8
              else
                -- crown and sole come straight from the projection pass above;
                -- the half-stud offsets are applied in screen space with the
                -- probe's pixels-per-stud, so no extra reads or projections
                local tx,ty2,ux,uy2
                if NPC_POK[1] then tx,ty2=NPC_PX[1],NPC_PY[1]-0.55*pps end
                local fi=NPC_POK[12] and 12 or 15
                if NPC_POK[fi] then ux,uy2=NPC_PX[fi],NPC_PY[fi]+0.35*pps end
                if tx and ux and uy2>ty2 then hh2=uy2-ty2 end
              end
              local hh
              if hh2>0 and (expect<=0 or (hh2<=expect*2.2 and hh2>=expect*0.4)) then
                hh=hh2
              elseif expect>4 then
                hh=expect
              else
                -- no usable probe or bones (R6 rig, odd build): distance curve.
                -- This one stays in real metres - the 1530 constant is tuned to
                -- that scale - so it must not switch to the stud readout.
                local dm0=math.floor(math.sqrt(d_sq)*NPC_COL.m)
                hh=clamp(1530/math.max(1,dm0),24,190)*(n.is_heli and 1.26 or 0.9)
              end
              -- last-resort guard: never let one target fill more than two screens
              if hh>sh*2 then hh=sh*2 end
              box_h=hh
              box_w=hh*(n.is_heli and 1.6 or 0.42)
              box_x=sx-box_w*0.5
              box_y=sy-box_h*0.5
            end
            -- the patrol heli is a vehicle, not an NPC: only its name and
            -- distance are drawn, never the tag, box or health bar.
            if cfg.npc_box and not n.is_heli then
              local style=cfg.npc_boxstyle or 1
              local bcol=PF.tint(cch,box_col,1)
              if style==3 then
                local ps=cfg.npc_picstyle or 1
                local tex
                if ps==1 then tex=king_image() elseif ps==2 then tex=chuck_image() elseif ps==3 then tex=pic_image() end
                if tex then
                  -- same opacity rule as the player Picture box: the photo fills
                  -- the box edge to edge, tinted only by the swatch's alpha
                  local pop=clamp(cfg.npc_pic_opacity or 100,10,100)/100
                  local al=math.floor(clamp(box_col[4] or 1,0,1)*pop*255+0.5)
                  if al>0 then draw.Image(tex,box_x,box_y,box_w,box_h,255,255,255,al) end
                else
                  -- texture still downloading: plain box for now
                  draw.Rect(box_x,box_y,box_w,box_h,bcol,0,1)
                end
              elseif style==1 then
                if draw.CornerBox then draw.CornerBox(box_x,box_y,box_w,box_h,bcol) else draw.Rect(box_x,box_y,box_w,box_h,bcol,0,1) end
              else
                draw.Rect(box_x,box_y,box_w,box_h,bcol,0,1)
              end
            end
            -- Name above the target, distance below it, both centred on the box,
            -- exactly the way the player ESP stacks them. The rect is computed
            -- for these rows too, so the name clears the head instead of sitting
            -- on the torso even with Box off.
            local cx=box_x and (box_x+box_w*0.5) or sx
            local name_y=box_y and (box_y-tsz-4) or (sy-tsz-4)
            -- China Hat: same cone as the player ESP, anchored to this NPC's
            -- Head bone and drawn before the text rows so the name can be
            -- lifted above the apex when the hat would otherwise cover it.
            if cfg.npc_hat and not n.is_heli and NPC_POK[1] and pps>0 then
              -- brim squash: the camera's elevation above this rig decides how
              -- open the ring looks. The head sits ~1.6 studs above the root we
              -- have here; at eye level the brim closes to a line, looking down
              -- on a target it opens into a full ellipse.
              local sq=1
              if cpx then
                local hx2,hy2,hz2=wx-cpx,(wy+1.6)-cpy,wz-cpz
                local hl=math.sqrt(hx2*hx2+hy2*hy2+hz2*hz2)
                if hl>0.001 then sq=math.abs(hy2)/hl end
              elseif cfy then
                sq=math.abs(cfy)
              end
              if sq>1 then sq=1 end
              local ay=PF.npc_hat(NPC_PX[1],NPC_PY[1],pps,(cfg.npc_hat_size or 100)/100,
                PF.tint(cch,col.npc_hat_col or NPC_COL.hat,1),sq)
              if ay and ay<name_y then name_y=ay-tsz-4 end
            end
            -- the heli label rides on its own toggle, so it still draws with the
            -- Name row off; the tag has to clear it in that case too
            local has_name=cfg.npcs_show_name or n.is_heli
            if cfg.npc_tag and not n.is_heli then
              -- "NPC" tag sits directly above the name row, so the target type
              -- reads before the name does. with Name off it takes that slot.
              local tag_sz=math.max(8,tsz-2)
              local tag_y=has_name and (name_y-tag_sz-2) or name_y
              local tw=n.tag_w
              if not tw or n.tag_sz~=tag_sz then
                tw=0
                if draw.GetTextSize then tw=draw.GetTextSize("NPC",tag_sz) or 0 end
                n.tag_w=tw; n.tag_sz=tag_sz
              end
              draw.Text(cx-tw*0.5, tag_y, "NPC", PF.tint(cch,col.npc_tag_col or ncol,1), tag_sz)
            end
            if has_name then
              local txt=n.name
              if type(txt)~="string" then txt=tostring(txt or "NPC") end
              local tw=n.name_w
              if not tw or n.name_tsz~=tsz then
                tw=0
                if draw.GetTextSize then tw=draw.GetTextSize(txt,tsz) or 0 end
                n.name_w=tw; n.name_tsz=tsz
              end
              local nc=ncol
              if n.is_heli then nc=col.npc_heli_col or ncol
              else nc=col.npc_name_col or ncol end
              draw.Text(cx-tw*0.5, name_y, txt, PF.tint(cch,nc,1), tsz)
            end
            if cfg.npcs_show_dist then
              -- cache the label per whole game metre (a stud). Formatting a new
              -- string and measuring it for every NPC every frame was pure
              -- garbage, and the integer only changes when the target moves a
              -- metre
              local dm=math.floor(math.sqrt(d_sq))
              local dtxt=n.dtxt
              if not dtxt or n.dm~=dm or n.dtsz~=tsz then
                dtxt=string.format("[%dm]",dm)
                local w=0
                if draw.GetTextSize then w=draw.GetTextSize(dtxt,tsz-2) or 0 end
                n.dtxt=dtxt; n.dtw=w; n.dm=dm; n.dtsz=tsz
              end
              local dist_y=box_y and (box_y+box_h+3) or (sy+4)
              draw.Text(cx-(n.dtw or 0)*0.5, dist_y, dtxt, PF.tint(cch,col.npc_dist_col or ncol,1), tsz-2)
            end
            if want_skel then
              -- Bones were projected once at the top of this NPC; just stroke the
              -- links out of the shared arrays. No reads, no projections, no
              -- allocations here.
              local scol=PF.tint(cch,skel_col,1)
              for k=1,#NPC_LINKS do
                local link=NPC_LINKS[k]
                local a=link[1]; local b=link[2]
                if NPC_POK[a] and NPC_POK[b] then
                  draw.Line(NPC_PX[a],NPC_PY[a],NPC_PX[b],NPC_PY[b],scol,1)
                end
              end
            end
            -- Head dot: the player ESP's world-space ring, on the NPC's Head
            -- bone. The radius is 1.24 studs of head projected at the target's
            -- depth and halved, which is exactly the old probe without the extra
            -- world read and projection. Box height is the fallback.
            if cfg.npc_headdot and arr and NPC_POK[1] then
              local hs=(cfg.npc_headdot_size or 100)/100
              local hr=pps>0 and (0.62*hs*pps) or nil
              if not hr and box_h then hr=box_h*0.11*hs end
              if hr and hr>0.4 then
                local dcol=PF.tint(cch,skel_col,1)
                if hr<2.4 then
                  -- at this size the outline and its shadow overlap and read
                  -- as a black smudge, so keep a filled pip like the players
                  draw.CircleFilled(NPC_PX[1],NPC_PY[1],math.max(hr,1.6),dcol,10)
                else
                  draw.Circle(NPC_PX[1],NPC_PY[1],hr,dcol,math.max(10,math.floor(hr*3)),1)
                end
              end
            end
            if cfg.npcs_show_health and not n.is_heli then
              local hp=n.hp or 100; local mh=n.max_hp or 100
              if mh<1 then mh=100 end
              -- vertical bar hugging the left edge of the target, same as the
              -- player ESP: the gap tracks the box width so it stays close at
              -- range instead of drifting off to the left
              local gap=clamp(box_w*0.12,1.5,5)
              local bxx=box_x-gap; local byy=box_y; local bhh=box_h
              if draw.HealthBar then
                pcall(draw.HealthBar,bxx,byy,bhh,hp,mh)
              else
                -- no native helper on this build: draw the same track and fill
                -- by hand, filled from the bottom like a vertical bar should be
                local pct=clamp(hp/mh,0,1)
                draw.RectFilled(bxx,byy,3,bhh,NPC_COL.hp_bg,1)
                if pct>0 then
                  draw.RectFilled(bxx,byy+bhh*(1-pct),3,bhh*pct,NPC_COL.hp[math.floor(pct*20+0.5)],1)
                end
              end
            end
          end
        end
      end
    end
  end
end

local function run_gunmods()
  -- weapon-stat patches: the only place setgc is touched. Applies once per
  -- toggle change (debounced) or on the Re-apply button - never on a timer.
  pcall(setgc_apply)
end

-- Cheap screen-space gate for the NPC trigger pass.
-- Two projections (head and root) bound the whole rig on screen. If the middle
-- of that segment is further from the crosshair than the segment's own length
-- plus the trigger radius, no bone of the body can be inside the circle, so the
-- NPC is dropped before any per-bone work happens.
--
-- Each NPC bone costs a CFrame read, a position read and a projection, so
-- "Hitbox = Any" on a few dozen rigs was a real per-frame cost. With the gate it
-- is 2 reads and 2 projections for everyone off the crosshair, and the full walk
-- only for the one rig actually under it. Players do not need this: their whole
-- bone set arrives from one GetBonesScreen call (see the player pass).
local function trig_near(cx,cy,rad,hx,hy,hz,rx,ry,rz)
  if not hx then return false end
  local hsx,hsy,hv=draw.WorldToScreen(hx,hy,hz)
  if not rx then return hv==true end
  local rsx,rsy,rv=draw.WorldToScreen(rx,ry,rz)
  if not hv and not rv then return false end
  if not hv or not rv then return true end
  local dx,dy=(hsx+rsx)*0.5-cx,(hsy+rsy)*0.5-cy
  local sx,sy=hsx-rsx,hsy-rsy
  -- the body is wider than the head-root line (arms, feet), so the reach is
  -- padded: a bone may sit off that line by a good fraction of its length
  local lim=rad+math.sqrt(sx*sx+sy*sy)*1.6
  return dx*dx+dy*dy<=lim*lim
end

local function run_trigger()
  if not cfg.trig_on then
    trig_reset()
    trig_next=0
    return
  end
  if trig_next>0 then
    trig_next=trig_next-_dt
    if trig_next<0 then trig_next=0 end
  end
  if ui.open and inside(ui.x,ui.y,ui.w,ui.h) then
    trig_reset()
    return
  end
  if cfg.trig_always==false then
    local hk=bind.trig_key or 0
    if hk==0 or not ekey(hk) then
      trig_reset()
      return
    end
  end
  local lp; pcall(function() lp=entity.GetLocalPlayer() end)
  local okp,players=pcall(entity.GetPlayers)
  if not okp or type(players)~="table" then
    trig_reset()
    return
  end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  local rad=cfg.trig_fov or 6
  local bd=rad*rad
  local cp; pcall(function() cp=camera.GetPosition() end)
  local camx,camy,camz; if cp then camx,camy,camz=cp.X,cp.Y,cp.Z end
  -- the range row is metres, the culls below are studs from the camera
  local maxdist=(cfg.aim_range or 1500)/PF.m
  local best=nil
  local mode=cfg.trig_bone or 6
  -- bone list comes straight from the shared table, so no per-player table (and
  -- no copy loop) is built every frame
  local bones=PF.trigset[mode] or AIM_BONES
  for _,p in ipairs(players) do
    pcall(function()
      if not p.IsValid or p==lp or p.IsLocal or p.IsAlive==false then return end
      if cfg.trig_team and esp_mate(p,lp) then return end
      -- Range cull on the head, in the same units the old per-bone test used
      -- (studs from the camera). One read replaces one read per bone.
      if camx and maxdist then
        local okh,hv=pcall(PF.head,p)
        if okh and hv then
          local ax,ay,az=hv.X-camx,hv.Y-camy,hv.Z-camz
          if ax*ax+ay*ay+az*az>maxdist*maxdist then return end
        end
      end
      -- ONE host call returns every on-screen bone for this player. The old
      -- path resolved each bone by name, read its position and projected it:
      -- ~50 host calls per player per frame with Hitbox = Any, paid on every
      -- frame whether or not the crosshair was anywhere near a body. That is
      -- what made every overlay trail the camera while the trigger was on.
      local okb,bs=pcall(PF.bones,p)
      if not okb or type(bs)~="table" then return end
      for bi=1,#bones do
        local b=bs[bones[bi]]
        if b then
          local sx,sy=b[1],b[2]
          if sx and sy then
            local dx=sx-cx
            local dy=sy-cy
            local d2=dx*dx+dy*dy
            if d2<=bd then
              bd=d2
              -- identity for the reaction delay. GetPlayers() builds a fresh
              -- player object on every call, so the wrapper never matches the
              -- one held from last frame; the UserId is the stable key (the
              -- wrapper's Player field is the fallback, same as esp_mate).
              local uid=p.UserId
              if not uid and p.Player then uid=p.Player.UserId end
              best={sx=sx,sy=sy,p=p,bone=bones[bi],key=uid or p}
            end
          end
        end
      end
    end)
  end
  -- NPC pass for the trigger: same radius test as the players above, nearest
  -- joint inside the circle wins. Own toggle, fed by the NPC scan snapshot.
  if cfg.trig_npc then
    local list=cache_npcs or NPC_LIST
    for ni=1,#list do
      local n=list[ni]
      if n and n.inst and (n.hp or 1)>0 then
        pcall(function()
          local arr=n.bones
          if not arr then arr=npc_bone_array(n.inst); n.bones=arr end
          -- head/root gate: the whole rig is bounded by those two screen points,
          -- so a body nowhere near the crosshair is dropped before the 15 bone
          -- reads below
          local hx,hy,hz=bone_xyz(arr and arr[1])
          if hx then
            local rx,ry,rz=bone_xyz(n.root)
            if not trig_near(cx,cy,rad,hx,hy,hz,rx,ry,rz) then return end
          end
          -- NPC_BONES order: 1 Head, 2-3 torso, 4-9 arms, 10-15 legs.
          -- index 0 is the root part, which is not in the bone array.
          local i0,i1
          if mode==1 then i0,i1=1,1
          elseif mode==2 then i0,i1=2,3
          elseif mode==3 then i0,i1=0,0
          elseif mode==4 then i0,i1=4,9
          elseif mode==5 then i0,i1=10,15
          else i0,i1=1,15 end
          for k=i0,i1 do
            local pr
            if k==0 then pr=n.root else pr=arr[k] end
            if pr then
              local bx,by,bz=bone_xyz(pr)
              if bx then
                local inrange=true
                if camx then
                  local ax=bx-camx; local ay=by-camy; local az=bz-camz
                  if maxdist and (ax*ax+ay*ay+az*az)>maxdist*maxdist then inrange=false end
                end
                if inrange then
                  local sx,sy,v=draw.WorldToScreen(bx,by,bz)
                  if v then
                    local dx=sx-cx; local dy=sy-cy
                    local d2=dx*dx+dy*dy
                    if d2<=bd then
                      bd=d2
                      -- the rig's own stable key from the NPC snapshot (its
                      -- address, or the model when the address is unreadable)
                      best={bx=bx,by=by,bz=bz,sx=sx,sy=sy,p=n.inst,key=n.key or n.inst}
                    end
                  end
                end
              end
            end
          end
        end)
      end
    end
  end
  if cfg.trig_show then
    local q=a(col.c_trig or {1,0.2,0.2,1},0.5)
    if draw.Circle then pcall(draw.Circle,cx,cy,rad,q,32,1) end
    if best then
      pcall(draw.RectFilled,best.sx-2,best.sy-2,4,4,a(col.c_trig or {1,0.2,0.2,1},0.9),2)
    end
  end
  -- Reaction delay, timed per target. The key has to be stable across frames
  -- because a player object is rebuilt on every GetPlayers() call.
  local tid = best and best.key or nil
  if tid~=nil then
    local d=(trig_dw[tid] or 0)+_dt
    trig_dw[tid]=d
    trig_miss=0
    -- latched per target, so a fresh target under the crosshair starts its own
    -- wait even while an earlier one was already past it
    trig_latch=d>=(cfg.trig_react or 0)/1000
  else
    trig_miss=trig_miss+_dt
    -- the engagement is over: every timer starts from zero next time
    if trig_miss>TRIG_GRACE then trig_reset() end
  end
  local ready=best~=nil and trig_latch
  if not ready then return end
  if trig_next>0 then return end
  if cfg.trig_wall and camx then
    -- the 3D point is resolved once, at fire time, instead of every frame for
    -- every bone: the scan works in screen space only
    local bx,by,bz=best.bx,best.by,best.bz
    if not bx and best.bone then bx,by,bz=get_pos(best.p,best.bone) end
    if bx then
      -- the character this bone belongs to: a player object resolves to its
      -- model, an NPC rig is already the model
      local ch=best.p
      local okc,cv=pcall(PF.char,ch)
      if okc and cv then ch=cv end
      if not los_clear(camx,camy,camz,bx,by,bz,ch) then return end
    end
  end
  trig_next=(cfg.trig_delay or 50)/1000
  if utility and utility.MouseClick then
    pcall(utility.MouseClick,"left")
  end
end

local function run_aim()
  aim_tgt=nil
  -- mouse aim only: the aimbot always moves the cursor, it never turns the
  -- camera, so there is no type switch to read.
  if not cfg.aim_on then return end
  local lp; pcall(function() lp=entity.GetLocalPlayer() end)
  local ok,players=pcall(entity.GetPlayers)
  if not ok or type(players)~="table" then return end
  local cx,cy=aim_center()
  local r=cfg.aim_fov or 160
  local style=cfg.aim_priority or 1
  local fstyle=cfg.aim_fovstyle or 1
  -- the range row is metres; every cull below, and AIM_ST.maxdist, works in studs
  local maxdist=(cfg.aim_range or 1500)/PF.m
  -- Held-weapon lookup, re-run only on a swap. It sits above the range cull so
  -- the Bow Lead & Drop cap always sees the bow that is actually in your hands rather
  -- than last frame's, and the lead pass at the bottom of this function reuses
  -- the cached speed, gravity and bow numbers instead of reading them twice.
  if cfg.aim_pred or cfg.aim_bowdrop then
    local tname=""
    local okt,tv=pcall(PF.tool,lp)
    if okt and type(tv)=="string" then tname=tv end
    if tname=="" and lp then
      local okc,ch=pcall(PF.char,lp)
      if okc and ch then
        local fn=ch.FindFirstChildOfClass
        if type(fn)=="function" then
          local okf,tl=pcall(fn,ch,"Tool")
          if okf and tl then
            local okn,nv=pcall(PF.name,tl)
            if okn and type(nv)=="string" then tname=nv end
          end
        end
      end
    end
    if tname~=AIM_ST.gname then
      AIM_ST.gname=tname
      local sp,gr,bw=0,8,false
      if tname~="" and not is_melee_or_utility_tool(tname) then
        local low=tname:lower()
        for gi=1,#PF.bows do
          if low:find(PF.bows[gi][1],1,true) then
            bw=true; gr=PF.bows[gi][4]
            -- full-draw speed, held constant so the aim point does not move
            -- with the draw charge
            sp=PF.bows[gi][2]+PF.bows[gi][3]; break
          end
        end
        if not bw then
          for gi=1,#PF.guns do
            if low:find(PF.guns[gi][1],1,true) then
              sp=PF.guns[gi][2]; gr=PF.guns[gi][3]; break
            end
          end
          if sp<=0 then sp=1400 end
        end
      end
      AIM_ST.gspeed=sp; AIM_ST.ggrav=gr; AIM_ST.gbow=bw
    end
  end
  -- Bow lead & drop holds up out to 300 game metres, so the aim range is capped while
  -- an arrow is what is actually being compensated. Every range in this function
  -- is already in studs and the game counts one stud as one metre, so the cap is
  -- a plain 300 - the same unit the distance labels print.
  if cfg.aim_bowdrop and AIM_ST.gbow and maxdist>300 then maxdist=300 end
  local camx,camy,camz
  local cp; pcall(function() cp=camera.GetPosition() end)
  if cp then camx,camy,camz=cp.X,cp.Y,cp.Z end
  -- Aim pass: players first, then NPCs below. Scoring lives in aim_try, so this
  -- loop allocates no closures and no per-bone candidate tables (it used to
  -- build a table per bone per player per frame, plus two closures per bone).
  local aimbone=cfg.aim_bone or 1
  local blist=PF.aimset[aimbone] or AIM_BONES
  AIM_ST.cx,AIM_ST.cy=cx,cy
  AIM_ST.r=r; AIM_ST.fstyle=fstyle; AIM_ST.style=style
  -- Players are only engaged inside the Player Range row, the same way the NPC
  -- pass honours NPC Range, so the aimbot can never lock a target the player ESP
  -- is hiding. Aimbot Range stays the outer bound: whichever is smaller wins.
  -- aim_try culls on AIM_ST.maxdist, so narrow it for this pass and put it back
  -- afterwards, leaving the NPC pass measuring against Aimbot Range.
  AIM_ST.aimmax=maxdist
  AIM_ST.maxdist=maxdist
  if cfg.esp_maxdist and cfg.esp_maxdist/PF.m<AIM_ST.maxdist then AIM_ST.maxdist=cfg.esp_maxdist/PF.m end
  AIM_ST.camx,AIM_ST.camy,AIM_ST.camz=camx,camy,camz
  AIM_ST.best=nil; AIM_ST.best_s=nil
  for _,p in ipairs(players) do
    pcall(function()
      if not p.IsValid or p==lp or p.IsLocal or p.IsAlive==false then return end
      if cfg.aim_team and esp_mate(p,lp) then return end
      local char=nil
      local okc,cv=pcall(PF.char,p)
      if okc then char=cv end
      if not char then return end
      local nm=p.Name
      -- health is only read when the priority is Low HP: it used to be a host
      -- call per player per frame even with the default Crosshair priority
      local health=100
      if style==3 then
        local okh0,hv0=pcall(PF.hp,p)
        if okh0 then health=tonumber(hv0) or 100 end
      end
      if aimbone==8 then
        -- Closest to Crosshair: every on-screen bone is a candidate, but only
        -- the ones already inside the FOV pay for a part lookup, a position read
        -- and the Wall Check walk inside aim_try. ONE GetBonesScreen
        -- call replaces 17 FindFirstChild + 17 position reads + 17 projections
        -- per player per frame, and on a busy server most players are nowhere
        -- near the crosshair, so they now cost a single call.
        local okb,bs=pcall(PF.bones,p)
        if not okb or type(bs)~="table" then return end
        local any=false
        for bi=1,#blist do
          local b=bs[blist[bi]]
          if b and b[1] and b[2] then
            any=true
            if aim_in_fov(b[1]-cx,b[2]-cy,r,fstyle) then
              local okf,pr=pcall(PF.find,char,blist[bi])
              if okf and pr then
                local okp,pp=pcall(PF.pos,pr)
                if okp and pp then aim_try(pp.X,pp.Y,pp.Z,pr,p,nm,health,char) end
              end
            end
          end
        end
        if not any then
          local okhp,hp=pcall(PF.head,p)
          if okhp and hp then aim_try(hp.X,hp.Y,hp.Z,nil,p,nm,health,char) end
        end
      else
        -- named bone: the first part that resolves wins, same as before
        local part,hx,hy,hz
        for bi=1,#blist do
          local okf,pr=pcall(PF.find,char,blist[bi])
          if okf and pr then
            local okp,pp=pcall(PF.pos,pr)
            if okp and pp then part=pr; hx,hy,hz=pp.X,pp.Y,pp.Z; break end
          end
        end
        if not hx and aimbone==1 then
          local okhp,hp=pcall(PF.head,p)
          if okhp and hp then hx,hy,hz=hp.X,hp.Y,hp.Z end
        end
        if not part then
          local okf,pr=pcall(PF.find,char,"HumanoidRootPart")
          if okf and pr then
            part=pr
            if not hx then
              local okp,pp=pcall(PF.pos,pr)
              if okp and pp then hx,hy,hz=pp.X,pp.Y,pp.Z end
            end
          end
        end
        if hx then aim_try(hx,hy,hz,part,p,nm,health,char) end
      end
    end)
  end
  -- Player Range only bound the player pass; the NPC pass below measures against
  -- Aimbot Range (then narrows to NPC Range itself).
  AIM_ST.maxdist=AIM_ST.aimmax
  local best,best_s=AIM_ST.best,AIM_ST.best_s
  -- NPC pass: same scorer, fed by the NPC snapshot the ESP scanner keeps warm.
  -- Its own toggle, so NPC ESP can stay off. Skipped once a player is dead-centre
  -- on the crosshair, and skipped entirely when "Target Players over NPC & Heli"
  -- is on and a player is already in the FOV, so an NPC can never steal a shot
  -- from a visible player.
  if cfg.aim_npc and best_s~=0 and not (cfg.aim_pp and best~=nil) then
    local list=cache_npcs or NPC_LIST
    -- NPCs are only engaged inside the NPC ESP Range row, so the aimbot
    -- can never lock onto a rig the NPC ESP is hiding. The aimbot range still
    -- applies as the outer bound - whichever of the two is smaller wins. aim_try
    -- culls on AIM_ST.maxdist, so narrow it for this pass and put it back after.
    AIM_ST.aimmax=AIM_ST.maxdist
    AIM_ST.nmax=cfg.npcs_max_dist or 300*M_PER_STUD
    if AIM_ST.nmax<1 then AIM_ST.nmax=300*M_PER_STUD end
    if AIM_ST.maxdist>AIM_ST.nmax/PF.m then AIM_ST.maxdist=AIM_ST.nmax/PF.m end
    -- NPC_BONES order: 1 Head, 2-3 torso, 4-9 arms, 10-15 legs. index 0 is the
    -- root part, which is not in the bone array.
    local i0,i1
    if aimbone==1 then i0,i1=1,1
    elseif aimbone==2 then i0,i1=2,3
    elseif aimbone==3 then i0,i1=0,0
    elseif aimbone==4 then i0,i1=4,6
    elseif aimbone==5 then i0,i1=7,9
    elseif aimbone==6 then i0,i1=10,12
    elseif aimbone==7 then i0,i1=13,15
    else i0,i1=1,15 end
    for ni=1,#list do
      local n=list[ni]
      -- the heli rides in this list for the ESP, but it has no humanoid rig: it
      -- is aimed at by its own block below, never by a bone lookup
      if n and n.inst and (n.hp or 1)>0 and not n.is_heli then
        local arr=n.bones
        if not arr then
          local okb,b=pcall(npc_bone_array,n.inst)
          if okb then arr=b end
          n.bones=arr
        end
        if arr then
          for k=i0,i1 do
            local pr
            if k==0 then pr=n.root else pr=arr[k] end
            if pr then
              local hx,hy,hz=bone_xyz(pr)
              if hx then aim_try(hx,hy,hz,pr,n.inst,n.name,n.hp or 100,n.inst) end
            end
          end
        end
      end
    end
    AIM_ST.maxdist=AIM_ST.aimmax
    best=AIM_ST.best; best_s=AIM_ST.best_s
  end
  -- Patrol heli: its own toggle, its own ceiling and its own aim point. A heli
  -- has no humanoid rig, so it never enters the bone loop above - the fuselage
  -- part the NPC scan already resolved is the target. Range is the same 1000
  -- game metres the ESP gives it, still under Aimbot Range, and the
  -- "Target Players over NPC & Heli" row applies to it exactly like an NPC, so it
  -- can never steal a shot from a player already under the crosshair. It sits
  -- outside the Target NPC block so the heli can be aimed at on its own.
  if cfg.aim_heli and best_s~=0 and not (cfg.aim_pp and best~=nil) then
    local h=NPC_HELI
    if h and h.inst and h.root then
      local hl=1000/PF.m
      if AIM_ST.maxdist>hl then AIM_ST.maxdist=hl end
      local hx,hy,hz=bone_xyz(h.root)
      if hx then aim_try(hx,hy,hz,h.root,h.inst,"Patrol Helicopter",h.hp or 5000,h.inst) end
      AIM_ST.maxdist=AIM_ST.aimmax
      best=AIM_ST.best; best_s=AIM_ST.best_s
    end
  end
  -- Auto gun lead + bow lead & drop.
  -- The held tool is read on every swap, so the speed, fall rate and class used
  -- below always match what is in your hands. Nothing here is a setting: the
  -- prediction for the weapon you are holding is picked from that weapon's own
  -- numbers.
  --
  -- Both classes use the whole flight time. An arrow is flown by the server, and
  -- a bullet is resolved from the shot the client sends (origin + direction) once
  -- the server has it, so in both cases the target keeps travelling until the
  -- round gets there. Cutting the lead back by an assumed network lag left the
  -- crosshair consistently behind a strafing target, so the lag term is gone and
  -- the lead is the plain v * tof projection the bow already used.
  -- Melee and utility tools get nothing, and neither does an empty hand.
  if cfg.aim_pred or cfg.aim_bowdrop then
    -- Arrow speed is pinned to a full draw. Scaling it by the live draw charge
    -- made the drop compensation explode on a half-drawn arrow and yank the
    -- view upward during and right after the shot, so the aim point uses the
    -- top speed the bow can reach and stays put.
    local sp=AIM_ST.gspeed or 0
    local gbow=AIM_ST.gbow
    -- a gun is only predicted while Auto Gun Lead is on; an arrow is predicted
    -- whenever either helper is on, so turning one off cannot break the bow
    if sp>0 and best and camx and (gbow or cfg.aim_pred) then
      local dx0=best.x-camx; local dy0=best.y-camy; local dz0=best.z-camz
      local dist=math.sqrt(dx0*dx0+dy0*dy0+dz0*dz0)
      -- Target travel. The live root velocity is exact and carries none of the
      -- animation noise a bone-to-bone delta does, so it is used whenever the
      -- wrapper exposes it (players). NPC rigs have no Velocity, so those keep
      -- the old estimate from where the aim point was last frame.
      local vx,vy,vz=0,0,0
      local okv,lvx,lvy,lvz=pcall(PF.vel,best.obj)
      local live=okv and type(lvx)=="number"
      if live then
        vx,vy,vz=lvx,lvy,lvz
      else
        vx,vy,vz=AIM_ST.vx or 0,AIM_ST.vy or 0,AIM_ST.vz or 0
        -- a jump too big to be a walking target is a bone swap or a target
        -- switch, so the estimate resets instead of flinging the crosshair
        -- across the screen. the ceiling is a fast sprint, not the old
        -- 200 studs/s, which let a head-to-torso swap through as a shake.
        local px,py,pz=AIM_ST.px,AIM_ST.py,AIM_ST.pz
        if px and _dt and _dt>0.0001 then
          local mx,my,mz=best.x-px,best.y-py,best.z-pz
          if mx*mx+my*my+mz*mz<=(70*_dt)*(70*_dt) then
            vx=vx*0.55+(mx/_dt)*0.45
            vy=vy*0.55+(my/_dt)*0.45
            vz=vz*0.55+(mz/_dt)*0.45
          else
            vx,vy,vz=0,0,0
          end
        else
          vx,vy,vz=0,0,0
        end
        -- idle animation micro-movement is not travel: deadband it so the lead
        -- does not drift while a target stands still
        local vsp=math.sqrt(vx*vx+vy*vy+vz*vz)
        if vsp<2.5 then vx,vy,vz=0,0,0 end
        AIM_ST.vx,AIM_ST.vy,AIM_ST.vz=vx,vy,vz
      end
      AIM_ST.px,AIM_ST.py,AIM_ST.pz=best.x,best.y,best.z
      -- flight time to the bone, then one refinement at the lead point so the
      -- lead is not sized from a distance the target has already left
      local tof=dist/sp
      local qx=dx0+vx*tof; local qy=dy0+vy*tof; local qz=dz0+vz*tof
      tof=math.sqrt(qx*qx+qy*qy+qz*qz)/sp
      if tof>2 then tof=2 end
      local ax,ay,az=best.x,best.y,best.z
      -- The lead offset is low-passed in world space. The velocity sample is
      -- noisy frame to frame, and applying it raw made the crosshair buzz on
      -- both camera and mouse aim; the filter keeps the average lead while
      -- killing the per-frame jitter. It is seeded with the full lead on a new
      -- target instead of easing up from the last one (or from zero): that ramp
      -- was the other half of the under-prediction, leaving the crosshair behind
      -- for the first tenth of a second of every engagement.
      local lx,ly,lz=AIM_ST.lx,AIM_ST.ly,AIM_ST.lz
      if not lx or AIM_ST.lchar~=best.char then
        AIM_ST.lchar=best.char
        lx,ly,lz=vx*tof,vy*tof,vz*tof
      else
        -- 16 rather than 10: a strafe reversal has to swing the whole lead, and
        -- the slower filter spent ~0.2 s catching up. Arrows keep the old 10 -
        -- their lead is several times longer, so the same smoothing matters more
        -- there and the bow was already tracking well.
        local k=(_dt or 0.016)*(gbow and 10 or 16)
        if k>1 then k=1 end
        lx=lx+(vx*tof-lx)*k
        ly=ly+(vy*tof-ly)*k
        lz=lz+(vz*tof-lz)*k
      end
      AIM_ST.lx,AIM_ST.ly,AIM_ST.lz=lx,ly,lz
      ax=ax+lx
      ay=ay+ly
      az=az+lz
      local grav=AIM_ST.ggrav or 8
      if gbow then
        -- arrows: Bow Lead & Drop owns the holdover. Across the 300 game metre cap the
        -- longest flight is ~1.4 s (hunting bow), so the clamp only guards
        -- against a bad gravity read - it never shortens a real shot.
        if cfg.aim_bowdrop then
          local lift=0.5*grav*tof*tof
          if lift>400 then lift=400 end
          ay=ay+lift
        end
      elseif cfg.aim_pred then
        -- bullets: the drop is real over the whole flight, but a few studs at
        -- sniper range, so the cap sits well under a body
        local lift=0.5*grav*tof*tof
        if lift>40 then lift=40 end
        ay=ay+lift
      end
      if ax~=best.x or ay~=best.y or az~=best.z then
        local asx,asy,av=draw.WorldToScreen(ax,ay,az)
        if av then
          -- ax/ay/az stay on the entry as the point the crosshair is pulled to;
          -- x/y/z keep the raw bone so the target line still ends on the bone
          best.ax,best.ay,best.az=ax,ay,az
          best.sx,best.sy=asx,asy
        end
      end
    else
      -- no target, or a melee/empty hand: drop the sample so the next engage
      -- does not compute a lead from a stale point
      AIM_ST.px=nil
      AIM_ST.lx,AIM_ST.ly,AIM_ST.lz=nil,nil,nil
      AIM_ST.lchar=nil
    end
  else
    -- both toggles off: drop the sample and forget the cached gun, so switching
    -- either feature back on re-reads the held weapon and its prediction speed
    AIM_ST.px=nil
    AIM_ST.lx,AIM_ST.ly,AIM_ST.lz=nil,nil,nil
    AIM_ST.lchar=nil
    AIM_ST.gname=nil
  end
  aim_tgt=best
  local key=bind.aim_key or 0
  local held=(key~=0) and not ui.capture and ekey(key) or false
  local engaged=(held and best~=nil) or false
  local dz=cfg.aim_dz or 0
  if not engaged then
    aim_dz_state=0
    return
  end
  local sm=math.floor(cfg.aim_smooth or 1)
  if sm<1 then sm=1 end
  local ex,ey=best.sx-cx,best.sy-cy
  local dist=math.sqrt(ex*ex+ey*ey)
  if aim_dz_tgt~=best.name then aim_dz_state=0; aim_dz_tgt=best.name end
  local zs=dz
  local zstart=zs*2.2
  if aim_dz_state==1 then
    if dist>zstart then aim_dz_state=0 end
  elseif dist<=zs then
    aim_dz_state=1
  end
  if aim_dz_state==0 then
    if dist<0.5 then return end
    local sx,sy=aim_step(ex,ey,sm)
    if math.abs(sx)>0.001 or math.abs(sy)>0.001 then
      aim_emit(sx,sy)
    end
  end
end
local function draw_aim()
  if not cfg.aim_on then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  local r=cfg.aim_fov or 160
  local hue=(now()*0.12)%1
  local chroma=cfg.aim_fovchroma
  if cfg.aim_fovcircle then
    local cfov=col.c_fov or {0.45,0.78,1,1}
    local c=hue_or(chroma and hsv(hue,0.8,1) or nil,cfov,1)
    local st=cfg.aim_fovstyle or 1
    if st==1 then
      draw.Circle(cx,cy,r,c,48,1.2)
    elseif st==2 then
      xh_poly({{cx-r,cy-r},{cx+r,cy-r},{cx+r,cy+r},{cx-r,cy+r}},c,1.2)
    elseif st==3 then
      xh_poly({{cx,cy-r},{cx+r,cy},{cx,cy+r},{cx-r,cy}},c,1.2)
    else
      -- corner brackets: one horizontal and one vertical arm per corner
      local k=r*0.28
      draw.Line(cx-r,cy-r,cx-r+k,cy-r,c,1.2); draw.Line(cx-r,cy-r,cx-r,cy-r+k,c,1.2)
      draw.Line(cx+r,cy-r,cx+r-k,cy-r,c,1.2); draw.Line(cx+r,cy-r,cx+r,cy-r+k,c,1.2)
      draw.Line(cx-r,cy+r,cx-r+k,cy+r,c,1.2); draw.Line(cx-r,cy+r,cx-r,cy+r-k,c,1.2)
      draw.Line(cx+r,cy+r,cx+r-k,cy+r,c,1.2); draw.Line(cx+r,cy+r,cx+r,cy+r-k,c,1.2)
    end
  end
  -- active-state tag under the FOV region, so it is obvious which prediction
  -- helpers are running. Bow Lead & Drop is appended to the right of Auto Gun
  -- Lead, clamped to the screen so a huge FOV cannot push it off the bottom edge.
  local lbl=nil
  if cfg.aim_pred then lbl="(Auto Gun Lead)" end
  if cfg.aim_bowdrop then
    if lbl then lbl=lbl.." (Bow Lead & Drop)" else lbl="(Bow Lead & Drop)" end
  end
  if lbl then
    local lw=0
    if draw.GetTextSize then lw=draw.GetTextSize(lbl,12) or 0 end
    local ly=cy+r+8
    if ly>sh-14 then ly=sh-14 end
    local lc=hue_or(chroma and hsv(hue,0.8,1) or nil,col.c_fov or {0.45,0.78,1,1},1)
    draw.Text(cx-lw*0.5,ly,lbl,lc,12)
  end
  if cfg.aim_tline and aim_tgt then
    local tx,ty,tz=aim_tgt.x,aim_tgt.y,aim_tgt.z
    if aim_tgt.part and aim_tgt.part.Position then
      local pp=aim_tgt.part.Position
      tx,ty,tz=pp.X,pp.Y,pp.Z
    elseif aim_tgt.obj then
      local p=aim_tgt.obj
      local part=nil
      local aimbone=cfg.aim_bone or 1
      local blist=PF.aimset[aimbone] or AIM_BONES
      local char=nil
      local okc,cv=pcall(PF.char,p)
      if okc then char=cv end
      if char then
        for bi=1,#blist do
          local okf,pr=pcall(PF.find,char,blist[bi])
          if okf and pr then
            local okp,pp=pcall(PF.pos,pr)
            if okp and pp then part=pr; tx,ty,tz=pp.X,pp.Y,pp.Z; break end
          end
        end
      end
    end
    local sx,sy,vis=draw.WorldToScreen(tx,ty,tz)
    if vis then
      local ctl=col.c_tline or {1,1,1,1}
      local c=hue_or(chroma and hsv((hue+0.5)%1,0.8,1) or nil,ctl,1)
      draw.Line(cx,cy,sx,sy,c,1.2)
    end
  end
end

