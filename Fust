-- drag grip. only drawn while the menu is on screen, because that is the only
-- time the panels can be grabbed (with it closed every click belongs elsewhere)
local function hud_grip(x,y,ap)
  if ui.appear<=0.9 then return end
  for r=0,1 do for c=0,1 do
    draw.RectFilled(x+c*4, y+r*4, 1.6,1.6, a(theme.faint,0.9*ap), 0)
