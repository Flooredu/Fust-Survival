-- Wall Check line of sight, shared by the aimbot and the triggerbot.
--
-- The old test was one raycast.IsVisible from the camera to the bone, and it
-- lied both ways. The ray ended exactly on the bone, so the last thing it
-- touched was the target's own body - a "blocked" answer on a shot that was
-- wide open. And it started at the camera, which in third person sits behind
-- the character and can be buried in a wall or inside the player's own head,
-- which reads as blocked from the very first stud. That is the half of the time
-- the trigger refused to fire at a target standing in the open.
--
-- This walks the same line with raycast.Cast, which reports the instance it hit
-- instead of a bare boolean, so only world geometry counts as a wall: anything
-- belonging to the target (body, hat, held tool) or to the local player is
-- stepped over. The cast stops a fraction of a stud short of the bone, so the
-- target's own surface cannot register at the far end, and a first hit within a
-- stud of the eye means the camera is inside geometry, so that is stepped over
-- too. Four steps covers own body -> target body -> wall. Any raycast error
-- fails open: the check must never cost a shot it cannot justify.
local function los_clear(ox,oy,oz,tx,ty,tz,char)
  local dx,dy,dz=tx-ox,ty-oy,tz-oz
  local d2=dx*dx+dy*dy+dz*dz
  if d2<1e-6 then return true end
  local d=math.sqrt(d2)
  local ux,uy,uz=dx/d,dy/d,dz/d
  -- stop short of the bone: the aim point sits inside the target's own part, so
  -- a full-length ray always ends on the body it is aiming at
  local len=d-0.4
  if len<0.2 then return true end
  local ex,ey,ez=ox+ux*len,oy+uy*len,oz+uz*len
  local cast=raycast and raycast.Cast
  local vnew=Vector3 and Vector3.New
  -- Cast is documented for Vector3 arguments only, so the points are wrapped;
  -- if either half is missing on this build, fall back to the boolean test that
  -- does take six numbers
  if type(cast)~="function" or type(vnew)~="function" then
    local ok,v=pcall(raycast.IsVisible,ox,oy,oz,ex,ey,ez)
    return (not ok) or v~=false
  end
  -- the local character is resolved once a frame, not once per candidate
  if PF.lfr~=FRAME then
    PF.lfr=FRAME
    local lch=nil
    local lp
    pcall(function() lp=entity.GetLocalPlayer() end)
    if lp then
      local okc,c=pcall(PF.char,lp)
      if okc then lch=c end
    end
    PF.lch=lch
  end
  local lch=PF.lch
  local px,py,pz=ox,oy,oz
  local t=0
  -- the far end never moves, so only the start point is rebuilt per step
  local vEnd=vnew(ex,ey,ez)
  for step=1,4 do
    local ok,hit,pos,dist,inst=pcall(cast,vnew(px,py,pz),vEnd)
    if not ok or not hit or not inst then return true end
    local own=false
    if inst==char then
      own=true
    elseif char then
      local okd,isd=pcall(PF.isd,inst,char)
      if okd and isd then own=true end
    end
    if not own and lch then
      if inst==lch then
        own=true
      else
        local okd,isd=pcall(PF.isd,inst,lch)
        if okd and isd then own=true end
      end
    end
    local nd=tonumber(dist) or 0
    if nd<0 then nd=0 end
    -- a hit this close to the eye is the camera clipping into geometry, not a
    -- wall in front of the player: step out of it and keep looking
    if not own and not (step==1 and nd<=0.6) then return false end
    -- a zero-distance hit means the ray started inside that part (the eye is in
    -- the local head), so dist cannot carry us past it: hop clear of the body
    local adv=nd+0.05
    if own and nd<0.5 then adv=1.1 end
    t=t+adv
    if t>=len-0.05 then return true end
    px,py,pz=ox+ux*t,oy+uy*t,oz+uz*t
  end
  return true
end

-- Scoring state for one aim pass, plus the scorer itself. Keeping this in a
-- real function with a state table means no closure is allocated per player or
-- per NPC per frame, and each bone only reads the property the chosen priority
-- actually needs.
local AIM_ST={cx=0,cy=0,r=0,fstyle=1,style=1,maxdist=0,
  camx=nil,camy=nil,camz=nil,best=nil,best_s=nil}
local function aim_try(hx,hy,hz,part,obj,name,health,char)
  local camx,camy,camz=AIM_ST.camx,AIM_ST.camy,AIM_ST.camz
  local pd3
  if camx then
    local dx3=hx-camx
    local dy3=hy-camy
    local dz3=hz-camz
    pd3=math.sqrt(dx3*dx3+dy3*dy3+dz3*dz3)
    if AIM_ST.maxdist and pd3>AIM_ST.maxdist then return end
  end
  local sx,sy,vis=draw.WorldToScreen(hx,hy,hz)
  if not vis then return end
  local dx,dy=sx-AIM_ST.cx,sy-AIM_ST.cy
  if not aim_in_fov(dx,dy,AIM_ST.r,AIM_ST.fstyle) then return end
  if cfg.aim_wall and camx then
    if not los_clear(camx,camy,camz,hx,hy,hz,char) then return end
  end
  local sd=dx*dx+dy*dy
  local score=sd
  if AIM_ST.style==2 then
    -- camera distance when we have it, otherwise the entity's own DistanceTo
    if pd3 then score=pd3
    else
      local okd,dv=pcall(PF.dist,obj)
      score=(okd and dv) or 0
    end
  elseif AIM_ST.style==3 then
    score=health or 100
  end
  if not AIM_ST.best_s or score<AIM_ST.best_s then
    AIM_ST.best_s=score
    AIM_ST.best={x=hx,y=hy,z=hz,sx=sx,sy=sy,sd=sd,name=name,obj=obj,part=part,char=char}
  end
end

local function get_part(p,name,char)
  if not p then return nil end
  if not char then
    local okc,c=pcall(PF.char,p)
    if okc then char=c end
  end
  if not char then return nil end
  local fn=char.FindFirstChild
  if type(fn)~="function" then return nil end
  local okf,part=pcall(fn,char,name)
  if not (okf and part) then return nil end
  local okp,pos=pcall(PF.pos,part)
  if okp and pos then return part,pos.X,pos.Y,pos.Z end
  return nil
end

local function get_pos(p,bone,char)
  if not p then return nil end
  if bone=="Head" then
    local okh,hp=pcall(PF.head,p)
    if okh and hp then return hp.X,hp.Y,hp.Z end
  end
  -- the character is resolved once per player by the caller: reading it again
  -- for every bone was a host call per bone per player per frame
  local part,px,py,pz=get_part(p,bone,char)
  if part then return px,py,pz end
  local okq,pp=pcall(PF.pos,p)
  if okq and pp then
    if bone=="Head" then return pp.X,pp.Y+1.6,pp.Z end
    return pp.X,pp.Y,pp.Z
  end
  return nil
end

