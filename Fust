  [0x0D]="ENTER",[0x10]="SHIFT",[0x11]="CTRL",[0x12]="ALT",[0x1B]="ESC",[0x20]="SPACE",
  [0x25]="LEFT",[0x26]="UP",[0x27]="RIGHT",[0x28]="DOWN",[0x2D]="INS",[0x2E]="DEL",
  [0xA0]="LSHIFT",[0xA1]="RSHIFT",[0x43]="C",[0x46]="F",[0x51]="Q",[0x45]="E",[0x58]="X",[0x56]="V"}
for i=0,9 do VK[0x30+i]=tostring(i) end
for i=0,25 do VK[0x41+i]=string.char(65+i) end
for i=1,12 do VK[0x6F+i]="F"..i end
local function vkname(vk) if not vk or vk==0 then return "NONE" end return VK[vk] or string.format("0x%02X",vk) end

