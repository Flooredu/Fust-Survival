    draw.RectFilled(bx,pry,18,18,pc,3)
    draw.Rect(bx,pry,18,18,a(theme.line,1),3,1)
    if inside(bx,pry,18,18) and ui.m.click then
      p.h,p.s,p.v=to_hsv(pc); p.al=pc[4] or 1; ui.m.click=false
    end
  end
  if not ui.m.down then p.drag=nil end
end

