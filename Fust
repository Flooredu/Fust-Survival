    for i,item in ipairs(p.items) do local iy=p.y+3+(i-1)*24; local hot=inside(p.x,iy,p.w,24)
      if hot then draw.RectFilled(p.x+2,iy,p.w-4,24,a(theme.accent,0.22),0) end
      tmid(p.x+10,iy,24,item, a(theme.text, hot and 1 or 0.8),12) end
    return
  end
  local x,y=p.x,p.y; local w,h=PICKER_W,PICKER_H
  if ui.m.click and not inside(x,y,w,h) then ui.picker=nil; ui.m.click=false; return end
  -- floating panel: soft shadow, rounded body, accent hairline and an inner
  -- echo line for depth.
  for i=4,1,-1 do draw.RectFilled(x-i*2.5,y-i*1.5,w+i*5,h+i*4,{0,0,0,0.10*theme.opacity},6+i*2) end
  draw.RectFilled(x,y,w,h, a(theme.panel_hi,0.99),6)
  draw.Rect(x,y,w,h, a(theme.accent,0.55),6,1)
  draw.Rect(x+2,y+2,w-4,h-4, a(theme.line,0.16),6,1)
  local pad=12
  local svx,svy=x+pad,y+pad; local svw,svh=200,120
  local huecol=hsv(p.h,1,1)
  -- saturation/value field. 48 columns of the white->hue ramp with a 24 step
  -- black shade on top: enough steps that the gradients do not band.
  grad_h(svx,svy,svw,svh,{1,1,1,1},huecol,48)
  for i=0,23 do draw.RectFilled(svx,svy+i*(svh/24),svw,svh/24+1,{0,0,0,i/23},0) end
  draw.Rect(svx,svy,svw,svh,a(theme.line,1),0,1)
  -- the sv handle needs a dark ring under it, otherwise it disappears on the
  -- light corner of the field. the drag is applied BEFORE the handle is drawn
  -- so the handle does not lag a frame behind the cursor.
  if inside(svx,svy,svw,svh) and ui.m.click then p.drag="sv" end
  if p.drag=="sv" then p.s=clamp((ui.m.x-svx)/svw,0,1); p.v=clamp(1-(ui.m.y-svy)/svh,0,1) end
  local hx1,hy1=svx+p.s*svw, svy+(1-p.v)*svh
  draw.Circle(hx1,hy1,6.5,{0,0,0,0.75},16,2.5)
  draw.Circle(hx1,hy1,5.5,{1,1,1,1},16,1.5)
  -- hue rail
  local hx,hy=svx+svw+8,svy; local hw2,hh=18,svh
  for i=0,47 do draw.RectFilled(hx,hy+i*(hh/48),hw2,hh/48+1,hsv(i/48,1,1),0) end
  draw.Rect(hx,hy,hw2,hh,a(theme.line,1),0,1)
  if inside(hx,hy,hw2,hh) and ui.m.click then p.drag="hue" end
  if p.drag=="hue" then p.h=clamp((ui.m.y-hy)/hh,0,1) end
  local hy2=hy+p.h*hh
  draw.Rect(hx-3,hy2-3,hw2+6,6,{0,0,0,0.6},1,2.5)
  draw.Rect(hx-3,hy2-3,hw2+6,6,{1,1,1,1},1,1.5)
  -- alpha ramp over a checkerboard so a fading color stays visible
  local ax,ay=svx,svy+svh+10; local aw,ah=svw+8+hw2,12
  swatch_checker(ax,ay,aw,ah,{0.13,0.15,0.20,1},{0.08,0.09,0.13,1},4)
  grad_h(ax,ay,aw,ah,{huecol[1],huecol[2],huecol[3],0},{huecol[1],huecol[2],huecol[3],1},40)
  draw.Rect(ax,ay,aw,ah,a(theme.line,1),0,1)
