local theme = {
  accent  = {0.25,0.72,1.00,1}, accent2={0.42,0.48,1.00,1}, accent2_base={0.42,0.48,1.00,1},
  base    = {0.020,0.027,0.055,1}, base2={0.012,0.018,0.040,1},
  panel   = {0.055,0.075,0.125,1}, panel_hi={0.085,0.110,0.175,1},
  field   = {0.105,0.135,0.200,1}, field_hi={0.140,0.180,0.260,1},
  rail    = {0.110,0.145,0.210,1}, line={0.200,0.290,0.420,1},
  text    = {0.87,0.93,1.00,1}, sub={0.48,0.60,0.74,1}, faint={0.30,0.40,0.54,1},
  ok      = {0.25,0.75,0.85,1}, bad={0.90,0.35,0.50,1},
  round=4, opacity=1.0,
}
local function a(c,al) return {c[1],c[2],c[3],(c[4] or 1)*(al or 1)*theme.opacity} end
local function mix(c1,c2,t) return {c1[1]+(c2[1]-c1[1])*t,c1[2]+(c2[2]-c1[2])*t,c1[3]+(c2[3]-c1[3])*t,(c1[4] or 1)+((c2[4] or 1)-(c1[4] or 1))*t} end
local function clamp(v,lo,hi) return v<lo and lo or (v>hi and hi or v) end
local function ease_out(t) t=clamp(t,0,1); local f=1-t; return 1-f*f*f end
local function hsv(h,s,v) h=(h%1)*6; local i=math.floor(h); local f=h-i; local p=v*(1-s); local q=v*(1-s*f); local u=v*(1-s*(1-f))
  if i==0 then return{v,u,p,1} elseif i==1 then return{q,v,p,1} elseif i==2 then return{p,v,u,1} elseif i==3 then return{p,q,v,1} elseif i==4 then return{u,p,v,1} else return{v,p,q,1} end end
local function to_hsv(c) local r,g,b=c[1],c[2],c[3]; local mx=math.max(r,g,b); local mn=math.min(r,g,b); local d=mx-mn; local h=0
  if d>0 then if mx==r then h=((g-b)/d)%6 elseif mx==g then h=(b-r)/d+2 else h=(r-g)/d+4 end h=h/6 end
  return h, (mx==0 and 0 or d/mx), mx end
-- chroma only swaps the hue. the alpha - the opacity slider inside that colour's
-- picker - still multiplies through, otherwise turning Chroma Visuals on makes
-- every faded colour snap back to fully opaque.
-- The result is memoised for the current frame (COL_MEM is cleared at the top of
-- OnFrame): a colour table per player per feature was thousands of throwaway
-- tables a second, and the GC pauses from them are the occasional stutter when
-- a lot is on screen. With chroma off the colour depends only on the base swatch
-- and the alpha, so every target can share one table.
local COL_MEM={}
-- Chroma path: one scratch table, refilled per call. Every caller hands the
-- result straight to a draw call (which copies the channels immediately), so
-- sharing the buffer removes the table chroma used to allocate several times per
-- target per frame - the GC churn behind the stutter on a busy screen.
local COL_SCR={1,1,1,1}
local function hue_or(ch,base,al)
  al=(al or 1)*theme.opacity
  if ch then
    local c=COL_SCR
    c[1]=ch[1]; c[2]=ch[2]; c[3]=ch[3]; c[4]=(base[4] or 1)*al
    return c
  end
  local m=COL_MEM[base]
  if not m then m={}; COL_MEM[base]=m end
  local c=m[al]
  if not c then
    c={base[1],base[2],base[3],(base[4] or 1)*al}
    m[al]=c
  end
  return c
end

local _dt=0.016
-- Metres per stud, declared up here because the slider widget needs it before
-- PF exists. The game's own distance readouts - the kill feed, the compass
-- markers and the sea-depth chip - all print raw studs with an "m" suffix, so
-- to the player one stud is one "game metre". Everything the player reads is
-- therefore printed in studs, while cfg range values stay in real metres so a
-- saved profile keeps the world distance it was tuned with.
local M_PER_STUD=0.28
local anim={}
-- Global frame counter. now() can be frozen on some builds, so every cadence in
-- the ESP passes (staggered health reads, slow live-position refreshes) counts
-- frames instead of seconds. It is bumped once at the top of OnFrame.
local FRAME=0
local function approach(k,target,spd) local v=anim[k]; if v==nil then v=target end
  v=v+(target-v)*clamp(_dt*(spd or 12),0,1); anim[k]=v; return v end

local function scr() local w,h=draw.GetScreenSize(); return w or 1920, h or 1080 end
local function mouse_pos() local x,y=utility.GetMousePos(); return x or 0, y or 0 end
local function now() return utility.GetTime and utility.GetTime() or os.clock() end
-- IsKeyDown is documented as returning a boolean, but the binding is free to
-- hand back a number instead, and a strict "== true" would then read every
-- key as released - which would silently disable the menu toggle, the bind
-- capture and every hotkey at once. anything that is not nil, false or
-- zero counts as down. pcall because a bad vk must never take the frame down.
local function ekey(vk)
  local ok,r=pcall(input.IsKeyDown,vk)
  if not ok or r==nil or r==false or r==0 then return false end
  return true
end

