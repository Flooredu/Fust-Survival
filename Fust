-- snowfall for the menu. particles live in one table (the main chunk is close
-- to Lua's 200-local ceiling, so this is a single local instead of one per
-- field). flakes are split into depth layers: far ones are small, slow and dim,
-- near ones are larger, faster, brighter and get a soft glow. most draw as tiny
-- six-armed crystals with a bright core (the biggest get side branches); the
-- smallest stay soft dots. each flake drifts down and sideways, sways on a
-- per-flake sine, twinkles and slowly spins, then wraps back to the top when it
-- leaves the panel. the field is seeded once and never reseeded on window height
-- changes: the menu height animates on every tab switch, and reseeding when h
-- drifted made every flake teleport each frame. wraps use the live height
-- instead. the bottom of the panel stays clean like the rest of the menu.
local SNOW={ parts={}, n=0, w=0 }
function SNOW.seed(n,w,h)
  SNOW.n=n; SNOW.w=w
  local p=SNOW.parts
  for i=1,n do
    if not p[i] then p[i]={} end
    local f=p[i]
    local z=math.random()
    f.z=z
    f.x=math.random()*w
    f.y=math.random()*h
    f.r=0.55+z*2.4+math.random()*0.5
    f.vy=9+z*46+math.random()*8
    f.amp=2+z*11
    f.ph=math.random()*6.283
    f.sp=0.45+z*0.9+math.random()*0.35
    f.al=0.16+z*0.58
    f.vx=(math.random()-0.5)*(3+z*10)
    f.tw=math.random()*6.283
    f.rot=math.random()*6.283
    f.spin=(math.random()-0.5)*1.1
  end
  for i=n+1,#p do p[i]=nil end
  -- far flakes first so near flakes and their glow sit on top.
  table.sort(p,function(a,b) return a.z<b.z end)
end
function SNOW.update(n,w,h)
  if n~=SNOW.n then SNOW.seed(n,w,h)
  elseif w~=SNOW.w then
    -- width changed (rare): keep every flake but rescale its X so nothing jumps.
    local s=SNOW.w>0 and (w/SNOW.w) or 1
    for i=1,SNOW.n do SNOW.parts[i].x=SNOW.parts[i].x*s end
    SNOW.w=w
  end
  local p=SNOW.parts
  for i=1,SNOW.n do
    local f=p[i]
    f.y=f.y+f.vy*_dt
    f.x=f.x+f.vx*_dt
    f.rot=f.rot+f.spin*_dt
    if f.y>h+3 then f.y=-3; f.x=math.random()*w end
    if f.x<-4 then f.x=f.x+w+8 elseif f.x>w+4 then f.x=f.x-w-8 end
  end
end
function SNOW.draw(x,y,w,h,alpha)
  local p=SNOW.parts
  local tm=now()
  -- snow follows the menu accent instead of a fixed white: the line work leans
  -- toward the accent, the glow blends accent/accent2, and the cores stay a
  -- brighter version of the accent so the flakes still pop against the panel.
  local ac=theme.accent; local ac2=theme.accent2
  local gc=mix(ac,ac2,0.35)
  local lc=mix(ac,{1,1,1},0.12)
  local cc=mix(ac,{1,1,1},0.52)
  for i=1,SNOW.n do
    local f=p[i]
    local fx=x+f.x+math.sin(tm*f.sp+f.ph)*f.amp
    local fy=y+f.y
    if fy>=y-3 and fy<=y+h+3 and fx>=x-3 and fx<=x+w+3 then
      local a=f.al*alpha*(0.82+0.18*math.sin(tm*1.6+f.tw))
      if f.z>0.55 then
        draw.CircleFilled(fx,fy,f.r*(2.0+f.z),{gc[1],gc[2],gc[3],a*0.22},8)
      end
      if f.z>0.28 then
        local L=f.r*(2.4+f.z)
        local col={lc[1],lc[2],lc[3],a*0.92}
        local c1,s1=math.cos(f.rot),math.sin(f.rot)
        local c2,s2=math.cos(f.rot+1.0472),math.sin(f.rot+1.0472)
        local c3,s3=math.cos(f.rot+2.0944),math.sin(f.rot+2.0944)
        draw.Line(fx-c1*L,fy-s1*L,fx+c1*L,fy+s1*L,col,1)
        draw.Line(fx-c2*L,fy-s2*L,fx+c2*L,fy+s2*L,col,1)
        draw.Line(fx-c3*L,fy-s3*L,fx+c3*L,fy+s3*L,col,1)
        draw.CircleFilled(fx,fy,math.max(0.7,f.r*0.32),{cc[1],cc[2],cc[3],a},6)
        -- side branches on the biggest crystals, one pair per arm.
        if f.z>0.84 then
          local bl=L*0.34
          for k=0,5 do
            local ang=f.rot+k*1.0472
            local bx=fx+math.cos(ang)*L*0.62
            local by=fy+math.sin(ang)*L*0.62
            local ca,sa=math.cos(ang+0.9),math.sin(ang+0.9)
            local cb,sb=math.cos(ang-0.9),math.sin(ang-0.9)
            draw.Line(bx,by,bx+ca*bl,by+sa*bl,col,1)
            draw.Line(bx,by,bx+cb*bl,by+sb*bl,col,1)
          end
        end
      else
        draw.CircleFilled(fx,fy,f.r,{lc[1],lc[2],lc[3],a},6)
      end
    end
  end
end

-- =========================================================================
-- ESP: players, extras and radar.
-- Source of truth is the Project Vector entity cache documented in the API
-- dump: entity.GetPlayers() gives Name/Team/ToolName/Health, and each player
-- exposes GetBounds(), GetBonesScreen() and DistanceTo(). Every colour hangs
-- off the toggle it paints, as an inline chip like the World tab, so the
-- swatch sits beside the feature instead of in a separate column.
-- =========================================================================
local ESP_SKEL={
  -- R15
  {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
  {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
  {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
  {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
  {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
  -- R6 fallbacks: same table, missing bones are simply skipped
  {"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"},
}
-- teammates only exist when both sides are on a team; a teamless NPC is never
-- treated as friendly just because the local player has no team either
local function esp_mate(p,lp)
  if not (lp and lp.HasTeam and p.HasTeam) then return false end
  return p.Team==lp.Team
end

-- Property readers used through pcall(fn, arg). The per-player closures these
-- replace were allocated every frame for every player, which is the other half
-- of the GC churn behind the occasional stutter when a lot is on screen.
local PF={
  -- studs per metre. Every range row in the menu and every distance readout is
  -- metres; every engine value (position, DistanceTo, muzzle velocity) is studs.
  -- All conversions go through this one number so the UI can never disagree with
  -- the cull that uses it.
  m=0.28,
  dist=function(p) return p:DistanceTo() end,
  name=function(p) return p.Name end,
  tool=function(p) return p.ToolName end,
  bounds=function(p) return p:GetBounds() end,
  bones=function(p) return p:GetBonesScreen() end,
  head=function(p) return p.HeadPosition end,
  hp=function(p) return p.Health end,
  mhp=function(p) return p.MaxHealth end,
  -- Reflection readers for the instance accessors. Reading a property through
  -- pcall(fn,obj) instead of pcall(function() return obj.X end) removes one
  -- closure per read; the NPC pass does thousands of those a second once
  -- skeletons are on, and the GC work from them was pure overhead.
  cframe=function(o) return o.CFrame end,
  cfpos=function(cf) return cf.Position end,
  pos=function(o) return o.Position end,
  addr=function(o) return o.Address end,
  cls=function(o) return o.ClassName end,
  prim=function(o) return o.PrimaryPart end,
  rootpart=function(o) return o.RootPart end,
  get=function(o,k) return o[k] end,
  find=function(o,n) return o:FindFirstChild(n) end,
  char=function(p)
    local c=p.Character
    if c then return c end
    local g=p.GetCharacter
    if type(g)=="function" then return g(p) end
    return nil
  end,
  desc=function(o) return o:GetDescendants() end,
  -- reused scratch buffers for the china-hat ring, so it stops allocating two
  -- tables per player per frame
  xs={}, ys={},
}
-- Player skeleton without GetBonesScreen. That call returns a fresh
-- {boneName -> {x,y}} dictionary for every player every frame - roughly 17
-- small tables per player - and the GC work from it is what made the overlay
-- jitter once a lot of players were on screen. player:GetBoneScreen(name)
-- returns three plain scalars for a single bone instead, so the draw pass
-- projects into shared scratch arrays and allocates nothing per frame.
PF.bonescreen=function(p,n) return p:GetBoneScreen(n) end
PF.bone_names={"Head","UpperTorso","LowerTorso",
  "LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand",
  "LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot",
  "Torso","Left Arm","Right Arm","Left Leg","Right Leg"}
PF.bone_idx={}
PF.bone_links={}
-- built inside a function so its loop variables do not eat into the main
-- chunk's 200-local budget
;(function()
  local names=PF.bone_names
  for i=1,#names do PF.bone_idx[names[i]]=i end
  local L=PF.bone_links
  for i=1,#ESP_SKEL do
    local a=PF.bone_idx[ESP_SKEL[i][1]]
    local b=PF.bone_idx[ESP_SKEL[i][2]]
    if a and b then L[#L+1]={a,b} end
  end
end)()
PF.px,PF.py,PF.pok={},{},{}
-- precomputed red->green ramp for the health number, so the per-player mix()
-- does not allocate three tables every frame
local HP_RAMP={}
for i=0,20 do HP_RAMP[i]=mix({0.95,0.28,0.32,1},{0.35,0.95,0.50,1},i/20) end

-- Picture art for the named styles. each texture loads lazily on first use
-- (LoadImage dedupes by URL, so this is one download per session, and nothing
-- downloads unless that style is actually selected). the yimg wrapper serves
-- webp, so Lebron has a jpeg retry; nil just means "not ready yet".
local PIC_URL="https://s.yimg.com/lo/mysterio/api/30692778d6a3a094db06b8caf63069ef7a87a893c16b5e891271e10ff781cca7/"
  .."lightyear_networkapi/resizefill_w960%3Bquality_80%3Bformat_webp/"
  .."https://media.zenfs.com/en/hardwood_heroics_234/84963e67515a9830b7105907f8a1088e.jpg"
local PIC_URL_ALT="https://media.zenfs.com/en/hardwood_heroics_234/84963e67515a9830b7105907f8a1088e.jpg"
local CHUCK_URL="https://pbs.twimg.com/profile_images/2054703704486424576/__Kn5mRy.jpg"
local KING_URL="https://i.pinimg.com/736x/74/4f/b1/744fb1971ead089e6942f41b005793f3.jpg"
local pic_lebron,pic_chuck,pic_king={},{},{}
-- one loader for every style. cache is {primary,alt}; the alt handle is only
-- requested after the primary reports a decode failure.
local function tex_get(cache,url,alt)
  if not (draw.LoadImage and draw.Image and draw.ImageLoaded) then return nil end
  if not cache[1] then pcall(function() cache[1]=draw.LoadImage(url) end) end
  local ok=false
  if cache[1] then pcall(function() ok=draw.ImageLoaded(cache[1]) end) end
  if ok then return cache[1] end
  local bad=false
  if cache[1] and draw.ImageFailed then pcall(function() bad=draw.ImageFailed(cache[1]) end) end
  if bad and alt then
    if not cache[2] then pcall(function() cache[2]=draw.LoadImage(alt) end) end
    local ok2=false
    if cache[2] then pcall(function() ok2=draw.ImageLoaded(cache[2]) end) end
    if ok2 then return cache[2] end
  end
  return nil
end
local function pic_image() return tex_get(pic_lebron,PIC_URL,PIC_URL_ALT) end
local function chuck_image() return tex_get(pic_chuck,CHUCK_URL) end
local function king_image() return tex_get(pic_king,KING_URL) end

local function run_esp()
  if not cfg.esp_on then return end
  local sw,sh=scr(); local hw=sw*0.5
  local lp; pcall(function() lp=entity.GetLocalPlayer() end)
  local ok,players=pcall(entity.GetPlayers)
  if not ok or type(players)~="table" then return end
  local tsz=cfg.esp_textsize or 12
  local md=(cfg.esp_maxdist or 1500)/PF.m
  -- 0 means "show nothing": the slider is an on/off gate at the bottom of its
  -- travel, so nothing renders at all instead of everything
  if md<=0 then return end
  local chroma_on=cfg.esp_chroma
  local chue=now()*0.12
  local c_box=col.c_box or {0.45,0.78,1,1}
  local c_bone=col.c_enemy or {0.95,0.35,0.4,1}
  local c_name=col.c_name or {1,1,1,1}
  local c_dist=col.c_dist or {0.87,0.93,1,1}
  local c_weapon=col.c_weapon or c_name
  local c_tr=col.c_tracer or c_bone
  local c_hat=col.c_hat or c_name
  for idx,p in ipairs(players) do
    -- one pcall per player: a character that despawns mid-frame skips itself
    -- instead of taking the whole ESP pass down
    pcall(function()
      if p==lp or p.IsLocal then return end
      if p.IsAlive==false then return end
      local mate=esp_mate(p,lp)
      if mate and cfg.esp_team then return end
      local dist=0
      local okd,dv=pcall(PF.dist,p)
      if okd and dv then dist=dv end
      -- 0 was handled up front; anything above it is a hard cap in metres, and
      -- md is already converted to the studs DistanceTo returns
      if dist>md then return end
      local ch=chroma_on and hsv((chue+idx*0.07)%1,0.75,1) or nil
      local pname,ptool
      local okn,nv=pcall(PF.name,p); if okn then pname=nv end
      local okt,tv=pcall(PF.tool,p); if okt then ptool=tv end
      local b
      local okb,bv=pcall(PF.bounds,p); if okb then b=bv end
      local bx,by,bw,bh
      if b and b.valid and (b.w or 0)>1 and (b.h or 0)>1 then bx,by,bw,bh=b.x,b.y,b.w,b.h end
      -- Head point first: it feeds the anchor, the head dot and the hat.
      -- GetBoneScreen returns three scalars, so the anchor costs one host call
      -- and no table, unlike the per-player bone dictionary it replaces.
      local head_x,head_y
      local okhb,hx,hy,hvis=pcall(PF.bonescreen,p,"Head")
      if okhb and hx and hy and hvis~=false then head_x,head_y=hx,hy end
      local anchor_x,anchor_y=head_x,head_y
      -- world-space head vector, only read when the hat or the dot needs it
      local hp
      if cfg.esp_hat or cfg.esp_headdot then
        local okh,hv=pcall(PF.head,p); if okh then hp=hv end
      end
      -- hat first: the name has to clear the apex or it hides the cone
      local hat_x,hat_y,hat_v
      if cfg.esp_hat and hp then
        local hs=(cfg.esp_hat_size or 100)/100
        hat_x,hat_y,hat_v=draw.WorldToScreen(hp.X,hp.Y+1.16*hs,hp.Z)
      end
      if cfg.esp_box and bx then
        local c=hue_or(ch,c_box,1)
        local x0,y0,w0,h0=bx-2,by-2,bw+4,bh+4
        if cfg.esp_boxstyle==1 then
          if draw.CornerBox then draw.CornerBox(x0,y0,w0,h0,c) else draw.Rect(x0,y0,w0,h0,c,0,1) end
        elseif cfg.esp_boxstyle==3 then
          -- Picture: Lebron fills the box with his photo. the other two Picture
          -- styles are plain boxes, so switching between them adds no extra
          -- fill, band or inset over the target.
          local ps=cfg.esp_picstyle or 1
          local tex
          if ps==1 then tex=king_image() elseif ps==2 then tex=chuck_image() elseif ps==3 then tex=pic_image() end
          if tex then
            -- the photo fills the box edge to edge, with no outline over it.
            -- draw.Image tint channels are 0-255, unlike every other colour here.
            -- Chroma tint the photo with the hue the box outline would take;
            -- without chroma the tint stays white so the photo is untouched.
            local pop=clamp(cfg.esp_pic_opacity or 100,10,100)/100
            local al=math.floor(clamp(c[4],0,1)*pop*255+0.5)
            local tr,tg,tb=255,255,255
            if ch then
              tr=math.floor(clamp(c[1],0,1)*255+0.5)
              tg=math.floor(clamp(c[2],0,1)*255+0.5)
              tb=math.floor(clamp(c[3],0,1)*255+0.5)
            end
            if al>0 then draw.Image(tex,x0,y0,w0,h0,tr,tg,tb,al) end
          else
            -- photo still downloading / failed to load: plain box for now
            draw.Rect(x0,y0,w0,h0,c,0,1)
          end
        else draw.Rect(x0,y0,w0,h0,c,0,1) end
      end
      -- health bar hugs the box. a fixed gap is fine up close, but at range the
      -- projected box is only a few pixels wide, so the same 8px reads as a bar
      -- pinned way off to the left. the gap tracks the box width instead, held
      -- inside a hard 1.5..5 px clamp so it never drifts off at either extreme.
      -- vertical extent is the box itself (no inflation), matching the API
      -- example, so the bar is exactly as tall as the target it belongs to.
      if cfg.esp_hp and bx then
        local hh,mh=0,100
        local okh2,hv2=pcall(PF.hp,p); if okh2 and hv2 then hh=hv2 end
        local okm2,mv2=pcall(PF.mhp,p); if okm2 and mv2 then mh=mv2 end
        local gap=clamp(bw*0.12,1.5,5)
        pcall(draw.HealthBar,bx-gap,by,bh,hh,mh)
        -- the bar has no width parameter (a few px at most), so the number sits
        -- to its left, right-aligned against it and centred on its height, with
        -- the same red->green ramp the bar uses. only drawn when the bar itself
        -- is on: the row is hidden with it, and this re-checks so a stale config
        -- value cannot leave a number floating next to nothing.
        if cfg.esp_hptext then
          -- the bar draws its own border/shadow a couple of px past its x, so
          -- the number keeps a fixed 10 px gutter from that edge instead of
          -- sitting right against it
          local fsz=math.max(8,tsz-3)
          local frac=clamp(mh>0 and hh/mh or 0,0,1)
          local ht=string.format("%d",math.floor(hh+0.5))
          local tw2,th2=ts(ht,fsz)
          local hc=HP_RAMP[math.floor(frac*20+0.5)]
          draw.Text(math.max(1,bx-gap-10-tw2),by+(bh-th2)*0.5,ht,hue_or(ch,hc,1),fsz)
        end
      end
      local name_y=by and (by-tsz-4) or (anchor_y and anchor_y-tsz-6)
      if cfg.esp_hat and hat_v and (not name_y or hat_y<name_y) then name_y=hat_y-tsz-4 end
      local cx = bx and (bx+bw*0.5) or anchor_x
      if cfg.esp_name and pname and cx and name_y then
        local tw=ts(pname,tsz); draw.Text(cx-tw*0.5,name_y,pname,hue_or(ch,c_name,1),tsz)
      end
      local stack_y=by and (by+bh+3) or (anchor_y and anchor_y+4)
      if cfg.esp_dist and cx and stack_y then
        local dl=string.format("%dm",math.floor(dist*PF.m)); local tw=ts(dl,tsz-2)
        draw.Text(cx-tw*0.5,stack_y,dl,hue_or(ch,c_dist,0.9),tsz-2)
        stack_y=stack_y+(tsz-2)+1
      end
      if cfg.esp_weapon and cx and stack_y and ptool and ptool~="" then
        local tw=ts(ptool,tsz-2)
        draw.Text(cx-tw*0.5,stack_y,ptool,hue_or(ch,c_weapon,0.9),tsz-2)
      end
      if cfg.esp_tracer then
        local oy=(cfg.esp_tracer_from==1) and sh or ((cfg.esp_tracer_from==3) and 0 or sh*0.5)
        local tx,ty
        if bx then tx,ty=bx+bw*0.5,by+bh elseif anchor_x then tx,ty=anchor_x,anchor_y end
        if tx then draw.Line(hw,oy,tx,ty,hue_or(ch,c_tr,1),1) end
      end
      if cfg.esp_skel and (bx or head_x) then
        -- One GetBoneScreen call per bone returns scalars, so this whole pass
        -- allocates nothing. It replaces GetBonesScreen, whose per-player
        -- {bone -> {x,y}} dictionary was the GC churn behind the overlay
        -- jitter once a lot of players were on screen.
        local px,py,pok=PF.px,PF.py,PF.pok
        local names=PF.bone_names
        for i=1,#names do
          local okp,vx,vy,vis=pcall(PF.bonescreen,p,names[i])
          -- cull here: a bone outside the frame is dropped before any line is
          -- built from it, so an off-screen rig costs no draws
          if okp and vx and vy and vis~=false and vx>-8 and vy>-8 and vx<sw+8 and vy<sh+8 then
            px[i],py[i],pok[i]=vx,vy,true
          else
            pok[i]=nil
          end
        end
        local c=hue_or(ch,c_bone,0.9)
        local links=PF.bone_links
        for i=1,#links do
          local a,b=links[i][1],links[i][2]
          if pok[a] and pok[b] then draw.Line(px[a],py[a],px[b],py[b],c,1) end
        end
      end
      -- head dot: a plain outlined circle centred on the Head bone, sized in
      -- WORLD space like the china hat instead of a fixed pixel count. the
      -- slider is a percentage of the hat's brim radius (0.62 studs), so at
      -- 100% the dot is exactly the hat's footprint. the radius comes from
      -- projecting a point one head-height above the head and halving the
      -- on-screen delta, which means it shrinks with distance at exactly the
      -- same rate as the player it belongs to - no blob left floating over a
      -- dot-sized target. box height is the fallback when HeadPosition is null
      -- or that probe point is off screen.
      if cfg.esp_headdot and head_x then
        local hs=(cfg.esp_headdot_size or 100)/100
        local hr
        if hp then
          local _,hy2,hv2=draw.WorldToScreen(hp.X,hp.Y+1.24*hs,hp.Z)
          if hv2 then hr=math.abs(hy2-head_y)*0.5 end
        end
        if not hr and bx then hr=bh*0.11*hs end
        if hr and hr>0.4 then
          local c=hue_or(ch,c_bone,1)
          if hr<2.4 then
            -- at this size a 1px outline is mostly its own black shadow pass:
            -- the ring and the shadow rings overlap and the dot reads as a
            -- black smudge on the head. a filled pip keeps the colour and
            -- still marks the head at range.
            draw.CircleFilled(head_x,head_y,math.max(hr,1.6),c,10)
          else
            draw.Circle(head_x,head_y,hr,c,math.max(10,math.floor(hr*3)),1)
          end
        end
      end
      if cfg.esp_hat and hp and hat_v then
        -- wireframe cone around the head: brim ring in the XZ plane, ribs up to
        -- the projected apex, so it sits on the head in world space
        local hs=(cfg.esp_hat_size or 100)/100
        local brimy=hp.Y+0.44*hs; local rad=0.62*hs
        local xs,ys=PF.xs,PF.ys
        local ring_ok=true
        for i=0,15 do
          local t=i/16*math.pi*2
          local sx,sy,v=draw.WorldToScreen(hp.X+math.cos(t)*rad,brimy,hp.Z+math.sin(t)*rad)
          if not v then ring_ok=false; break end
          xs[i+1]=sx; ys[i+1]=sy
        end
        if ring_ok then
          local c=hue_or(ch,c_hat,1)
          -- projected brim radius, measured from the brim's own centre. below
          -- ~3px the 16 rim segments and 8 ribs land on the same pixels, so the
          -- black shadow pass of every line wins and the hat reads as a black
          -- cap sitting on the head. swap the wireframe for one filled cone
          -- silhouette there: same colour, no overlap, no black.
          local bcx,bcy,bcv=draw.WorldToScreen(hp.X,brimy,hp.Z)
          local pxr=0
          if bcv then
            for i=1,16 do
              local dx,dy=xs[i]-bcx,ys[i]-bcy
              pxr=pxr+math.sqrt(dx*dx+dy*dy)
            end
            pxr=pxr/16
          end
          if pxr>0 and pxr<3 then
            if draw.PolyFilled then
              draw.PolyFilled({{hat_x,hat_y},{xs[1],ys[1]},{xs[9],ys[9]}},c)
            end
          else
            for i=1,16 do local j=i%16+1; draw.Line(xs[i],ys[i],xs[j],ys[j],c,1) end
            for i=1,16,2 do draw.Line(hat_x,hat_y,xs[i],ys[i],c,1) end
          end
        end
      end
    end)
  end
end

-- =========================================================================
-- CHAMS: native body hulls through draw.ChamsPlayer, which merges overlapping
-- limb hulls before rendering so the body reads as one silhouette with no
-- seams. Filled is style 0, Outline is style 1.
-- =========================================================================
local function run_chams()
  -- chams live under ESP -> Players, so Enable ESP is their master too. without
  -- this the bodies kept rendering after the ESP pass had already returned.
  if not (cfg.esp_on and cfg.chams_on) then return end
  if not draw.ChamsPlayer then return end
  local lp; pcall(function() lp=entity.GetLocalPlayer() end)
  local ok,players=pcall(entity.GetPlayers)
  if not ok or type(players)~="table" then return end
  local c1=col.c_chams or {1,0.22,0.34,1}
  local chroma_on=cfg.esp_chroma; local chue=now()*0.12
  local style=clamp((cfg.chams_mode or 1)-1,0,1)
  -- chams share the Players Max Distance slider; 0 gates them off completely
  -- and every value above it is a hard cap in metres
  local md=(cfg.esp_maxdist or 1500)/PF.m
  if md<=0 then return end
  local idx=0
  for _,p in ipairs(players) do
    idx=idx+1
    pcall(function()
      if p==lp or p.IsLocal or p.IsAlive==false then return end
      if cfg.esp_team and esp_mate(p,lp) then return end
      local dist=0
      local okd,dv=pcall(PF.dist,p); if okd and dv then dist=dv end
      if dist>md then return end
      -- opacity comes from the Chams swatch; chroma only replaces the hue
      local c=hue_or(chroma_on and hsv((chue+idx*0.07)%1,0.8,1) or nil,c1,1)
      draw.ChamsPlayer(p,c,style)
    end)
  end
end

local function run_radar()
  if not cfg.rad_on then return end
  local sw,sh=scr()
  local rsz=cfg.rad_size or 160
  local rng=math.max(0.5,cfg.rad_range or 50)/PF.m
  local al=clamp((cfg.rad_alpha or 80)/100,0,1)
  local rx=clamp(sw*(cfg.rad_x or 88)/100-rsz*0.5,0,math.max(0,sw-rsz))
  local ry=clamp(sh*(cfg.rad_y or 8)/100,0,math.max(0,sh-rsz))
  local cx,cy=rx+rsz*0.5,ry+rsz*0.5
  draw.RectFilled(rx-2,ry-2,rsz+4,rsz+4,{0,0,0,0.55*al},8)
  draw.Rect(rx-2,ry-2,rsz+4,rsz+4,{1,1,1,0.10*al},8,1)
  for i=1,3 do draw.Circle(cx,cy,(rsz*0.5-3)*i/3,{1,1,1,0.07*al},40,1) end
  draw.Line(cx,ry+4,cx,ry+rsz-4,{1,1,1,0.07*al},1)
  draw.Line(rx+4,cy,rx+rsz-4,cy,{1,1,1,0.07*al},1)
  draw.CircleFilled(cx,cy,2.6,{0.3,1,0.55,al},10)
  local look=camera.GetLookVector(); local cam=camera.GetPosition()
  if not look or not cam then return end
  -- rotate the world into the camera's horizontal frame: forward = look.XZ,
  -- right = (-look.Z, look.X). deriving it this way keeps the radar from being
  -- mirrored, so a target straight ahead sits at the top of the panel.
  local fx,fz=look.X,look.Z
  local fl=math.sqrt(fx*fx+fz*fz); if fl<1e-6 then fl=1 end
  fx,fz=fx/fl,fz/fl
  local rtx,rtz=-fz,fx
  local lp; pcall(function() lp=entity.GetLocalPlayer() end)
  -- distance labels are measured from the player, not the camera, so third
  -- person or freecam does not shift the readout. fall back to the camera when
  -- the local player has no root part yet.
  local ox,oy,oz=cam.X,cam.Y,cam.Z
  if lp then
    local lpp=lp.Position
    if lpp then ox,oy,oz=lpp.X,lpp.Y,lpp.Z end
  end
  local ok,players=pcall(entity.GetPlayers)
  if ok and type(players)=="table" then
    local chroma_on=cfg.esp_chroma; local chue=now()*0.12
    -- one scratch colour for the blip and its label: two throwaway tables per
    -- dot per frame was pure GC churn on a busy radar
    local rc={1,1,1,1}
    for idx,p in ipairs(players) do
      pcall(function()
        if p==lp or p.IsLocal then return end
        if p.IsAlive==false then return end
        local mate=esp_mate(p,lp)
        if cfg.esp_team and mate then return end
        local pos=p.Position
        if not pos then return end
        local dx,dz=pos.X-cam.X,pos.Z-cam.Z
        local dd=math.sqrt(dx*dx+dz*dz)
        if dd>rng then return end
        local px=cx+(dx*rtx+dz*rtz)*(rsz*0.5-8)/rng
        local py=cy-(dx*fx+dz*fz)*(rsz*0.5-8)/rng
        local cb=col.c_enemy or {0.95,0.35,0.4,1}
        -- blips use the Skeleton swatch, so that picker's opacity still applies;
        -- radar Opacity multiplies on top of it, chroma only swaps the hue
        local c=hue_or(chroma_on and hsv((chue+idx*0.07)%1,0.75,1) or nil,cb,al)
        local ca=mate and c[4]*0.5 or c[4]
        -- facing tick: the target's own LookVector, run through the same
        -- camera-relative rotation as the blip, so the line points the way the
        -- player is actually facing on the radar. the stub starts at the dot's
        -- rim and keeps a fixed pixel length, so it reads the same close up and
        -- at the edge of range instead of collapsing into the dot.
        local lv; pcall(function() lv=p.LookVector end)
        if lv then
          local lx,lz=lv.X or 0, lv.Z or 0
          local ll=math.sqrt(lx*lx+lz*lz)
          if ll>1e-6 then
            local ex=(lx*rtx+lz*rtz)/ll
            local ey=-(lx*fx+lz*fz)/ll
            local r0=mate and 2.2 or 3
            draw.Line(px+ex*r0,py+ey*r0,px+ex*(r0+7),py+ey*(r0+7),{c[1],c[2],c[3],ca*0.85},1)
          end
        end
        rc[1]=c[1]; rc[2]=c[2]; rc[3]=c[3]; rc[4]=ca
        draw.CircleFilled(px,py,mate and 2.2 or 3,rc,10)
        -- straight-line distance from the local player, in metres. the label
        -- sits to the right of the blip and flips left when it would leave the
        -- panel, so a target on the radar edge still gets a readable number.
        local ddx,ddz=pos.X-ox,pos.Z-oz
        local ddy=pos.Y-oy
        local dm=math.floor(math.sqrt(ddx*ddx+ddy*ddy+ddz*ddz)*PF.m)
        local txt=dm.."m"
        local tw=ts(txt,9)
        -- 11px clears the facing tick (dot rim + 7px stub), so the number never
        -- sits on top of the direction line
        local tx2=px+11
        if tx2+tw>rx+rsz-3 then tx2=px-11-tw end
        draw.Text(tx2,py-5,txt,rc,9)
      end)
    end
  end
  draw.Text(rx+6,ry+rsz-14,"RADAR",{1,1,1,0.35*al},9)
end

-- =========================================================================
-- HUD: watermark, keybind list and feature bar.
-- They read the menu's own state (cfg toggles + the bind table), so a feature
-- shows up the moment it is switched on and drops out when it is switched off.
-- No gameplay state is touched: these are overlays over the menu's settings.
-- =========================================================================
local hud_start=now()

-- shared chrome, so the three overlays read as one family: stacked shadow
-- shells, base fill, frame plus inner echo line, accent rule on the top edge
-- and the tapered corner brackets the menu uses. ap is the panel's fade.
local function hud_panel(x,y,w,h,ap,r)
  r=r or theme.round
  local e=mix(theme.accent,theme.accent2,0.5)
  for i=3,1,-1 do
    draw.RectFilled(x-i*2, y-i*1.5, w+i*4, h+i*3, {0,0,0,0.07*ap}, r+i*2)
  end
  draw.RectFilled(x,y,w,h, {theme.base[1],theme.base[2],theme.base[3],0.90*ap}, r)
  draw.Rect(x,y,w,h, a(theme.line,0.85*ap), r, 1)
  draw.Rect(x+3,y+3,w-6,h-6, a(theme.line,0.16*ap), r, 1)
  draw.RectFilled(x+r, y, w-r*2, 2, {e[1],e[2],e[3],0.9*ap}, 0)
  corners(x,y,w,h, 15, a(e,0.95*ap), 2, a(e,0.4*ap))
end
-- the same numbered section header the menu draws
local function hud_head(x,y,w,idx,label)
  local nw=ts(idx,10)
  draw.RectFilled(x,y,nw+8,13, a(theme.accent,0.16), 2)
  draw.Text(x+4,y+2,idx, a(theme.accent,0.95), 10)
  local caps=string.upper(label); local hw=ts(caps,11)
  draw.Text(x+nw+15,y+1,caps, a(theme.faint,1), 11)
  local lx=x+nw+hw+23
  if lx<x+w then draw.Line(lx,y+9,x+w,y+9, a(theme.line,0.45), 1) end
end
-- drag grip. only drawn while the menu is on screen, because that is the only
-- time the panels can be grabbed (with it closed every click belongs elsewhere)
local function hud_grip(x,y,ap)
  if ui.appear<=0.9 then return end
  for r=0,1 do for c=0,1 do
    draw.RectFilled(x+c*4, y+r*4, 1.6,1.6, a(theme.faint,0.9*ap), 0)
  end end
end
-- rows for the keybind list. a row only exists while its parent feature is on
-- and the bind is actually assigned, so the list stays honest to the menu.
local function hud_key_rows()
  local rows={}
  local function add(id,lb,en) if en and (bind[id] or 0)~=0 then rows[#rows+1]={lb,vkname(bind[id])} end end
  add("aim_key","Aimbot",cfg.aim_on)
  add("aim_toggle","Aim Toggle",cfg.aim_on)
  add("trig_key","Triggerbot",cfg.trig_on and not cfg.trig_always)
  add("trig_toggle","Trigger Toggle",cfg.trig_on)
  add("esp_toggle","ESP Toggle",cfg.esp_on)
  add("menu_key","Menu",true)
  return rows
end

local function run_hud()
  local sw,sh=scr()
  -- one fade curve per panel, so the three do not snap in as a single block
  local apm=approach("hud_mark", cfg.hud_mark and 1 or 0, 17)
  local apk=approach("hud_keys", cfg.hud_keys and 1 or 0, 15)
  local apb=approach("hud_bar",  cfg.hud_bar  and 1 or 0, 16)

  -- ------------------------------------------------------------- watermark
  if apm>0.01 then
    local fps=math.floor((utility.GetFPS and utility.GetFPS()) or 0)
    if not fps or fps<=0 then fps=math.floor(1/(_dt>0 and _dt or 0.016)) end
    local up=now()-hud_start
    local ut = up<60 and string.format("%ds",math.floor(up))
      or (up<3600 and string.format("%dm",math.floor(up/60)))
      or string.format("%dh%02dm",math.floor(up/3600),math.floor((up%3600)/60))
    local ft=string.format("%d FPS",fps)
    local lw=ts("Ego",14); local pw2=ts("Fust Survival",11)
    local fw=ts(ft,11); local uw=ts(ut,11)
    local ph=30
    local wpx=14+lw+5+8+6+pw2+10+1+10+fw+10+uw+14
    local mp=hud_pos.mark
    local wx=mp and mp.x or (sw-wpx-16)
    local wy=mp and mp.y or 14
    wx=clamp(wx,0,math.max(0,sw-wpx)); wy=clamp(wy,0,math.max(0,sh-ph))
    if ui.appear>0.9 and inside(wx,wy,wpx,ph) and ui.m.click and not ui.drag then
      hud_pos.mark={x=wx,y=wy}
      ui.drag={k="hud_mark",ox=ui.m.x-wx,oy=ui.m.y-wy}; ui.m.click=false
    end
    hud_panel(wx,wy,wpx,ph,apm,3)
    hud_grip(wx+wpx-14,wy+2,apm)
    -- wordmark, accent diamond and product line: the top bar lockup, compact
    tmid(wx+14,wy,ph,"Ego", a(theme.text,1), 14)
    local dcx,dcy=wx+14+lw+5+4, wy+ph*0.5
    if draw.PolyFilled then pcall(draw.PolyFilled, {{dcx,dcy-4},{dcx+4,dcy},{dcx,dcy+4},{dcx-4,dcy}}, a(theme.accent,1))
    else draw.RectFilled(dcx-3,dcy-3,6,6, a(theme.accent,1), 1) end
    local px=dcx+4+6
    tmid(px,wy,ph,"Fust Survival", a(theme.sub,1), 11)
    -- hairline divider, then the live counters
    local gx=px+pw2+10
    draw.Line(gx,wy+8,gx,wy+ph-8, a(theme.line,0.6*apm), 1)
    local tx=gx+11
    local fc = fps>=100 and theme.ok or (fps>=45 and theme.text or theme.bad)
    tmid(tx,wy,ph,ft, a(fc,1), 11)
    tmid(tx+fw+10,wy,ph,ut, a(theme.faint,1), 11)
  end

  -- ---------------------------------------------------------- keybind list
  if apk>0.01 then
    local rows=hud_key_rows()
    if #rows>0 then
      local rh=21; local pw=178; local ph=40+#rows*rh
      local kp=hud_pos.keys
      local kx=kp and kp.x or (sw-pw-16)
      -- bottom-right by default: the watermark owns the top-right corner and
      -- the radar anchors there too, so the list would sit on top of both
      local ky=kp and kp.y or (sh-ph-18)
      kx=clamp(kx,0,math.max(0,sw-pw)); ky=clamp(ky,0,math.max(0,sh-ph))
      if ui.appear>0.9 and inside(kx,ky,pw,ph) and ui.m.click and not ui.drag then
        hud_pos.keys={x=kx,y=ky}
        ui.drag={k="hud_keys",ox=ui.m.x-kx,oy=ui.m.y-ky}; ui.m.click=false
      end
      hud_panel(kx,ky,pw,ph,apk,4)
      hud_head(kx+13,ky+11,pw-26-(ui.appear>0.9 and 13 or 0),"01","Keybinds")
      hud_grip(kx+pw-16,ky+14,apk)
      for i,r in ipairs(rows) do
        local ry=ky+32+(i-1)*rh
        if i%2==0 then draw.RectFilled(kx+9,ry,pw-18,rh, {1,1,1,0.022*apk}, 0) end
        tmid(kx+14,ry,rh,r[1], a(theme.sub,1), 11)
        -- the key sits in a field so it reads as a chip instead of loose text
        local kw=ts(r[2],10); local cw=kw+13; local ch=15
        local cx=kx+pw-13-cw; local cy=ry+(rh-ch)*0.5
        draw.RectFilled(cx,cy,cw,ch, a(theme.field,1), 2)
        draw.Rect(cx,cy,cw,ch, a(theme.line,1), 2, 1)
        tmid(cx,cy,ch,r[2], a(theme.text,1), 10)
      end
    end
  end

  -- ----------------------------------------------------------- feature bar
  if apb>0.01 then
    local feats={}
    local function addf(id,lb) if cfg[id] then feats[#feats+1]=lb end end
    addf("aim_on","AIM"); addf("trig_on","TRIGGER")
    addf("esp_on","ESP"); addf("rad_on","RADAR"); addf("xh_on","CROSSHAIR")
    if cfg.loot_on or cfg.base_on or cfg.bags_on or cfg.drop_on
      or cfg.nodes_on or cfg.pick_on or cfg.plants_on then
      feats[#feats+1]="WORLD"
    end
    if #feats>0 then
      local gap=7; local pad=16; local ph=34
      local widths={}; local tot=pad*2+(#feats-1)*gap
      for i,lb in ipairs(feats) do
        local cw=math.max(48, ts(lb,10)+20); widths[i]=cw; tot=tot+cw
      end
      local bp=hud_pos.bar
      local bx=bp and bp.x or (sw*0.5-tot*0.5)
      local by=bp and bp.y or (sh-ph-18)
      bx=clamp(bx,0,math.max(0,sw-tot)); by=clamp(by,0,math.max(0,sh-ph))
      if ui.appear>0.9 and inside(bx,by,tot,ph) and ui.m.click and not ui.drag then
        hud_pos.bar={x=bx,y=by}
        ui.drag={k="hud_bar",ox=ui.m.x-bx,oy=ui.m.y-by}; ui.m.click=false
      end
      hud_panel(bx,by,tot,ph,apb,4)
      hud_grip(bx+tot-14,by+2,apb)
      local e=mix(theme.accent,theme.accent2,0.5)
      draw.RectFilled(bx+pad-2,by+ph-2,tot-(pad-2)*2,2, {e[1],e[2],e[3],0.9*apb}, 1)
      local px=bx+pad
      for i,lb in ipairs(feats) do
        local cw=widths[i]; local cx=px+cw*0.5
        draw.CircleFilled(cx,by+11,2.4, a(e,0.95*apb), 12)
        local tw=ts(lb,10)
        draw.Text(cx-tw*0.5,by+17,lb, a(theme.text,0.95*apb), 10)
        if i<#feats then
          local sx=px+cw+gap*0.5
          draw.Line(sx,by+9,sx,by+ph-10, a(theme.line,0.5*apb), 1)
        end
        px=px+cw+gap
      end
    end
  end
end

-- =========================================================================
-- MISC: custom crosshair.
-- Every control in the Misc tab feeds this: style, size, gap, thickness, the
-- centre dot, spin (angle is integrated from the frame delta, so the speed
-- slider means the same at 60 or 240 fps) and the colour swatch.
-- =========================================================================
local xh_ang=0
local function xh_rot(cx,cy,ang)
  local co,si=math.cos(ang),math.sin(ang)
  return function(x,y)
    local dx,dy=x-cx,y-cy
    return cx+dx*co-dy*si, cy+dx*si+dy*co
  end
end
-- closed outline: PolyClosed when the draw table has it, hairline segments
-- otherwise, so the Star of David never disappears on a stripped build
local function xh_poly(pts,c,th)
  if draw.PolyClosed then pcall(draw.PolyClosed, pts, c, th); return end
  for i=1,#pts do
    local p=pts[i]; local q=pts[i%#pts+1]
    draw.Line(p[1],p[2],q[1],q[2],c,th)
  end
end
local function run_crosshair()
  if not cfg.xh_on then return end
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  local s=cfg.xh_size; local gp=cfg.xh_gap; local th=cfg.xh_thick
  local c=a(col.c_xh,1); local st=cfg.xh_style
  if cfg.xh_spin then
    xh_ang=(xh_ang+(cfg.xh_speed or 0)*math.pi/180*_dt)%(math.pi*2)
  end
  local ang=cfg.xh_spin and xh_ang or 0
  local R=xh_rot(cx,cy,ang)
  if st==1 then
    -- four arms, each starting gp px out from the centre and running s px long
    local x1,y1=R(cx-gp-s,cy); local x2,y2=R(cx-gp,cy)
    local x3,y3=R(cx+gp,cy);   local x4,y4=R(cx+gp+s,cy)
    local x5,y5=R(cx,cy-gp-s); local x6,y6=R(cx,cy-gp)
    local x7,y7=R(cx,cy+gp);   local x8,y8=R(cx,cy+gp+s)
    draw.Line(x1,y1,x2,y2,c,th); draw.Line(x3,y3,x4,y4,c,th)
    draw.Line(x5,y5,x6,y6,c,th); draw.Line(x7,y7,x8,y8,c,th)
  elseif st==2 then
    -- Dot is the one style where Size is a radius rather than an arm length,
    -- so it has to feed the pip directly; thickness only biases the floor.
    local r=math.max(0.9, s*0.32+th*0.5)
    draw.CircleFilled(cx,cy,r,c,math.max(8,math.floor(r*3)))
  elseif st==3 then
    draw.Circle(cx,cy,s,c,24,th)
  elseif st==4 then
    local x1,y1=R(cx-gp-s,cy); local x2,y2=R(cx-gp,cy)
    local x3,y3=R(cx+gp,cy);   local x4,y4=R(cx+gp+s,cy)
    local x5,y5=R(cx,cy+gp);   local x6,y6=R(cx,cy+gp+s)
    draw.Line(x1,y1,x2,y2,c,th); draw.Line(x3,y3,x4,y4,c,th)
    draw.Line(x5,y5,x6,y6,c,th)
  elseif st==5 then
    -- two equilateral triangles sharing one circumcircle; gap pushes the whole
    -- star out from the centre, size sets its radius
    local r=gp+s
    local h=r*math.sqrt(3)*0.5
    local ux,uy=R(cx,cy-r)
    local lx,ly=R(cx-h,cy+r*0.5); local rx2,ry2=R(cx+h,cy+r*0.5)
    local dx,dy=R(cx,cy+r)
    local l2x,l2y=R(cx-h,cy-r*0.5); local r2x,r2y=R(cx+h,cy-r*0.5)
    xh_poly({{ux,uy},{lx,ly},{rx2,ry2}}, c, th)
    xh_poly({{dx,dy},{l2x,l2y},{r2x,r2y}}, c, th)
  end
  -- centre pip: thickness sets the base, size nudges it so the slider still
  -- reads even when only the dot is on
  if cfg.xh_dot and st~=2 then draw.CircleFilled(cx,cy,math.max(0.9, th+s*0.07),c,10) end
end

-- =========================================================================
-- WORLD: loot containers, base deployables, body bags, dropped items, ore nodes
-- and pickups.
-- Folder names and matching rules come from hub's World tab, but this pass is
-- Ego-native: an incremental sweep (a slice per frame, published when the walk
-- completes), draw.WorldToScreen, studs shown as metres like the player ESP, and
-- colours looked up live from the inline swatch chips.
-- =========================================================================
local W_CACHE={ loot={}, base={}, bags={}, dropped={}, nodes={}, picks={}, plants={}, veh={}, gen=0,
  col={1,1,1,1}, def={1,1,1,1}, suf={} }
-- World sweep state: the incremental folder walk plus the accumulators for the
-- sweep in flight. Kept in one table so it costs a single module-level local.
local W_SWEEP={tasks={},ti=1,ki=1,ch=nil,active=false,cool=0,
  next={loot={},base={},bags={},dropped={},nodes={},picks={},plants={},veh={}}}

-- Cache key for an instance. Wrappers are NOT guaranteed to keep identity
-- between calls, so keying these caches on the wrapper missed on every sweep:
-- the part was re-resolved (sometimes to a different child) once a second, and
-- a frozen marker jumped a few studs. The address is stable, so the first
-- answer for an object sticks for as long as it exists.
function W_SWEEP.key(inst)
  local ok,ad=pcall(PF.addr,inst)
  if ok and type(ad)=="number" then return ad end
  return inst
end
local W_PART_CLASS={ MeshPart=true, Part=true, UnionOperation=true }
local W_PART_NAMES={ "HumanoidRootPart","UpperTorso","Torso","Head","Body","Canvas","Strap",
  "WoodDark","Rim","Rock","Ore","Wood","Leaves","Stem","Handle","Metal","Lid","Cob","Stalk",
  -- vehicle hulls: the dump's ATV hangs its body off Chassis, the rowboat off Hull,
  -- and both have a Seat mesh near the middle. Tried after the loot names so a
  -- crate that happens to own one of them still resolves the way it always did.
  "Chassis","Hull","Seat" }
-- first match wins, so this order mirrors hub's if/elseif chain exactly:
-- elite/military before the generic crate. base deployables live in their own
-- table because they answer to the Base master instead of Enable Loot ESP.
local W_LOOT={
  {"barrel","loot_barrels","Loot Barrel","c_lootbarrels"},
  {"elite","loot_elite","Elite Crate","c_lootelite"},
  {"military","loot_military","Military Crate","c_lootmilitary"},
  {"crate","loot_crates","Loot Crate","c_lootcrates"},
}
local W_BASE={
  {"largebox","loot_largebox","Large Box","c_lootlargebox"},
  {"woodenbox","loot_smallbox","Small Box","c_lootsmallbox"},
  {"toolcupboard","loot_tc","Tool Cupboard","c_loottc"},
  {"cupboard","loot_tc","Tool Cupboard","c_loottc"},
  {"locker","loot_locker","Locker","c_lootlocker"},
  {"sleepingbag","loot_bag","Sleeping Bag","c_lootbag"},
  {"sleeping_bag","loot_bag","Sleeping Bag","c_lootbag"},
}
local W_NODE={
  {"stone","node_stone","Stone Node","c_nodestone"},
  {"sulfur","node_sulfur","Sulfur Node","c_nodesulfur"},
  {"metal","node_iron","Metal Node","c_nodeiron"},
  {"iron","node_iron","Metal Node","c_nodeiron"},
}
-- one rule per plant pickup, so a food type can be toggled without dragging the
-- rest of the harvest in. first match wins; labels are fixed rather than
-- stripped from the model name so the readout stays readable.
local W_PLANT={
  {"hemp","pick_hemp","Hemp (Cloth)","c_pickhemp"},
  {"corn","pick_corn","Corn","c_pickcorn"},
  {"pumpkin","pick_pumpkin","Pumpkin","c_pickpumpkin"},
  {"berry","pick_berry","Berries","c_pickberry"},
  {"mushroom","pick_mushroom","Mushroom","c_pickmushroom"},
  {"carrot","pick_carrot","Carrot","c_pickcarrot"},
  {"potato","pick_potato","Potato","c_pickpotato"},
  {"apple","pick_apple","Apple","c_pickapple"},
}
-- Vehicle rules. The dump's workspace containers are FustAtvs (ATV models),
-- FustBoats (Rowboat models) and FustMinicopters (spawn folder, empty in the
-- dump because nothing was flying at capture time). Each folder is walked with
-- the same sweep as the rest of the world pass, so a vehicle that drives in is
-- picked up on the next pass instead of needing its own scanner.
-- First match wins: minicopter before the generic helicopter so the label is
-- the model's real name, and boat names before the bare "boat" catch-all.
-- Lives on W_CACHE so it costs no extra main-local.
W_CACHE.vehrules={
  {"atv","veh_atv","ATV","c_veh_atv"},
  {"rowboat","veh_boats","Rowboat","c_veh_boat"},
  {"rhib","veh_boats","RHIB","c_veh_boat"},
  {"tugboat","veh_boats","Tugboat","c_veh_boat"},
  {"boat","veh_boats","Boat","c_veh_boat"},
  -- Minicopters are cloned from the ReplicatedStorage template into
  -- workspace.FustMinicopters, so each live one is a Model named "Minicopter" in
  -- that folder. The template has no Body/Chassis/Hull, so the generic part pass
  -- landed on "Stripe" (a side decal) and put the marker off to one side. These
  -- are the model's real hull parts, tried in this order before PrimaryPart.
  {"minicopter","veh_heli","Minicopter","c_veh_heli",
    {"Frame","Floor","Body","Chassis","Engine","Seat","MainRotor"}},
  {"scrapheli","veh_heli","Scrap Heli","c_veh_heli",
    {"Body","Chassis","Frame","Engine","MainRotor"}},
  {"helicopter","veh_heli","Helicopter","c_veh_heli",
    {"Body","Chassis","Frame","Engine","MainRotor"}},
}
-- names that belong to the body-bag pass; the dropped pass skips them so one
-- model is never drawn twice with two different colours.
local W_BAG_PAT={"bodybag","body_bag","deathbag","lootbag","loot_bag","lootsack",
  "corpse","deadbody","dead_body","ragdoll","backpack","pack"}
local function w_is_bag(lower)
  for i=1,#W_BAG_PAT do if lower:find(W_BAG_PAT[i],1,true) then return true end end
  return false
end
-- A dead player's bag is a model literally named "Backpack" (Canvas + Strap +
-- LootPrompt) parked in Workspace.Deployables, so every backpack/lootsack name
-- has to read as a body bag rather than as generic loot. Sleeping bags are a
-- base deployable and stay with the Base pass, hence the early nil.
local function w_bag_label(lower)
  if lower:find("sleepingbag",1,true) or lower:find("sleeping_bag",1,true) then return nil end
  if lower:find("corpse",1,true) or lower:find("deadbody",1,true)
    or lower:find("dead_body",1,true) or lower:find("ragdoll",1,true) then return "Dead Body" end
  if lower:find("backpack",1,true) or lower:find("lootsack",1,true)
    or lower:find("loot_bag",1,true) or lower:find("lootbag",1,true)
    or lower:find("bodybag",1,true) or lower:find("body_bag",1,true)
    or lower:find("deathbag",1,true) or lower:find("pack",1,true) then return "Body Bag" end
end

-- resolve the part a model hangs its world position from. same candidate order
-- as hub, so Dust's crates, nodes and plant models all resolve. the answer is
-- kept per instance ADDRESS: a multi-part deployable can hand back a different
-- child on the next sweep, which is what moved a frozen marker a few studs.
local W_PART_CACHE={}
local function w_part(inst,key,extra)
  if not inst then return nil end
  if not key then key=W_SWEEP.key(inst) end
  local cached=W_PART_CACHE[key]
  if cached then
    if cached.p then
      -- stamp the entry so the prune at publish keeps it
      cached.gen=W_CACHE.gen
      return cached.p
    end
    -- A failed resolve is retried once per sweep instead of every frame: a model
    -- whose parts stream in a moment later (a gun mid-spawn) used to stay
    -- blacklisted for the whole session.
    if cached.gen==W_CACHE.gen then return nil end
  end
  local p
  -- a rule can hand its own part order. vehicles need this: the minicopter
  -- template has no Body/Chassis/Hull, so the shared list fell through to the
  -- first MeshPart (the Stripe decal) and drew the marker on one side.
  if extra then
    local fn=inst.FindFirstChild
    if type(fn)=="function" then
      for i=1,#extra do
        local ok,c=pcall(fn,inst,extra[i])
        if ok and c and W_PART_CLASS[c.ClassName] then p=c; break end
      end
    end
  end
  if not p and W_PART_CLASS[inst.ClassName] then p=inst end
  if not p then
    local okp,v=pcall(PF.prim,inst)
    if okp then p=v end
  end
  if not p then
    local fn=inst.FindFirstChild
    if type(fn)=="function" then
      for i=1,#W_PART_NAMES do
        local ok,c=pcall(fn,inst,W_PART_NAMES[i])
        if ok and c and W_PART_CLASS[c.ClassName] then p=c; break end
      end
    end
  end
  if not p then
    local fn=inst.GetChildren
    if type(fn)=="function" then
      local ok,ch=pcall(fn,inst)
      if ok and type(ch)=="table" then
        for i=1,#ch do
          local c=ch[i]
          if W_PART_CLASS[c.ClassName] then p=c; break end
        end
      end
    end
  end
  -- false remembers a failed resolve so a part-less model is only walked once
  W_PART_CACHE[key]={p=p or false,gen=W_CACHE.gen}
  return p
end
-- static objects do not move, so the first point resolved for them is kept and
-- every later sweep answers from it: no re-read and no drift. bags and dropped
-- items stay live because they can be picked up and moved.
local W_FIX={}
local function w_pos(inst,part,fixed,key)
  if not key then key=W_SWEEP.key(inst) end
  if fixed then
    local c=W_FIX[key]
    if c then c.gen=W_CACHE.gen; return c.x,c.y,c.z end
  end
  local p=part or w_part(inst,key)
  if not p then return nil end
  local ok,pos=pcall(PF.pos,p)
  if not (ok and pos) then return nil end
  local x=pos.X or pos.x; local y=pos.Y or pos.y; local z=pos.Z or pos.z
  if not x or not y or not z then return nil end
  if fixed then W_FIX[key]={x=x,y=y,z=z,gen=W_CACHE.gen} end
  return x,y,z
end
-- Children with the same fallbacks the NPC scanner uses: method names are
-- unrolled rather than looked up from a fresh table, because this runs once per
-- folder per sweep and the tables were pure garbage.
local function w_children(folder)
  if not folder then return nil end
  local fn=folder.GetChildren
  if type(fn)=="function" then
    local ok,ch=pcall(fn,folder)
    if ok and type(ch)=="table" then return ch end
  end
  fn=folder.get_children
  if type(fn)=="function" then
    local ok,ch=pcall(fn,folder)
    if ok and type(ch)=="table" then return ch end
  end
  return nil
end
-- Folder lookup with the same fallbacks. A build that does not expose
-- FindFirstChild on a wrapper used to answer nil for every folder, which made
-- the sweep publish an empty snapshot and left the whole World tab blank.
local function w_folder(ws,name)
  if not ws then return nil end
  local fn=ws.FindFirstChild
  if type(fn)=="function" then
    local ok,f=pcall(fn,ws,name)
    if ok and f then return f end
  end
  fn=ws.find_first_child
  if type(fn)=="function" then
    local ok,f=pcall(fn,ws,name)
    if ok and f then return f end
  end
  local okg,f=pcall(PF.get,ws,name)
  if okg and f then return f end
  -- last resort: one cached top-level walk per sweep, not one per folder
  local ch=W_SWEEP.wsch
  if ch==nil then ch=w_children(ws); W_SWEEP.wsch=ch end
  if ch then
    for i=1,#ch do
      local c=ch[i]
      local okn,nm=pcall(PF.name,c)
      if okn and nm==name then return c end
    end
  end
  return nil
end
-- the colour id travels with the entry, so the swatch is read at draw time and
-- its opacity slider changes the overlay on the very next frame. the resolved
-- part rides along too: static entries draw from the frozen point, moving ones
-- (bags, dropped items) re-read it live so they glide instead of stepping once
-- a second.
local function w_push(list,inst,name,cid,fixed,extra)
  local key=W_SWEEP.key(inst)
  local p=w_part(inst,key,extra)
  if not p then return end
  local x,y,z=w_pos(inst,p,fixed,key)
  if x then list[#list+1]={x=x,y=y,z=z,part=p,live=not fixed,name=name,cid=cid} end
end
-- ores first, plants in the middle, wood last: the same order the old resolver
-- used, so a name still lands in exactly one of the two caches. the third
-- return says which cache owns the hit.
local function w_pick_label(lower)
  if cfg.pick_on and cfg.pick_ores and (lower:find("stone",1,true)
    or lower:find("sulfur",1,true) or lower:find("metal",1,true)
    or lower:find("ore",1,true)) then
    if lower:find("sulfur",1,true) then return "Sulfur Pickup","c_pickores","pick" end
    if lower:find("metal",1,true) then return "Metal Pickup","c_pickores","pick" end
    return "Stone Pickup","c_pickores","pick"
  end
  -- plants answer to their own master and per-type switch, not Enable Pickups.
  if cfg.plants_on then
    for i=1,#W_PLANT do
      local rule=W_PLANT[i]
      if lower:find(rule[1],1,true) then
        if cfg[rule[2]] then return rule[3],rule[4],"plant" end
        return nil
      end
    end
  end
  if cfg.pick_on and cfg.pick_wood and (lower:find("wood",1,true)
    or lower:find("log",1,true)) then
    return "Wood Pile","c_pickwood","pick"
  end
end
-- ---------------------------------------------------------------------------
-- Incremental world sweep.
-- The old pass walked every folder in one frame once a second, so the whole map
-- landed on a single frame: the same hitch the NPC scanner used to have. It now
-- steps a slice of the walk per frame and publishes only when the walk finishes,
-- so the draw pass always sees one coherent snapshot and no frame ever pays for
-- the map.
-- ---------------------------------------------------------------------------
function W_SWEEP.begin()
  -- Same Workspace resolution chain the NPC scanner uses. game.Workspace is not
  -- exposed on every build (the NPC pass already carries these fallbacks), and
  -- when it came back nil every folder lookup failed, so the sweep published an
  -- empty snapshot forever and the whole World tab drew nothing.
  local ws
  pcall(function()
    if game then
      ws=game.Workspace or game.workspace
      if not ws and game.GetService then ws=game:GetService("Workspace") end
    end
  end)
  if not ws then ws=workspace end
  if not ws then return false end
  W_SWEEP.wsch=nil
  -- one generation per sweep: the part/position caches stamp what they touch
  -- and everything older is pruned at publish
  W_CACHE.gen=W_CACHE.gen+1
  local tasks={}
  W_SWEEP.tasks=tasks; W_SWEEP.ti=1; W_SWEEP.ki=1; W_SWEEP.ch=nil
  -- containers answer to Enable Loot ESP, deployables to the Base master. one
  -- sweep keeps a model that matches a rule in both tables from being pushed and
  -- drawn twice, so the first table that owns the name wins.
  -- Deployables is walked for the bag pass too: a dead player's bag is a
  -- "Backpack" model parked in there, so without this folder the bag pass never
  -- saw a single player body bag.
  if cfg.loot_on or cfg.base_on or cfg.bags_on then
    tasks[#tasks+1]={kind="lootbase",folder=w_folder(ws,"Loot")}
    tasks[#tasks+1]={kind="lootbase",folder=w_folder(ws,"Deployables")}
  end
  if cfg.bags_on then
    local folders={"WorldItems","DroppedItems","Dropped","Debris","Corpses",
      "DeadBodies","Bags","Dead","LootBags","DeathBags"}
    for fi=1,#folders do tasks[#tasks+1]={kind="bags",folder=w_folder(ws,folders[fi])} end
  end
  -- top-level sweep: corpses and backpacks that are not inside a container
  -- folder, plus dropped Tools. A gun dropped straight to Workspace keeps its
  -- Tool class instead of becoming a WorldItems model, so nothing else would
  -- ever see it. Player inventory tools live under the character Model, never
  -- at the top level, so a top-level Tool is always loose loot.
  if cfg.bags_on or cfg.drop_on then
    tasks[#tasks+1]={kind="bags_top",folder=ws}
  end
  if cfg.drop_on then
    local folders={"WorldItems","DroppedItems","Dropped","Debris","LooseItems",
      "ItemDrops","Drops"}
    for fi=1,#folders do tasks[#tasks+1]={kind="dropped",folder=w_folder(ws,folders[fi])} end
  end
  if cfg.nodes_on then
    tasks[#tasks+1]={kind="nodes",folder=w_folder(ws,"Nodes") or w_folder(ws,"OreNodes")}
  end
  if cfg.pick_on or cfg.plants_on then
    tasks[#tasks+1]={kind="picks",folder=w_folder(ws,"Pickups") or w_folder(ws,"SpawnedPickups")
      or w_folder(ws,"GroundItems")}
  end
  -- vehicles live in their own top-level folders. The singular/plural variants
  -- cover the naming the dump shows for the folder and its client script; the
  -- extras are there so a future car folder works without a code change. Spelled
  -- out instead of looped over a local list to keep the main chunk's local count.
  if cfg.veh_on then
    tasks[#tasks+1]={kind="veh",folder=w_folder(ws,"FustAtvs")}
    tasks[#tasks+1]={kind="veh",folder=w_folder(ws,"FustBoats")}
    tasks[#tasks+1]={kind="veh",folder=w_folder(ws,"FustMinicopters")}
    tasks[#tasks+1]={kind="veh",folder=w_folder(ws,"FustMinicopter")}
    tasks[#tasks+1]={kind="veh",folder=w_folder(ws,"FustCars")}
    tasks[#tasks+1]={kind="veh",folder=w_folder(ws,"FustVehicles")}
  end
  if #tasks==0 then return false end
  W_SWEEP.active=true
  return true
end

-- classify one child of the folder currently being walked
function W_SWEEP.take(kind,inst)
  local nx=W_SWEEP.next
  if kind=="lootbase" then
    local lower=(inst.Name or ""):lower()
    local hit=false
    if cfg.loot_on then
      for k=1,#W_LOOT do
        local rule=W_LOOT[k]
        if lower:find(rule[1],1,true) then
          if cfg[rule[2]] then w_push(nx.loot,inst,rule[3],rule[4],true) end
          hit=true; break
        end
      end
    end
    if not hit and cfg.base_on then
      for k=1,#W_BASE do
        local rule=W_BASE[k]
        if lower:find(rule[1],1,true) then
          if cfg[rule[2]] then w_push(nx.base,inst,rule[3],rule[4],true) end
          hit=true; break
        end
      end
    end
    -- Player body bags live in Deployables as a model named "Backpack". It
    -- matches no loot or base rule, so the bag pass has to claim it here. The
    -- loot/base rules run first, which keeps a SleepingBag under Base where it
    -- belongs.
    if not hit and cfg.bags_on then
      local label=w_bag_label(lower)
      if label then w_push(nx.bags,inst,label,"c_bodybag") end
    end
  elseif kind=="bags" then
    local label=w_bag_label((inst.Name or ""):lower())
    if label then w_push(nx.bags,inst,label,"c_bodybag") end
  elseif kind=="bags_top" then
    local lower=(inst.Name or ""):lower()
    if lower:find("corpse",1,true) or lower:find("bodybag",1,true)
      or lower:find("body_bag",1,true) or lower:find("deadbody",1,true)
      or lower:find("dead_body",1,true) or lower:find("ragdoll",1,true)
      or lower:find("backpack",1,true) or lower:find("lootsack",1,true)
      or lower:find("loot_bag",1,true) or lower:find("deathbag",1,true) then
      if cfg.bags_on then
        local label=w_bag_label(lower)
        if label then w_push(nx.bags,inst,label,"c_bodybag") end
      end
    elseif cfg.drop_on and inst.ClassName=="Tool" then
      -- Loose tool: a dropped gun/hatchet that stayed a Tool in Workspace.
      w_push(nx.dropped,inst,inst.Name or "Item","c_dropped")
    end
  elseif kind=="dropped" then
    local iname=inst.Name or "Item"
    if not w_is_bag(iname:lower()) then w_push(nx.dropped,inst,iname,"c_dropped") end
  elseif kind=="nodes" then
    local lower=(inst.Name or ""):lower()
    for k=1,#W_NODE do
      local rule=W_NODE[k]
      if lower:find(rule[1],1,true) then
        if cfg[rule[2]] then w_push(nx.nodes,inst,rule[3],rule[4],true) end
        break
      end
    end
  elseif kind=="picks" then
    local iname=inst.Name or ""
    local label,cid,pk=w_pick_label(iname:lower())
    if label then
      if pk=="plant" then w_push(nx.plants,inst,label,cid,true)
      else w_push(nx.picks,inst,label,cid,true) end
    end
  elseif kind=="veh" then
    -- Vehicles are pushed live (no fixed flag): they drive, so the render pass
    -- re-reads the part each frame instead of drawing a once-a-second snapshot
    -- that would step along behind them.
    local lower=(inst.Name or ""):lower()
    local rules=W_CACHE.vehrules
    for k=1,#rules do
      local rule=rules[k]
      if lower:find(rule[1],1,true) then
        if cfg[rule[2]] then w_push(nx.veh,inst,rule[3],rule[4],nil,rule[5]) end
        break
      end
    end
  end
end

-- swap the finished sweep in, then bound the caches
function W_SWEEP.publish()
  local nx=W_SWEEP.next
  W_CACHE.loot=nx.loot; W_CACHE.base=nx.base; W_CACHE.bags=nx.bags
  W_CACHE.dropped=nx.dropped; W_CACHE.nodes=nx.nodes
  W_CACHE.picks=nx.picks; W_CACHE.plants=nx.plants; W_CACHE.veh=nx.veh
  W_SWEEP.next={loot={},base={},bags={},dropped={},nodes={},picks={},plants={},veh={}}
  W_SWEEP.active=false
  -- Cadence in frames, not seconds. now() reads utility.GetTime and falls back to
  -- os.clock(); GetTime is frame-granular on some builds and a frozen clock used
  -- to park the sweep on a deadline it could never reach, which emptied the
  -- entire World tab. 60 frames is the same ~1 s wait at 60 fps.
  W_SWEEP.cool=60
  W_SWEEP.tasks={}; W_SWEEP.ti=1; W_SWEEP.ki=1; W_SWEEP.ch=nil
  -- Anything not touched by the sweep that just finished is dropped. Address
  -- keys make this exact: one entry per live object, not one per wrapper per
  -- second, which is what used to bleed FPS over a long session.
  for k,v in pairs(W_PART_CACHE) do if v.gen~=W_CACHE.gen then W_PART_CACHE[k]=nil end end
  for k,v in pairs(W_FIX) do if v.gen~=W_CACHE.gen then W_FIX[k]=nil end end
end

-- step the walk; called once per frame from run_world
function W_SWEEP.step()
  if not W_SWEEP.active then
    -- same one-second cadence the old single-frame refresh had: the total work
    -- per second is unchanged, it is just spread over the frames in between
    -- instead of landing on one frame. The wait is counted in frames so it can
    -- never be stuck behind a clock that does not advance.
    local c=W_SWEEP.cool
    if c and c>0 then W_SWEEP.cool=c-1; return end
    if not W_SWEEP.begin() then return end
  end
  local budget=24      -- children visited this frame
  while budget>0 do
    local task=W_SWEEP.tasks[W_SWEEP.ti]
    if not task then break end
    if W_SWEEP.ch==nil then
      W_SWEEP.ch=task.folder and w_children(task.folder) or false
      if not W_SWEEP.ch then
        W_SWEEP.ch=nil; W_SWEEP.ti=W_SWEEP.ti+1; W_SWEEP.ki=1
      end
    else
      local ch=W_SWEEP.ch
      local n=#ch
      while W_SWEEP.ki<=n and budget>0 do
        local inst=ch[W_SWEEP.ki]
        W_SWEEP.ki=W_SWEEP.ki+1
        budget=budget-1
        if inst then W_SWEEP.take(task.kind,inst) end
      end
      if W_SWEEP.ki>n then
        W_SWEEP.ch=nil; W_SWEEP.ti=W_SWEEP.ti+1; W_SWEEP.ki=1
      end
    end
  end
  if not W_SWEEP.tasks[W_SWEEP.ti] then W_SWEEP.publish() end
end
-- one renderer for all five passes. 0 means "off", the slider's top value means
-- unlimited, and the readout shows metres exactly like the player ESP. The range
-- row is metres while the scan is studs, so the limit is converted once here.
--
-- Width of the " [NNNm]" distance suffix, measured from its parts once per font
-- size. Measuring the whole label again on every metre the camera moves was the
-- most expensive thing this pass did: with a few hundred visible markers that is
-- hundreds of GetTextSize calls a frame just to keep a label centred.
function W_CACHE.sufw(fs,nd)
  local t=W_CACHE.suf[fs]
  if not t then
    t={ ow=ts(" [",fs), dw=ts("0",fs), cw=ts("m]",fs) }
    W_CACHE.suf[fs]=t
  end
  return t.ow+t.dw*nd+t.cw
end
local function ndig(n)
  if n<10 then return 1 elseif n<100 then return 2 elseif n<1000 then return 3 end
  return 4
end
local function w_render(list,camx,camy,camz,limit,show_dist,fs)
  if #list==0 or limit<=0 then return end
  local lim=limit>=3000 and math.huge or limit/PF.m
  local lim2=lim*lim
  local drawn=0
  for i=1,#list do
    if drawn>=120 then break end
    local e=list[i]
    -- Range test first, from the point the sweep recorded. Only entries that are
    -- actually going to be drawn pay for the live position re-read below: doing
    -- it up front meant one host call per dropped item per frame, in range or
    -- not, and dropped items are the most numerous thing on this tab.
    local ex,ey,ez=e.x,e.y,e.z
    local dx,dy,dz=ex-camx,ey-camy,ez-camz
    local d2=dx*dx+dy*dy+dz*dz
    if d2<=lim2 and e.live and e.part then
      -- Moving entries (bags, dropped items) re-read their part every frame. The
      -- sweep only refreshes them once per pass, so drawing the scanned point
      -- made them step between sweeps. Static entries keep their frozen point
      -- and pay nothing extra.
      local okp,pv=pcall(PF.pos,e.part)
      if okp and pv then
        local lx=pv.X or pv.x
        if lx then
          ex=lx; ey=pv.Y or pv.y; ez=pv.Z or pv.z
          dx,dy,dz=ex-camx,ey-camy,ez-camz
          d2=dx*dx+dy*dy+dz*dz
        end
      end
    end
    if d2<=lim2 then
      local sx,sy,vis=draw.WorldToScreen(ex,ey,ez)
      if vis then
        drawn=drawn+1
        local c=(e.cid and col[e.cid]) or W_CACHE.def
        -- one shared scratch colour, refilled in place: two throwaway tables per
        -- drawn item per frame was the whole GC load of the world pass
        local wc=W_CACHE.col
        wc[1]=c[1]; wc[2]=c[2]; wc[3]=c[3]; wc[4]=c[4] or 1
        -- small pip: the label carries the readout, the dot only marks the spot.
        -- a 2px quad instead of an 8-segment circle: at this size they look the
        -- same and the quad is a fraction of the draw cost
        draw.RectFilled(sx-1,sy-1,2,2,wc,0)
        local txt=e.name
        local tw
        if show_dist then
          -- label cached per whole metre: the string changes when the target
          -- moves a metre, and its width is name + measured suffix, so no host
          -- text measurement is needed per frame
          local dm=math.floor(math.sqrt(d2)*PF.m)
          if e.dm~=dm or not e.dtxt or e.dwsz~=fs then
            e.dm=dm
            e.dtxt=e.name.." ["..dm.."m]"
            if not e.pw or e.pwsz~=fs then e.pw=ts(e.name,fs); e.pwsz=fs end
            e.dw=e.pw+W_CACHE.sufw(fs,ndig(dm))
            e.dwsz=fs
          end
          txt=e.dtxt; tw=e.dw
        else
          if not e.pw or e.pwsz~=fs then e.pw=ts(e.name,fs); e.pwsz=fs end
          tw=e.pw
        end
        draw.Text(sx-tw*0.5,sy-fs-3,txt,wc,fs)
      end
    end
  end
end
local function run_world()
  if not (cfg.loot_on or cfg.base_on or cfg.bags_on or cfg.drop_on
    or cfg.nodes_on or cfg.pick_on or cfg.plants_on or cfg.veh_on) then return end
  -- incremental sweep: a slice of the folder walk each frame instead of the
  -- whole map landing on one frame every second
  pcall(W_SWEEP.step)
  local cp; pcall(function() cp=camera.GetPosition() end)
  if not cp then return end
  local camx,camy,camz=cp.X,cp.Y,cp.Z
  -- containers and base deployables are scanned together but drawn apart, so a
  -- base range and a crate range never override each other
  if cfg.loot_on then
    w_render(W_CACHE.loot,camx,camy,camz,cfg.loot_range or 170,
      cfg.loot_dist,cfg.loot_text or 12)
  end
  if cfg.base_on then
    w_render(W_CACHE.base,camx,camy,camz,cfg.base_range or 60,
      cfg.base_dist,cfg.base_text or 12)
  end
  -- bags and dropped items share one range, distance toggle and text size
  if cfg.bags_on then
    w_render(W_CACHE.bags,camx,camy,camz,cfg.bd_range or 170,
      cfg.bd_dist,cfg.bd_text or 12)
  end
  if cfg.drop_on then
    w_render(W_CACHE.dropped,camx,camy,camz,cfg.bd_range or 170,
      cfg.bd_dist,cfg.bd_text or 12)
  end
  if cfg.nodes_on then
    w_render(W_CACHE.nodes,camx,camy,camz,cfg.nodes_range or 120,
      cfg.nodes_dist,cfg.nodes_text or 13)
  end
  if cfg.pick_on then
    w_render(W_CACHE.picks,camx,camy,camz,cfg.pick_range or 60,
      cfg.pick_dist,cfg.pick_text or 12)
  end
  -- plants and food carry their own range, text size and distance toggle, so the
  -- pickup readout and the harvest readout can be switched independently
  if cfg.plants_on then
    w_render(W_CACHE.plants,camx,camy,camz,cfg.plants_range or 60,
      cfg.plants_dist,cfg.plants_text or 12)
  end
  -- vehicles: own master toggle, own 400 m range row and own text size, so the
  -- readout can be dialled independently of the loot pass
  if cfg.veh_on then
    w_render(W_CACHE.veh,camx,camy,camz,cfg.veh_range or 400,
      cfg.veh_dist,cfg.veh_text or 12)
  end
end

-- =========================================================================
-- AIMBOT: target selection, camera tracking and the FOV / target-line overlay.
-- Selection runs every frame even without the aim key, so the FOV ring and the
-- tether stay live; only the camera move is gated on the key. The camera is
-- oriented before every other overlay is projected, because orienting after the
-- ESP pass would draw that frame's markers against the previous camera.
-- =========================================================================
local aim_tgt=nil   -- head point the FOV currently holds
local aim_pt=nil    -- smoothed point fed to camera.LookAt
local aim_dz_hold=false -- camera parked inside the deadzone; resume past the margin
-- mouse aim, same model as op1: a straight 1/sm divisor on the screen-space
-- error (sm=1 is a hard snap), the deadzone latches until the head is well
-- clear, and the sub-pixel remainder is carried between frames.
local aim_dz_state=0
local aim_dz_tgt=nil
local aim_rx,aim_ry=0,0
local function aim_step(ex,ey,sm)
  if sm<=1 then
    local ax=math.abs(ex)
    local ay=math.abs(ey)
    if ax<0.6 and ay<0.6 then return ex*0.9, ey*0.9 end
    return ex*0.8, ey*0.8
  end
  if sm<=10 then
    return ex/sm, ey/sm
  end
  if sm<=25 then
    return ex/(sm*0.9), ey/(sm*0.9)
  end
  return ex/(sm*0.8), ey/(sm*0.8)
end
-- MoveMouse truncates sub-pixel deltas, so carry the remainder
local function aim_emit(fx,fy)
  aim_rx=aim_rx+fx
  aim_ry=aim_ry+fy
  local ix=math.floor(aim_rx+0.5)
  local iy=math.floor(aim_ry+0.5)
  if ix==0 and iy==0 then return end
  aim_rx=aim_rx-ix
  aim_ry=aim_ry-iy
  pcall(input.MoveMouse,ix,iy)
end
-- the input section reports the overlay centre in the same space WorldToScreen
-- uses. keep the render-space centre as a fallback if they ever disagree, so a
-- windowed or offset overlay cannot put the aim ring somewhere else.
local function aim_center()
  local sw,sh=scr(); local cx,cy=sw*0.5,sh*0.5
  if input.GetScreenCenter then
    local ok,x,y=pcall(input.GetScreenCenter)
    if ok and type(x)=="number" and type(y)=="number"
      and math.abs(x-cx)<=4 and math.abs(y-cy)<=4 then
      return x,y
    end
  end
  return cx,cy
end
-- the silent hook is one global switch, so drive it from the selected type and
-- the master toggle instead of from the key: an externally cleared hook would
-- otherwise leave SetSilentTarget posting into nothing.
local function aim_hook_sync(want)
  if not (raycast and raycast.EnableSilentHook) then return false end
  local on=false
  if raycast.IsSilentHookActive then pcall(function() on=raycast.IsSilentHookActive() end) end
  if want then
    if not on then pcall(raycast.EnableSilentHook) end
    return true
  end
  if on then
    if raycast.ClearSilentTarget then pcall(raycast.ClearSilentTarget) end
    if raycast.StopSilentTracking then pcall(raycast.StopSilentTracking) end
    pcall(raycast.DisableSilentHook)
  end
  return false
end
local function aim_vec(x,y,z)
  local ctor=Vector3 and (Vector3.New or Vector3.new)
  if not ctor then return nil end
  local ok,v=pcall(ctor,x,y,z)
  if ok then return v end
end
-- the shape you pick is also the hit region, not just a decoration: a wide
-- corner box should not lock onto something outside its brackets.
local function aim_in_fov(dx,dy,r,style)
  -- box and corner box share a square region; circle and diamond keep their own
  if style==2 or style==4 then return math.abs(dx)<=r and math.abs(dy)<=r end
  if style==3 then return math.abs(dx)+math.abs(dy)<=r end
  return dx*dx+dy*dy<=r*r
end
local cam_tracking=false
local cam_track_obj=nil
local cam_track_part=nil

local trig_next=0
local trig_hold=nil
local trig_dwell=0
local trig_latch=false
local trig_miss=0
local TRIG_GRACE=0.25

