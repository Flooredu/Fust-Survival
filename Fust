  {"assault rifle",1350,8}, {"scar",1450,8}, {"m249",1400,8},
  {"drum smg",880,8}, {"tactical smg",950,8},
  {"custom smg",900,8}, {"dino hunt smg",900,8}, {"hunt smg",900,8},
  {"lever carbine",1250,8},
  {"double barrel",520,15}, {"pump shotgun",560,15}, {"pipe shotgun",560,15},
  {"revolver",950,8}, {"service pistol",950,8},
  {"semi-auto pistol",900,8}, {"semi auto pistol",900,8},
  -- generic fallbacks, tried only after every exact name above
  {"shotgun",560,15}, {"smg",900,8}, {"sniper",2600,24},
  {"carbine",1250,8}, {"machine gun",1400,8}, {"rifle",1425,8}, {"pistol",900,8},
