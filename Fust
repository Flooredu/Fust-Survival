  draw.Rect(axp-2,ay-3,4,ah+6,{1,1,1,1},1,1.5)
  local fin=hsv(p.h,p.s,p.v); fin[4]=p.al
  col[p.color]={fin[1],fin[2],fin[3],fin[4]}; cfg_dirty=true
  if p.color=="c_accent" then theme.accent={fin[1],fin[2],fin[3],1} end
  -- live preview chip + hex readout
  local px,py=svx,ay+ah+10
  swatch_checker(px,py,44,26,{0.13,0.15,0.20,1},{0.08,0.09,0.13,1},4)
  draw.RectFilled(px,py,44,26,fin,3)
  draw.Rect(px,py,44,26,a(theme.line,1),3,1)
  local r8=math.floor(fin[1]*255); local g8=math.floor(fin[2]*255); local b8=math.floor(fin[3]*255)
  tmid(px+52,py,13,string.format("#%02X%02X%02X",r8,g8,b8),a(theme.text,1),12)
  tmid(px+52,py+13,13,string.format("A %d%%   R %d  G %d  B %d",math.floor(p.al*100),r8,g8,b8),a(theme.faint,1),10)
  -- quick picks
  local pry=py+34
  for i,pc in ipairs(PRESETS) do
