-- optional show() predicate on a schema row. hidden rows drop out of the layout
-- entirely (no blank gap) and are never drawn or hit-tested, so a dependent
-- control like Picture Style only exists while Box Style is Picture.
local function row_visible(it) return it.show==nil or it.show() end

-- these two are called by the widget functions below, so they have to be
-- declared before them. draw_menu is pcall'd, so a nil call here used to fail
-- silently and take out the rest of the frame.
-- soft outer glow: a few fading shells behind an element
local function glow(x,y,w,h,c,spread)
  for i=(spread or 3),1,-1 do draw.RectFilled(x-i*1.5,y-i*1.5,w+i*3,h+i*3, a(c,0.05), 2) end
end
-- thick line segment as a convex quad (PolyFilled needs convex winding)
local function seg_quad(x1,y1,x2,y2,t)
  local dx,dy=x2-x1,y2-y1
  local len=math.sqrt(dx*dx+dy*dy)
  if len<0.001 then return nil end
  local nx,ny=-dy/len*t*0.5, dx/len*t*0.5
  return {{x1+nx,y1+ny},{x2+nx,y2+ny},{x2-nx,y2-ny},{x1-nx,y1-ny}}
end
-- stroke that thins and dims along its length, so a bracket fades outward
-- from its vertex instead of ending in a flat cut
local function taper_seg(x1,y1,x2,y2,t,c,steps)
  if not draw.PolyFilled then
    draw.RectFilled(x1-t*0.5,y1-t*0.5,math.abs(x2-x1)+t,math.abs(y2-y1)+t,c,0); return
  end
  steps=steps or 8
  for i=0,steps-1 do
    local u0,u1=i/steps,(i+1)/steps
    local q=seg_quad(x1+(x2-x1)*u0, y1+(y2-y1)*u0,
                     x1+(x2-x1)*u1, y1+(y2-y1)*u1, t*(1-u0*0.6))
    if q then pcall(draw.PolyFilled, q, {c[1],c[2],c[3],(c[4] or 1)*(1-u0*0.72)}) end
  end
end
-- HUD-style corner brackets: each arm tapers and fades outward from a lit
-- vertex block, so the frame reads as lit from the top. bottom corners take a
-- dimmer tone by default.
local function corners(x,y,w,h,len,c,th,cb)
  th=th or 2; len=len or 11; cb=cb or c
  local vs=th*1.8
  local function arm(vx,vy,tx,ty,tone)
    taper_seg(vx,vy,tx,ty,th*1.7,tone)
    draw.RectFilled(vx-th*0.6, vy-th*0.6, vs, vs, tone, 1)
  end
  arm(x+2, y+th*0.5, x+len, y+th*0.5, c)
  arm(x+th*0.5, y+2, x+th*0.5, y+len, c)
  arm(x+w-2, y+th*0.5, x+w-len, y+th*0.5, c)
  arm(x+w-th*0.5, y+2, x+w-th*0.5, y+len, c)
  arm(x+2, y+h-th*0.5, x+len, y+h-th*0.5, cb)
  arm(x+th*0.5, y+h-2, x+th*0.5, y+h-len, cb)
  arm(x+w-2, y+h-th*0.5, x+w-len, y+h-th*0.5, cb)
  arm(x+w-th*0.5, y+h-2, x+w-th*0.5, y+h-len, cb)
end
-- vertical gradient
local function grad_v(x,y,w,h,c1,c2,steps) steps=steps or 12; local sh=h/steps
  for i=0,steps-1 do draw.RectFilled(x,y+i*sh,w,sh+1,mix(c1,c2,i/(steps-1)),0) end end

-- checkerboard behind a color chip. without it a semi transparent color
-- reads as a darker solid and the alpha slider looks like it does nothing.
local function swatch_checker(x,y,w,h,c1,c2,s)
  s=s or 4
  local nx=math.floor(w/s); local ny=math.floor(h/s)
  for i=0,nx-1 do for j=0,ny-1 do
    draw.RectFilled(x+i*s,y+j*s,s,s,((i+j)%2==0) and c1 or c2,0)
  end end
end
local PICKER_W,PICKER_H=250,230

local function w_toggle(it,x,y,w)
  local top=26; local v=cfg[it.id]
  local bs=16; local bx,by=x+w-bs,y+(top-bs)*0.5
  -- optional inline swatch: the World tab attaches one to every category row so
  -- its colour is reachable without a second column of pickers. it sits just
  -- left of the switch and opens the same picker a t="color" row would.
  if it.color then
    local cw,ch=22,12; local cx,cy=bx-6-cw,y+(top-ch)*0.5
    local c=col[it.color] or {1,1,1,1}
    local over=inside(cx-3,y,cw+6,top) and ui.appear>0.9
    swatch_checker(cx,cy,cw,ch,{0.13,0.15,0.20,1},{0.08,0.09,0.13,1},3)
    local al=(c[4] or 1)*(theme.opacity or 1)
    grad_v(cx,cy,cw,ch,
      {c[1]+(1-c[1])*0.26,c[2]+(1-c[2])*0.26,c[3]+(1-c[3])*0.26,al},
      {c[1]*0.70,c[2]*0.70,c[3]*0.70,al}, 8)
    draw.Rect(cx,cy,cw,ch, a(over and theme.accent or theme.line, over and 0.95 or 1), 3, 1)
    if over then glow(cx,cy,cw,ch, theme.accent, 2) end
    if over and ui.m.click then
      local h,s,vv=to_hsv(c); local scw,sch=scr()
      ui.picker={color=it.color,h=h,s=s,v=vv,al=c[4] or 1,
        x=clamp(cx-150,8,scw-PICKER_W-8), y=clamp(cy+ch+10,8,sch-PICKER_H-8)}
      ui.m.click=false
    end
  end
  -- the row test runs after the chip: clicking the swatch must open the picker,
  -- not flip the setting underneath it.
  if inside(x,y,w,top) and ui.m.click and interactable() then cfg[it.id]=not v; cfg_dirty=true; ui.m.click=false end
  local hot=inside(x,y,w,top)
  -- long labels (the grouped gun-mod row) step down a point at a time instead
  -- of running under the switch, same rule the slider rows already use.
  local lsz=13
  while lsz>8 and ts(it.label,lsz)+24>w do lsz=lsz-1 end
  tmid(x,y,top,it.label, a(theme.text, v and 1 or 0.8),lsz)
  local rv=approach("tg"..it.id, v and 1 or 0, 18)
  if hot and v==false then draw.RectFilled(x,y,w,top, {1,1,1,0.02},0) end
  if v then glow(bx,by,bs,bs, theme.accent, 2) end
  draw.RectFilled(bx,by,bs,bs, a(mix(theme.field,theme.accent,rv*0.9),1), 2)
  draw.Rect(bx,by,bs,bs, a(mix(theme.line,theme.accent,rv),1), 2, 1)
  if rv>0.02 then
    local pad=3; local s=(bs-pad*2)*rv; local ox,oy=bx+pad,by+pad
    local ck={ seg_quad(ox,oy+s*0.50, ox+s*0.40, oy+s*0.88, s*0.24),
               seg_quad(ox+s*0.40, oy+s*0.88, ox+s, oy+s*0.14, s*0.24) }
    local cc=a(theme.base, rv)
    for _,q in ipairs(ck) do
      if q then
        if draw.PolyFilled then pcall(draw.PolyFilled, q, cc)
        else draw.RectFilled(ox,oy+s*0.5,s*0.4,s*0.38, cc, 0) end
      end
    end
  end
  return top
end
local function w_slider(it,x,y,w)
  local top=34; local v=cfg[it.id]
  -- A range row is stored in real metres, but the distances drawn on screen are
  -- the game's own figures (studs), so a metre row prints the game value or the
  -- menu would disagree with the labels it controls.
  local dv=(it.suf=="m") and v/M_PER_STUD or v
  local disp=string.format("%.0f",dv)..(it.suf and (" "..it.suf) or ""); local dw=ts(disp,12)
  -- long labels (Body Bags & Dropped Items Range) step down a point at a time
  -- instead of running under the value readout
  local lsz=13
  while lsz>9 and ts(it.label,lsz)+dw+10>w do lsz=lsz-1 end
  tmid(x,y,16,it.label, a(theme.sub,1),lsz)
  draw.Text(x+w-dw,y+2,disp, a(theme.text,1),12)
  local ty2,th=y+21,4
  draw.RectFilled(x,ty2,w,th, a(theme.rail,1), 1)
  for i=0,4 do draw.RectFilled(x+w*(i/4), ty2+th+2, 1, 3, a(theme.line,0.65), 0) end
  local f=clamp((v-it.min)/(it.max-it.min),0,1); local fill=approach("sl"..it.id,f,18)
  if w*fill>1 then grad_v(x,ty2,w*fill,th, theme.accent, theme.accent2, 8) end
  local ks=10; local kx=x+w*fill-ks*0.5; local ky=ty2+th*0.5-ks*0.5
  glow(kx,ky,ks,ks, mix(theme.accent,theme.accent2,0.5), 2)
  local mid=mix(theme.accent,theme.accent2,0.5)
  if draw.PolyFilled then pcall(draw.PolyFilled, {{kx+ks*0.5,ky},{kx+ks,ky+ks*0.5},{kx+ks*0.5,ky+ks},{kx,ky+ks*0.5}}, a(theme.text,1))
  else draw.RectFilled(kx,ky,ks,ks, a(theme.text,1), 2) end
  if inside(x,y,w,top) and ui.m.click and not ui.drag and interactable() then ui.drag={k="slider",id=it.id,x=x,w=w,min=it.min,max=it.max} end
  if ui.drag and ui.drag.k=="slider" and ui.drag.id==it.id then
    if ui.m.down then local nv=math.floor(it.min+clamp((ui.m.x-x)/w,0,1)*(it.max-it.min)+0.5); if nv~=cfg[it.id] then cfg[it.id]=nv; cfg_dirty=true end else ui.drag=nil end
  end
  return top
end
